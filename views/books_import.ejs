  <script>
    document.addEventListener('DOMContentLoaded', function () {

      // --- 0. QUICK FILTERS & TABLE SORTING ---
      
      // Quick filter buttons
      const btnQuickToday = document.getElementById('btn-quick-today');
      const btnQuickWeek = document.getElementById('btn-quick-week');
      const btnQuickMonth = document.getElementById('btn-quick-month');
      const fFrom = document.getElementById('f-from');
      const fTo = document.getElementById('f-to');
      const searchForm = document.getElementById('search-form');

      function formatDateForInput(date) {
        return date.toISOString().split('T')[0];
      }

      if (btnQuickToday) {
        btnQuickToday.addEventListener('click', () => {
          const today = new Date();
          fFrom.value = formatDateForInput(today);
          fTo.value = formatDateForInput(today);
          searchForm.submit();
        });
      }

      if (btnQuickWeek) {
        btnQuickWeek.addEventListener('click', () => {
          const today = new Date();
          const firstDay = new Date(today);
          firstDay.setDate(today.getDate() - today.getDay() + 1); // Monday
          fFrom.value = formatDateForInput(firstDay);
          fTo.value = formatDateForInput(today);
          searchForm.submit();
        });
      }

      if (btnQuickMonth) {
        btnQuickMonth.addEventListener('click', () => {
          const today = new Date();
          const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
          fFrom.value = formatDateForInput(firstDay);
          fTo.value = formatDateForInput(today);
          searchForm.submit();
        });
      }

      // Table sorting
      const sortableHeaders = document.querySelectorAll('#master-table .sortable');
      let currentSort = { column: null, direction: 'asc' };

      sortableHeaders.forEach(header => {
        header.addEventListener('click', () => {
          const sortKey = header.dataset.sort;
          const tbody = document.querySelector('#master-table tbody');
          const rows = Array.from(tbody.querySelectorAll('tr'));

          // Toggle direction
          if (currentSort.column === sortKey) {
            currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
          } else {
            currentSort.column = sortKey;
            currentSort.direction = 'asc';
          }

          // Update header icons
          sortableHeaders.forEach(h => {
            h.classList.remove('asc', 'desc');
            const icon = h.querySelector('i');
            if (icon) {
              icon.className = 'fas fa-sort';
            }
          });
          header.classList.add(currentSort.direction);
          const icon = header.querySelector('i');
          if (icon) {
            icon.className = currentSort.direction === 'asc' ? 'fas fa-sort-up' : 'fas fa-sort-down';
          }

          // Sort rows
          rows.sort((a, b) => {
            let aVal, bVal;
            
            switch (sortKey) {
              case 'maPhieu':
                aVal = a.cells[1]?.textContent.trim() || '';
                bVal = b.cells[1]?.textContent.trim() || '';
                break;
              case 'ngayNhap':
                aVal = parseVietnameseDate(a.cells[2]?.textContent.trim() || '');
                bVal = parseVietnameseDate(b.cells[2]?.textContent.trim() || '');
                return currentSort.direction === 'asc' ? aVal - bVal : bVal - aVal;
              case 'nguoiLap':
                aVal = a.cells[3]?.textContent.trim() || '';
                bVal = b.cells[3]?.textContent.trim() || '';
                break;
              case 'soLuong':
                aVal = parseNumber(a.cells[4]?.textContent.trim() || '0');
                bVal = parseNumber(b.cells[4]?.textContent.trim() || '0');
                return currentSort.direction === 'asc' ? aVal - bVal : bVal - aVal;
              case 'tongTien':
                aVal = parseNumber(a.cells[5]?.textContent.trim() || '0');
                bVal = parseNumber(b.cells[5]?.textContent.trim() || '0');
                return currentSort.direction === 'asc' ? aVal - bVal : bVal - aVal;
              default:
                return 0;
            }
            
            return currentSort.direction === 'asc' 
              ? aVal.localeCompare(bVal, 'vi') 
              : bVal.localeCompare(aVal, 'vi');
          });

          // Re-append rows
          rows.forEach((row, idx) => {
            tbody.appendChild(row);
            if (row.cells.length > 1) {
              row.cells[0].textContent = idx + 1;
            }
          });
        });
      });

      function parseVietnameseDate(dateStr) {
        // Format: DD/MM/YYYY
        const parts = dateStr.split('/');
        if (parts.length === 3) {
          return new Date(parts[2], parts[1] - 1, parts[0]).getTime();
        }
        return 0;
      }

      // --- 1. BIẾN TOÀN CỤC & TIỆN ÍCH ---
      const loader = document.getElementById('loader');
      const toastContainer = document.getElementById('toast-container');

      // Tham số quy định từ database
      const soLuongNhapToiThieu = <%= soLuongNhapToiThieu %>;
      const tiLeTinhDonGiaBan = <%= tiLeTinhDonGiaBan %>;

      // Biến dùng cho việc sửa dòng
      let currentRowToEdit = null;
      let currentTableId = null;
      let originalLineItemData = {}; // Lưu giá trị gốc để reset modal dòng

      // Biến snapshot
      let originalEditState = null;

      function showLoader() { loader.style.display = 'flex'; }
      function hideLoader() { loader.style.display = 'none'; }
      function showToast(message, type = 'success') {
        const toast = document.createElement('div');
        toast.classList.add('toast', type);
        toast.innerHTML = `<i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} toast-icon"></i><span class="toast-message">${message}</span>`;
        toastContainer.appendChild(toast);
        setTimeout(() => { toast.classList.add('show'); }, 100);
        setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 300); }, 3000);
      }
      // API Call Helper (Real API)
      async function apiCall(url, method = 'GET', body = null) {
        showLoader();
        try {
          const options = {
            method,
            headers: { 'Content-Type': 'application/json' }
          };
          if (body) options.body = JSON.stringify(body);

          const response = await fetch(url, options);

          // KIỂM TRA response.ok TRƯỚC KHI parse JSON
          if (!response.ok) {
            const errorText = await response.text();
            hideLoader();
            throw new Error(`Server error ${response.status}: ${errorText.substring(0, 100)}`);
          }

          const data = await response.json();
          hideLoader();
          return { success: true, data };
        } catch (error) {
          hideLoader();
          console.error('API Error:', error);
          return { success: false, error: error.message };
        }
      }

      function formatNumber(num) { return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, "."); }
      function parseNumber(str) { if (!str) return 0; return parseFloat(str.toString().replace(/\./g, '')) || 0; }


      // --- 2. HÀM XỬ LÝ BẢNG ---

      // Hàm cập nhật lại STT cho bảng master (danh sách phiếu nhập)
      function updateMasterTableSTT() {
        const tbody = document.querySelector('#master-table tbody');
        const rows = tbody.querySelectorAll('tr');
        rows.forEach((row, index) => {
          // Bỏ qua dòng thông báo "Chưa có phiếu nhập sách nào"
          if (row.cells.length > 1) {
            row.cells[0].textContent = index + 1;
          }
        });
      }

      // Hàm tính tổng tiền
      window.updateTotal = function (tableId, totalId) {
        const rows = document.querySelectorAll(`#${tableId} tbody tr`);
        let total = 0;
        rows.forEach(row => {
          const totalCell = row.querySelector('.total-cell');
          if (totalCell && totalCell.dataset.value) {
            total += parseFloat(totalCell.dataset.value);
          }
        });

        const totalEl = document.getElementById(totalId);
        if (totalEl) totalEl.textContent = total;
      }

      // Hàm MỞ Modal Sửa Dòng (Được gọi khi bấm bút chì)
      window.openItemEditModal = function (element, tableId) {
        const row = element.closest('tr');
        currentRowToEdit = row;
        currentTableId = tableId;

        // Lấy dữ liệu từ dòng
        const name = row.querySelector('.name-cell').textContent;
        const qty = row.querySelector('.qty-cell').textContent;
        const priceRaw = row.querySelector('.price-cell').dataset.raw;
        const sellPriceRaw = row.querySelector('.sell-price-cell').dataset.raw; // Lấy giá bán

        // Lưu giá trị gốc để reset
        originalLineItemData = { qty: qty, price: priceRaw, sellPrice: sellPriceRaw };

        // Điền vào Modal nhỏ
        document.getElementById('item-edit-name').value = name;
        document.getElementById('item-edit-qty').value = qty;
        document.getElementById('item-edit-price').value = priceRaw;
        document.getElementById('item-edit-sell-price').value = sellPriceRaw; // Điền giá bán

        // Hiện Modal nhỏ
        document.getElementById('line-item-modal').style.display = 'flex';
      };

      // Hàm XÓA Dòng
      window.deleteItemRow = function (element, tableId, totalId) {
        element.closest('tr').remove();

        const rows = document.querySelectorAll(`#${tableId} tbody tr`);
        rows.forEach((row, index) => {
          row.querySelector('.stt-cell').textContent = index + 1;
        });

        updateTotal(tableId, totalId);
      };

      // Hàm THÊM DÒNG vào bảng
      window.addRowToDetailTable = function (tableId, totalId, data) {
        const tbody = document.querySelector(`#${tableId} tbody`);
        const row = tbody.insertRow();
        const donGia = Math.round(data.donGia);
        const donGiaBan = Math.round(data.donGiaBan);
        const thanhTien = data.soLuong * donGia;

        row.innerHTML = `
                      <td class="stt-cell text-center">${tbody.rows.length}</td>
                      <td>${data.maSach}</td>
                      <td class="name-cell">${data.tenSach}</td>
                      <td class="qty-cell text-center">${data.soLuong}</td>
                      <td class="price-cell text-right" data-raw="${donGia}">${donGia.toLocaleString('vi-VN')}</td>
                      <td class="sell-price-cell text-right" data-raw="${donGiaBan}">${donGiaBan.toLocaleString('vi-VN')}</td> <td class="total-cell text-right" data-value="${thanhTien}">${thanhTien.toLocaleString('vi-VN')}</td>
                      <td class="text-center">
                          <i class="fas fa-pencil-alt action-icon edit-row-icon"
                             onclick="openItemEditModal(this, '${tableId}')"
                             title="Sửa dòng này"></i>
                          <i class="fas fa-trash action-icon delete-row-icon"
                             onclick="deleteItemRow(this, '${tableId}', '${totalId}')"
                             style="color:var(--red-accent);" title="Xóa dòng này"></i>
                      </td>
                  `;
        updateTotal(tableId, totalId);
      }


      // --- 3. XỬ LÝ LOGIC TRONG MODAL NHỎ (Cập nhật dòng) ---
      const btnSaveLineItem = document.getElementById('btn-save-line-item');
      const btnResetLineItem = document.getElementById('btn-reset-line-item');
      const itemEditModal = document.getElementById('line-item-modal');

      if (btnSaveLineItem) {
        btnSaveLineItem.addEventListener('click', () => {
          if (!currentRowToEdit) return;

          const newQty = parseInt(document.getElementById('item-edit-qty').value);
          const newPrice = parseNumber(document.getElementById('item-edit-price').value);
          const newSellPrice = Math.round(newPrice * tiLeTinhDonGiaBan); // Tự động tính giá bán = giá nhập * tỉ lệ từ DB

          // QUY ĐỊNH: Số lượng nhập ít nhất là soLuongNhapToiThieu (từ database)
          if (!newQty || newQty < soLuongNhapToiThieu) { showToast(`Số lượng nhập phải từ ${soLuongNhapToiThieu} trở lên!`, 'error'); return; }
          if (!newPrice || newPrice < 0) { showToast('Đơn giá nhập không hợp lệ!', 'error'); return; }

          // Cập nhật lại dòng trong bảng
          currentRowToEdit.querySelector('.qty-cell').textContent = newQty;

          const priceCell = currentRowToEdit.querySelector('.price-cell');
          priceCell.textContent = newPrice.toLocaleString('vi-VN');
          priceCell.dataset.raw = newPrice;

          const sellPriceCell = currentRowToEdit.querySelector('.sell-price-cell');
          sellPriceCell.textContent = newSellPrice.toLocaleString('vi-VN');
          sellPriceCell.dataset.raw = newSellPrice;

          const newTotal = newQty * newPrice; // Thành tiền tính theo giá nhập
          const totalCell = currentRowToEdit.querySelector('.total-cell');
          totalCell.textContent = newTotal.toLocaleString('vi-VN');
          totalCell.dataset.value = newTotal;

          // Cập nhật tổng
          const prefix = currentTableId.split('-')[0];
          updateTotal(currentTableId, `${prefix}-total-amount`);

          // Đóng modal
          itemEditModal.style.display = 'none';
          currentRowToEdit = null;
          showToast('Đã cập nhật dòng sách!', 'success');
        });
      }

      // Nút Đặt lại (Reset)
      if (btnResetLineItem) {
        btnResetLineItem.addEventListener('click', () => {
          if (originalLineItemData) {
            document.getElementById('item-edit-qty').value = originalLineItemData.qty;
            document.getElementById('item-edit-price').value = originalLineItemData.price;
            document.getElementById('item-edit-sell-price').value = originalLineItemData.sellPrice;
          }
        });
      }

      // Đóng modal nhỏ
      document.querySelectorAll('.close-modal-item').forEach(btn => {
        btn.addEventListener('click', () => {
          itemEditModal.style.display = 'none';
          currentRowToEdit = null;
        });
      });

      // Format input giá VÀ tự động tính giá bán
      const itemEditPriceInput = document.getElementById('item-edit-price');
      const itemEditSellPriceInput = document.getElementById('item-edit-sell-price');

      if (itemEditPriceInput) {
        itemEditPriceInput.addEventListener('input', function () {
          const val = this.value.replace(/[^0-9]/g, '');
          this.value = val ? val : '';

          // Tự động tính đơn giá bán = đơn giá nhập * tỉ lệ từ DB
          if (val && itemEditSellPriceInput) {
            const giaNhap = parseFloat(val);
            const giaBan = Math.round(giaNhap * tiLeTinhDonGiaBan);
            itemEditSellPriceInput.value = giaBan;
          }
        });
      }


      // --- 4. AUTO-FILL SÁCH TỪ API ---
      async function findBookInfo(maSach) {
        try {
          console.log('[DEBUG] Fetching book info for:', maSach);
          const response = await fetch(`/api/books/getSach/${maSach}`);
          console.log('[DEBUG] Response status:', response.status);

          if (!response.ok) {
            const text = await response.text();
            console.error('[DEBUG] Response error:', text);
            return null;
          }

          const contentType = response.headers.get('content-type');
          console.log('[DEBUG] Content-Type:', contentType);

          if (!contentType || !contentType.includes('application/json')) {
            const text = await response.text();
            console.error('[DEBUG] Response is not JSON:', text.substring(0, 200));
            showToast('Lỗi server: Không nhận được JSON', 'error');
            return null;
          }

          const data = await response.json();
          console.log('[DEBUG] Book data:', data);
          return data.sach || null;
        } catch (error) {
          console.error('[ERROR] Fetching book:', error);
          showToast('Lỗi kết nối: ' + error.message, 'error');
          return null;
        }
      }

      ['add', 'edit'].forEach(prefix => {
        const maSachInput = document.getElementById(`${prefix}-input-ma-sach`);
        const tenSachInput = document.getElementById(`${prefix}-input-ten-sach`);
        const donGiaInput = document.getElementById(`${prefix}-input-don-gia`);
        const donGiaBanInput = document.getElementById(`${prefix}-input-don-gia-ban`);
        const maNhanVienInput = document.getElementById(`${prefix}-ma-nv`);

        if (maNhanVienInput) {
          maNhanVienInput.addEventListener('blur', async function () {
            const maNhanVien = this.value.trim();

            // Chỉ kiểm tra khi có giá trị
            if (maNhanVien) {
              try {
                // Gọi API để kiểm tra
                const response = await fetch(`/api/employees/check-employee/${maNhanVien}`);
                const data = await response.json();

                if (!data.exists) {
                  // Nếu không tồn tại, hiển thị toast lỗi
                  showToast(data.message || 'Mã nhân viên không tồn tại.', 'error');
                }
              } catch (error) {
                console.error('Lỗi khi kiểm tra mã nhân viên:', error);
                showToast('Không thể kết nối đến máy chủ để kiểm tra. Vui lòng thử lại.', 'error');
              }
            }
          });
        }
        if (maSachInput && tenSachInput) {
          // Tự động chuyển mã sách thành chữ in hoa khi nhập
          maSachInput.addEventListener('input', function () {
            this.value = this.value.toUpperCase();
          });

          maSachInput.addEventListener('blur', async function () {
            const maSach = this.value.trim().toUpperCase();
            this.value = maSach; // Cập nhật lại giá trị in hoa
            if (!maSach) return;

            const book = await findBookInfo(maSach);
            if (book) {
              tenSachInput.value = book.TenSach || book.name || '';
              // Nếu có giá nhập từ DB, fill vào và tự động tính giá bán
              if (donGiaInput && !donGiaInput.value && book.DonGia) {
                const giaNhap = book.DonGia;
                donGiaInput.value = giaNhap;
                // Tự động tính giá bán với tỉ lệ từ DB
                if (donGiaBanInput) {
                  donGiaBanInput.value = Math.round(giaNhap * tiLeTinhDonGiaBan);
                }
              }
            } else {
              showToast('Không tìm thấy sách với mã: ' + maSach, 'error');
            }
          });
        }

        // Format input khi nhập VÀ tự động tính giá bán
        if (donGiaInput) {
          donGiaInput.addEventListener('input', function () {
            const val = this.value.replace(/[^0-9]/g, '');
            this.value = val ? val : '';

            // Tự động tính đơn giá bán = đơn giá nhập * tỉ lệ từ DB
            if (val && donGiaBanInput) {
              const giaNhap = parseFloat(val);
              const giaBan = Math.round(giaNhap * tiLeTinhDonGiaBan);
              donGiaBanInput.value = giaBan;
            }
          });
        }
        // Không cần xử lý input cho giá bán nữa vì nó tự động

        // Nút "Thêm" vào bảng
        const btnId = `btn-add-to-list${prefix === 'edit' ? '-edit' : ''}`;
        const addToBtn = document.getElementById(btnId);

        if (addToBtn) {
          addToBtn.addEventListener('click', function () {
            const soLuongInput = document.getElementById(`${prefix}-input-so-luong`);

            if (!maSachInput.value || !tenSachInput.value) {
              showToast('Vui lòng nhập sách!', 'error');
              return;
            }

            const soLuong = parseInt(soLuongInput.value);
            // QUY ĐỊNH: Số lượng nhập ít nhất là soLuongNhapToiThieu (từ database)
            if (!soLuong || soLuong < soLuongNhapToiThieu) {
              showToast(`Số lượng nhập phải từ ${soLuongNhapToiThieu} trở lên (theo quy định)!`, 'error');
              return;
            }

            const donGia = parseInt(donGiaInput.value);
            if (!donGia || donGia < 0) {
              showToast('Đơn giá nhập không hợp lệ!', 'error');
              return;
            }

            addRowToDetailTable(`${prefix}-detail-table`, `${prefix}-total-amount`, {
              maSach: maSachInput.value,
              tenSach: tenSachInput.value,
              soLuong: parseInt(soLuongInput.value),
              donGia: Math.round(parseFloat(donGiaInput.value)),
              donGiaBan: Math.round(parseFloat(donGiaBanInput.value)) // Lấy giá bán đã làm tròn
            });

            // Reset
            maSachInput.value = '';
            tenSachInput.value = '';
            soLuongInput.value = '<%= soLuongNhapToiThieu %>';
            donGiaInput.value = '';
            donGiaBanInput.value = '';
            maSachInput.focus();
          });
        }
      });


      // --- 5. QUẢN LÝ MODAL CHÍNH ---
      const menuToggle = document.getElementById('menu-toggle');
      const sidebar = document.getElementById('sidebar');
      const container = document.querySelector('.dashboard-container');
      if (menuToggle) menuToggle.addEventListener('click', () => {
        if (window.innerWidth <= 992) sidebar.classList.toggle('active');
        else container.classList.toggle('sidebar-collapsed');
      });

      const addModal = document.getElementById('add-modal');
      const editModal = document.getElementById('edit-modal');

      // Mở Modal Thêm
      const openAddBtn = document.getElementById('open-add-modal');
      if (openAddBtn) {
        openAddBtn.addEventListener('click', () => {
          resetAddForm();
          addModal.style.display = 'flex';
        });
      }
      let isSaveAndReset = false;
      
      // Mở Modal Sửa - Sử dụng event delegation để xử lý cả nút được thêm động
      async function openEditModal(id) {
        // 1. Gọi API lấy chi tiết phiếu
        const result = await apiCall(`/api/import/${id}`);

        if (!result.success) {
          showToast('Không thể tải dữ liệu phiếu nhập!', 'error');
          return;
        }

        const receipt = result.data.receipt;

        // 2. Điền thông tin chung (Header)
        document.getElementById('edit-ma-phieu').value = receipt.MaPhieuNhap;
        document.getElementById('edit-ngay-nhap').value = receipt.NgayNhapPhieu ? receipt.NgayNhapPhieu.substring(0, 10) : '';
        document.getElementById('edit-ma-nv').value = receipt.MaNhanVien || '';

        // 3. Điền chi tiết sách (Table)
        const tbody = document.querySelector('#edit-detail-table tbody');
        tbody.innerHTML = ''; // Xóa dữ liệu cũ/dummy

        if (receipt.ChiTiet && receipt.ChiTiet.length > 0) {
          receipt.ChiTiet.forEach(item => {
            // Lấy tên sách từ quan hệ lồng nhau: CT_PNS -> Sach -> DauSach -> TenSach
            // Cần kiểm tra null an toàn (optional chaining)
            const tenSach = item.Sach?.DauSach?.TenSach || "Không xác định";

            addRowToDetailTable('edit-detail-table', 'edit-total-amount', {
              maSach: item.MaSach,
              tenSach: tenSach,
              soLuong: item.SoLuong,
              donGia: item.DonGiaNhap,
              donGiaBan: item.DonGiaBan
            });
          });
        }

        // 4. Lưu trạng thái ban đầu để dùng cho nút "Đặt lại"
        setTimeout(() => { originalEditState = getEditState(); }, 100);

        // 5. Hiển thị Modal
        editModal.style.display = 'flex';
      }
      
      // Event delegation cho nút Chi tiết (hoạt động với cả nút được thêm động)
      document.getElementById('master-table').addEventListener('click', async function(e) {
        const viewBtn = e.target.closest('.view-detail-btn');
        if (viewBtn) {
          const id = viewBtn.dataset.id;
          await openEditModal(id);
        }
      });

      // --- LOGIC NÚT "THÊM MỚI" (SMART RESET) - MODAL ADD ---
      const btnResetAdd = document.getElementById('btn-custom-reset');
      if (btnResetAdd) {
        btnResetAdd.addEventListener('click', () => {
          // Kiểm tra xem đã nhập gì chưa (chỉ kiểm tra bảng sách vì mã NV tự động lấy từ tài khoản)
          const hasData = document.querySelector('#add-detail-table tbody').rows.length > 0;

          if (hasData) {
            if (confirm('Bạn đang nhập dở phiếu nhập sách. Bạn có muốn LƯU phiếu này không?\n\n- OK: Lưu phiếu.\n- Cancel: Xóa trắng để nhập phiếu khác.')) {
              // Chọn OK -> Gọi submit form (Lưu)
              isSaveAndReset = true;
              document.getElementById('btn-save-add').click();
            } else {
              // Chọn Cancel -> Reset form, KHÔNG ĐÓNG MODAL
              resetAddForm();
              showToast('Đã làm mới form!', 'info');
            }
          } else {
            // Chưa nhập gì -> Reset
            resetAddForm();
            showToast('Form đã sẵn sàng nhập mới.', 'info');
          }
        });
      }

      function resetAddForm() {
        // Không reset mã nhân viên vì nó tự động lấy từ tài khoản hiện tại
        document.getElementById('add-ngay-nhap').valueAsDate = new Date();
        document.getElementById('add-input-ma-sach').value = '';
        document.getElementById('add-input-ten-sach').value = '';
        document.getElementById('add-input-so-luong').value = '<%= soLuongNhapToiThieu %>';
        document.getElementById('add-input-don-gia').value = '';
        document.getElementById('add-input-don-gia-ban').value = '';
        document.querySelector('#add-detail-table tbody').innerHTML = '';
        document.getElementById('add-total-amount').textContent = '0';
      }

      // --- LOGIC NÚT "ĐẶT LẠI" (SMART RESTORE) - MODAL EDIT ---
      const btnResetEdit = document.getElementById('btn-reset-edit');

      // Hàm lấy dữ liệu hiện tại để so sánh/lưu trữ
      function getEditState() {
        return {
          ngayNhap: document.getElementById('edit-ngay-nhap').value,
          maNV: document.getElementById('edit-ma-nv').value,
          tableHtml: document.querySelector('#edit-detail-table tbody').innerHTML
        };
      }

      if (btnResetEdit) {
        btnResetEdit.addEventListener('click', () => {
          if (!originalEditState) return;

          // 1. Kiểm tra thay đổi
          const currentState = getEditState();
          const isChanged = JSON.stringify(currentState) !== JSON.stringify(originalEditState);

          if (!isChanged) {
            showToast('Chưa có thay đổi nào để đặt lại!', 'info');
            return;
          }

          // 2. Hỏi xác nhận
          if (confirm("Khôi phục lại dữ liệu ban đầu?\n\n- OK: Khôi phục dữ liệu ban đầu.\n- Cancel: Tiếp tục chỉnh sửa với dữ liệu hiện tại.")) {
            //     // Chọn OK -> Lưu
            //     document.getElementById('btn-save-edit').click();
            // } else {
            // Chọn Cancel -> Khôi phục
            document.getElementById('edit-ngay-nhap').value = originalEditState.ngayNhap;
            document.getElementById('edit-ma-nv').value = originalEditState.maNV;
            document.querySelector('#edit-detail-table tbody').innerHTML = originalEditState.tableHtml;
            updateTotal('edit-detail-table', 'edit-total-amount');
            showToast('Đã khôi phục dữ liệu ban đầu!', 'info');
          }
        });
      }

      // Lưu Thêm Mới
      document.getElementById('btn-save-add').addEventListener('click', async () => {
        const ngayNhap = document.getElementById('add-ngay-nhap').value;
        const maNV = document.getElementById('add-ma-nv').value.trim();

        // Lấy chi tiết từ bảng
        const rows = document.querySelectorAll('#add-detail-table tbody tr');
        if (rows.length === 0) {
          showToast('Vui lòng thêm ít nhất một sách!', 'error');
          return;
        }

        const chiTiet = Array.from(rows).map(row => {
          // Lấy giá trị từ data-raw attribute thay vì textContent
          const priceCell = row.querySelector('.price-cell');
          const sellPriceCell = row.querySelector('.sell-price-cell');

          return {
            MaSach: row.cells[1].textContent.trim(), // cells[0]=STT, cells[1]=Mã Sách
            SoLuong: parseInt(row.cells[3].textContent), // cells[3]=Số Lượng
            DonGiaNhap: parseFloat(priceCell.dataset.raw || priceCell.textContent.replace(/[^0-9]/g, '')), // Lấy từ data-raw
            DonGiaBan: parseFloat(sellPriceCell.dataset.raw || sellPriceCell.textContent.replace(/[^0-9]/g, '')) // Lấy từ data-raw
          };
        });

        console.log('[DEBUG] Sending chiTiet:', chiTiet); // Debug log

        const result = await apiCall('/api/import/create', 'POST', {
          NgayNhapPhieu: ngayNhap,
          MaNhanVien: maNV || null,
          chiTiet
        });

        if (result.success) {

          showToast('Thêm phiếu nhập thành công!');
          if (isSaveAndReset) {
            // Trường hợp 1: Từ nút "Thêm mới" (Lưu -> Reset form -> Không đóng)
            resetAddForm();
            showToast('Đã sẵn sàng nhập phiếu nhập sách tiếp theo.', 'info');

            // Reset cờ về false sau khi xong việc
            isSaveAndReset = false;

          } else {
            addModal.style.display = 'none';
            resetAddForm();
          }

          // 1. Tính toán dữ liệu hiển thị
          const tbody = document.querySelector('#master-table tbody');

          // Xóa dòng "Chưa có phiếu nhập" nếu bảng đang trống
          const firstRow = tbody.rows[0];
          if (firstRow && firstRow.cells.length === 1) {
            firstRow.remove();
          }

          // Format ngày: YYYY-MM-DD -> DD/MM/YYYY
          let dateDisplay = ngayNhap;
          if (ngayNhap && ngayNhap.includes('-')) {
            const parts = ngayNhap.split('-');
            dateDisplay = `${parts[2]}/${parts[1]}/${parts[0]}`;
          }

          // Tính tổng tiền từ mảng chiTiet vừa gửi đi
          const tongTien = chiTiet.reduce((sum, item) => sum + (item.SoLuong * item.DonGiaNhap), 0);
          const tongSoLuong = chiTiet.reduce((sum, item) => sum + item.SoLuong, 0);

          // Lấy Mã Phiếu từ phản hồi API 
          // API trả về: { maPhieu: 'PN...', tongTien: ... }
          const newId = result.data.maPhieu || result.data.MaPhieuNhap || '---';

          // 2. Tạo dòng HTML mới
          const maNVDisplay = document.getElementById('add-ma-nv').value || '---';
          const newRow = document.createElement('tr');
          newRow.innerHTML = `
                          <td>1</td>
                          <td>${newId}</td>
                          <td>${dateDisplay}</td>
                          <td>${maNVDisplay}</td>
                          <td style="text-align: center">${new Intl.NumberFormat('vi-VN').format(tongSoLuong)}</td>
                          <td style="text-align: right">${new Intl.NumberFormat('vi-VN').format(tongTien)}</td>
                          <td>
                              <button class="btn btn-sm btn-secondary view-detail-btn" data-id="${newId}">
                                  <i class="fas fa-eye"></i> Chi tiết
                              </button>
                              <button class="btn btn-sm btn-print ml-2 print-btn" data-id="${newId}">
                                  <i class="fas fa-print"></i>
                              </button>
                              <i class="fas fa-trash action-icon delete-icon" style="margin-left: 12px; color: var(--red-accent);"></i>
                          </td>
                      `;

          // 3. Thêm vào ĐẦU bảng (vì danh sách sắp xếp theo ngày mới nhất)
          if (tbody.firstChild) {
            tbody.insertBefore(newRow, tbody.firstChild);
          } else {
            tbody.appendChild(newRow);
          }
          
          // 4. Cập nhật lại STT cho tất cả các dòng (đánh số lại từ 1)
          updateMasterTableSTT();
        } else {
          showToast(result.error || 'Có lỗi xảy ra!', 'error');
        }
      });

      // Lưu Cập Nhật
      document.getElementById('btn-save-edit').addEventListener('click', async () => {
        const maPhieu = document.getElementById('edit-ma-phieu').value;
        const ngayNhap = document.getElementById('edit-ngay-nhap').value;
        const maNV = document.getElementById('edit-ma-nv').value.trim();

        const rows = document.querySelectorAll('#edit-detail-table tbody tr');
        if (rows.length === 0) {
          showToast('Vui lòng thêm ít nhất một sách!', 'error');
          return;
        }

        const chiTiet = Array.from(rows).map(row => {
          // Lấy giá trị từ data-raw attribute thay vì textContent
          const priceCell = row.querySelector('.price-cell');
          const sellPriceCell = row.querySelector('.sell-price-cell');

          return {
            MaSach: row.cells[1].textContent.trim(), // cells[0]=STT, cells[1]=Mã Sách
            SoLuong: parseInt(row.cells[3].textContent), // cells[3]=Số Lượng
            DonGiaNhap: parseFloat(priceCell.dataset.raw || priceCell.textContent.replace(/[^0-9]/g, '')), // Lấy từ data-raw
            DonGiaBan: parseFloat(sellPriceCell.dataset.raw || sellPriceCell.textContent.replace(/[^0-9]/g, '')) // Lấy từ data-raw
          };
        });

        console.log('[DEBUG] Sending chiTiet:', chiTiet); // Debug log

        const result = await apiCall(`/api/import/update/${maPhieu}`, 'PATCH', {
          NgayNhapPhieu: ngayNhap,
          MaNhanVien: maNV || null,
          chiTiet
        });

        if (result.success) {
          editModal.style.display = 'none';
          showToast('Cập nhật phiếu nhập thành công!');
          setTimeout(() => location.reload(), 1000);
        } else {
          showToast(result.error || 'Có lỗi xảy ra!', 'error');
        }
      });

      document.querySelectorAll('.close-modal').forEach(btn => {
        btn.addEventListener('click', () => {
          addModal.style.display = 'none';
          editModal.style.display = 'none';
        });
      });

      // --- XỬ LÝ IN PHIẾU NHẬP ---

      // Bắt sự kiện click cho tất cả nút in
      document.addEventListener('click', function (e) {
        // Kiểm tra nếu click vào nút in hoặc icon bên trong nút in
        const btn = e.target.closest('.print-btn');
        if (btn) {
          const id = btn.dataset.id;
          printReceipt(id);
        }
      });

      async function printReceipt(maPhieu) {
        // 1. Lấy dữ liệu phiếu từ Server
        const result = await apiCall(`/api/import/${maPhieu}`);

        if (!result.success) {
          showToast('Không thể lấy dữ liệu để in!', 'error');
          return;
        }

        const data = result.data.receipt;
        const date = new Date(data.NgayNhapPhieu);
        const dateStr = `Ngày ${date.getDate()} tháng ${date.getMonth() + 1} năm ${date.getFullYear()}`;

        // 2. Tạo nội dung HTML cho hóa đơn (Template in)
        // Bạn có thể sửa CSS trong thẻ <style> dưới đây để đẹp hơn
        let itemsHtml = '';
        let stt = 1;

        if (data.ChiTiet) {
          data.ChiTiet.forEach(item => {
            const tenSach = item.Sach?.DauSach?.TenSach || "Sách đã xóa";
            itemsHtml += `
                              <tr>
                                  <td style="text-align: center;">${stt++}</td>
                                  <td>${tenSach}</td>
                                  <td style="text-align: center;">${item.SoLuong}</td>
                                  <td style="text-align: right;">${item.DonGiaNhap}</td>
                                  <td style="text-align: right;">${item.ThanhTien}</td>
                              </tr>
                          `;
          });
        }

        const printContent = `
                  <html>
                  <head>
                      <title>In Phiếu Nhập - ${maPhieu}</title>
                      <style>
                          body { font-family: 'Times New Roman', Times, serif; font-size: 14px; margin: 20px; }
                          .header { text-align: center; margin-bottom: 20px; }
                          .store-name { font-size: 18px; font-weight: bold; text-transform: uppercase; }
                          .title { font-size: 22px; font-weight: bold; margin-top: 10px; }
                          .info { margin-bottom: 20px; }
                          .info p { margin: 5px 0; }
                          table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
                          th, td { border: 1px solid #333; padding: 8px; }
                          th { background-color: #f0f0f0; }
                          .total-section { text-align: right; font-weight: bold; font-size: 16px; margin-bottom: 30px; }
                          .signature-section { display: flex; justify-content: space-between; text-align: center; margin-top: 50px; }
                          .signature-box { width: 30%; }
                      </style>
                  </head>
                  <body>
                      <div class="header">
                          <div class="store-name">NHÀ SÁCH ABC</div>
                          <div>Địa chỉ: 123 Đường Hàn Thuyên, P. Thủ Đức, TP.HCM - SĐT: 0909.123.456</div>
                          <div class="title">PHIẾU NHẬP SÁCH</div>
                          <div>(${dateStr})</div>
                      </div>

                      <div class="info">
                          <p><strong>Mã phiếu:</strong> ${data.MaPhieuNhap}</p>
                          <p><strong>Nhân viên nhập:</strong> ${data.NhanVien ? `${data.NhanVien.HoTen} (${data.MaNhanVien})` : (data.MaNhanVien || '---')}</p>
                      </div>

                      <table>
                          <thead>
                              <tr>
                                  <th style="width: 50px;">STT</th>
                                  <th>Tên Sách</th>
                                  <th style="width: 80px;">SL</th>
                                  <th style="width: 120px;">Đơn Giá</th>
                                  <th style="width: 150px;">Thành Tiền</th>
                              </tr>
                          </thead>
                          <tbody>
                              ${itemsHtml}
                          </tbody>
                      </table>

                      <div class="total-section">
                          Tổng cộng: ${data.TongTien} VNĐ
                      </div>

                      <div class="signature-section">
                          <div class="signature-box">
                              <strong>Người lập phiếu</strong><br>
                              (Ký, họ tên)<br><br><br><br>
                          </div>
                          <div class="signature-box">
                              <strong>Thủ kho</strong><br>
                              (Ký, họ tên)<br><br><br><br>
                          </div>
                      </div>
                  </body>
                  </html>
                  `;

        // 3. Mở cửa sổ in
        const printWindow = window.open('', '', 'height=600,width=800');
        printWindow.document.write(printContent);
        printWindow.document.close(); // Quan trọng: Đóng luồng ghi để trình duyệt render

        // Đợi một chút để load nội dung rồi mới gọi lệnh in
        setTimeout(() => {
          printWindow.focus();
          printWindow.print();
          // printWindow.close(); // Có thể bỏ comment nếu muốn tự đóng sau khi in
        }, 500);
      }

      // Xóa phiếu ngoài bảng
      const masterTable = document.getElementById('master-table');
      if (masterTable) {
        masterTable.addEventListener('click', async function (e) {
          if (e.target.classList.contains('delete-icon') || e.target.closest('.delete-icon')) {
            const row = e.target.closest('tr');
            const maPhieu = row.cells[1].textContent.trim(); // Mã phiếu vẫn ở cột index 1

            if (confirm(`Xóa phiếu nhập ${maPhieu}?`)) {
              const result = await apiCall(`/api/import/delete/${maPhieu}`, 'DELETE');
              if (result.success) {
                row.remove();
                showToast('Xóa phiếu nhập thành công!');
                
                // Cập nhật lại STT sau khi xóa
                updateMasterTableSTT();
                
                const tableBody = document.getElementById('master-table').getElementsByTagName('tbody')[0];
                if (tableBody.rows.length === 0) {
                  // Nếu <tbody> không còn hàng nào
                  const newRow = tableBody.insertRow(); // Thêm 1 hàng mới
                  // Thêm ô "Không có phiếu nhập sách nào"
                  newRow.innerHTML = `<td colspan="7" style="text-align: center; padding: 2rem; color: var(--text-light);"><i class="fas fa-inbox" style="font-size: 2rem; margin-bottom: 0.5rem; display: block;"></i>Không tìm thấy phiếu nhập sách nào phù hợp</td>`;
                }
              } else {
                showToast(result.error || 'Có lỗi xảy ra!', 'error');
              }
            }
          }
        });
      }

      // --- LOGOUT ---
      const logoutBtn = document.getElementById('logout-button');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async (e) => {
          e.preventDefault();
          if (confirm('Bạn có chắc chắn muốn đăng xuất?')) {
            window.location.href = '/logout';
          }
        });
      }

    });
  </script>
</body>

</html>