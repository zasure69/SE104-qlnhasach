            <span><i class="fas fa-filter"></i> BỘ LỌC TÌM KIẾM</span>
            <div style="display: flex; gap: 0.5rem;">
              <button type="button" class="btn btn-sm btn-secondary" id="btn-quick-today" title="Hôm nay">
                <i class="fas fa-calendar-day"></i> Hôm nay
              </button>
              <button type="button" class="btn btn-sm btn-secondary" id="btn-quick-week" title="Tuần này">
                <i class="fas fa-calendar-week"></i> Tuần này
              </button>
              <button type="button" class="btn btn-sm btn-secondary" id="btn-quick-month" title="Tháng này">
                <i class="fas fa-calendar-alt"></i> Tháng này
              </button>
