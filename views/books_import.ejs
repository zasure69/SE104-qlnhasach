                <input type="text" id="item-edit-name" disabled style="background-color: #e9ecef; font-weight: bold;">
            </div>
            <div class="form-group" style="margin-top: 1rem;">
                <label class="required">Số Lượng:</label>
                <input type="number" id="item-edit-qty" min="1" style="font-weight: bold; color: var(--secondary-color);">
            </div>
            <div class="form-group" style="margin-top: 1rem;">
                <label class="required">Đơn Giá:</label>
                <input type="text" id="item-edit-price" inputmode="numeric" oninput="this.value = this.value.replace(/[^0-9]/g, '')" style="font-weight: bold;">
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-warning" id="btn-reset-line-item" style="flex: 1; margin-right: 1rem;">Đặt lại</button>
            <button type="button" class="btn btn-primary" id="btn-save-line-item">Cập nhật</button>
