              <!-- Hàng 1 -->
              <div class="field">
                <label for="f-ma-phieu">Mã phiếu</label>
                <input id="f-ma-phieu" name="maPhieu" type="text" placeholder="VD: PNS001"
                  value="<%= (filters && filters.maPhieu) ? filters.maPhieu : '' %>" />
              </div>

              <div class="field">
                <label for="f-nguoi-lap">Người lập</label>
                <input id="f-nguoi-lap" name="nguoiLap" type="text" placeholder="Tên/Username..."
                  value="<%= (filters && filters.nguoiLap) ? filters.nguoiLap : '' %>" />
              </div>

              <div class="field">
                <label for="f-ma-sach">Mã/Tên sách</label>
                <input id="f-ma-sach" name="maSach" type="text" placeholder="Mã hoặc tên sách..."
                  value="<%= (filters && filters.maSach) ? filters.maSach : '' %>" />
              </div>

              <div class="field">
                <label>Ngày nhập từ</label>
                <input name="from" type="date" id="f-from" value="<%= (filters && filters.from) ? filters.from : '' %>" />
              </div>

              <!-- Hàng 2 -->
              <div class="field">
                <label>Đến ngày</label>
                <input name="to" type="date" id="f-to" value="<%= (filters && filters.to) ? filters.to : '' %>" />
              </div>

              <div class="field">
                <label>Số lượng từ</label>
                <input name="minSoLuong" type="number" min="0" placeholder="Tối thiểu"
                  value="<%= (filters && filters.minSoLuong) ? filters.minSoLuong : '' %>" />
              </div>

              <div class="field">
                <label>Đến (cuốn)</label>
                <input name="maxSoLuong" type="number" min="0" placeholder="Tối đa"
                  value="<%= (filters && filters.maxSoLuong) ? filters.maxSoLuong : '' %>" />
              </div>

              <div class="field">
                <label>Tổng tiền từ</label>
                <input name="minTien" type="number" min="0" placeholder="Tối thiểu (VNĐ)"
                  value="<%= (filters && filters.minTien) ? filters.minTien : '' %>" />
              </div>

              <!-- Hàng 3 -->
              <div class="field">
                <label>Đến (VNĐ)</label>
                <input name="maxTien" type="number" min="0" placeholder="Tối đa"
                  value="<%= (filters && filters.maxTien) ? filters.maxTien : '' %>" />
              </div>

              <!-- Nút bấm -->
              <div class="field" style="grid-column: span 3;">
                <div class="search-actions">
                  <a class="btn-secondary-outline" href="/dashboard/books_import">
                    <i class="fas fa-rotate-left"></i> LÀM MỚI
                  </a>
                  <button class="btn btn-primary" type="submit">
                    <i class="fas fa-search"></i> TÌM KIẾM
                  </button>
                </div>
              </div>
            </div>
          </form>
        </div>

        <div class="content-header">
          <h2>Danh sách Phiếu nhập sách</h2>
          <button class="btn btn-primary btn-add-new" id="open-add-modal">
            <i class="fas fa-plus"></i> LẬP PHIẾU NHẬP SÁCH
          </button>
        </div>

        <div class="table-responsive">
          <table class="data-table" id="master-table">
            <thead>
              <tr>
                <th>STT</th>
                <th class="sortable" data-sort="maPhieu">Mã Phiếu <i class="fas fa-sort"></i></th>
                <th class="sortable" data-sort="ngayNhap">Ngày Nhập <i class="fas fa-sort"></i></th>
                <th class="sortable" data-sort="nguoiLap">Người Lập <i class="fas fa-sort"></i></th>
                <th class="sortable" data-sort="soLuong" style="text-align: center">Tổng số lượng <i class="fas fa-sort"></i></th>
                <th class="sortable" data-sort="tongTien" style="text-align: right">Tổng tiền <i class="fas fa-sort"></i></th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% if (importReceipts && importReceipts.length> 0) { %> <% importReceipts.forEach((receipt, index)=> { %>
                  <tr>
                    <td>
                      <%= index + 1 %>
                    </td>
                    <td>
                      <%= receipt.MaPhieuNhap %>
                    </td>
                    <td>
                      <%= new Date(receipt.NgayNhapPhieu).toLocaleDateString('vi-VN', { day: '2-digit' ,
                        month: '2-digit' , year: 'numeric' }) %>
                    </td>
                    <td>
                      <%= receipt.MaNhanVien %><%= receipt.NhanVien ? ' - ' + receipt.NhanVien.HoTen : '' %>
                    </td>
                    <td style="text-align: center">
                      <%= new Intl.NumberFormat('vi-VN').format(receipt.TongSoLuong || 0) %>
                    </td>
                    <td style="text-align: right">
                      <%= new Intl.NumberFormat('vi-VN').format(receipt.TongTien) %>
                    </td>
                    <td>
                      <button class="btn btn-sm btn-secondary view-detail-btn" data-id="<%= receipt.MaPhieuNhap %>">
                        <i class="fas fa-eye"></i> Chi tiết
                      </button>
                      <button class="btn btn-sm btn-print ml-2 print-btn" data-id="<%= receipt.MaPhieuNhap %>">
                        <i class="fas fa-print"></i>
                      </button>
                      <i class="fas fa-trash action-icon delete-icon"
                        style="margin-left: 12px; color: var(--red-accent)"></i>
                    </td>
                  </tr>
                  <% }) %>
                    <% } else { %>
                      <tr>
                        <td colspan="7" style="text-align: center; padding: 2rem; color: var(--text-light);">
                          <i class="fas fa-inbox" style="font-size: 2rem; margin-bottom: 0.5rem; display: block;"></i>
                          Không tìm thấy phiếu nhập sách nào phù hợp
                        </td>
                      </tr>
                      <% } %>
            </tbody>
          </table>
        </div>
      </div>
