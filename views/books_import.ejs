    <div class="modal-overlay" id="line-item-modal" style="z-index: 1100;"> <div class="modal-content" style="max-width: 450px;">
        <div class="modal-header">
            <h2 style="font-size: 1.1rem;">Cập nhật dòng sách</h2>
