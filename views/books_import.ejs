    <script>
        document.addEventListener('DOMContentLoaded', function () {
            
            // --- 1. BIẾN TOÀN CỤC & TIỆN ÍCH ---
            const loader = document.getElementById('loader');
            const toastContainer = document.getElementById('toast-container');
            
            // Biến dùng cho việc sửa dòng
            let currentRowToEdit = null;
            let currentTableId = null;
            let originalLineItemData = {}; 
            
            // Biến snapshot
            let originalEditState = null;

            function showLoader() { loader.style.display = 'flex'; }
            function hideLoader() { loader.style.display = 'none'; }
            function showToast(message, type = 'success') {
                const toast = document.createElement('div');
                toast.classList.add('toast', type);
                toast.innerHTML = `<i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} toast-icon"></i><span class="toast-message">${message}</span>`;
                toastContainer.appendChild(toast);
                setTimeout(() => { toast.classList.add('show'); }, 100);
                setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 300); }, 3000);
            }
            function simulateApiCall(callback) { showLoader(); setTimeout(() => { hideLoader(); callback(true); }, 500); }
            function formatNumber(num) { return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, "."); }
            function parseNumber(str) { if (!str) return 0; return parseFloat(str.toString().replace(/\/dashboard/g, '')) || 0; }


            // --- 2. HÀM XỬ LÝ BẢNG (Đưa ra Global Window để gọi từ onclick) ---

            // Hàm tính tổng tiền
            window.updateTotal = function(tableId, totalId) {
                const rows = document.querySelectorAll(`#${tableId} .row-total`);
                let total = 0;
                if (rows) rows.forEach(r => total += parseFloat(r.dataset.value));
                
                const totalEl = document.getElementById(totalId);
                if (totalEl) totalEl.textContent = formatNumber(total);
            }

            // Hàm MỞ Modal Sửa Dòng
            window.openItemEditModal = function(element, tableId) {
                const row = element.closest('tr');
                currentRowToEdit = row;
                currentTableId = tableId; 

                // Lấy dữ liệu từ dòng
                const name = row.querySelector('.name-cell').textContent;
                const qty = row.querySelector('.qty-cell').textContent;
                const priceRaw = row.querySelector('.price-cell').dataset.raw;

                // Điền vào Modal
                document.getElementById('item-edit-name').value = name;
                document.getElementById('item-edit-qty').value = qty;
                document.getElementById('item-edit-price').value = formatNumber(priceRaw); 

                // --- MỚI: LƯU LẠI GIÁ TRỊ GỐC ĐỂ DÙNG CHO NÚT ĐẶT LẠI ---
                originalLineItemData = {
                    qty: qty,
                    price: formatNumber(priceRaw)
                };

                // Hiện Modal
                document.getElementById('line-item-modal').style.display = 'flex';
            };

            // Hàm XÓA Dòng (Được gọi khi bấm thùng rác)
            window.deleteItemRow = function(element, tableId, totalId) {
                element.closest('tr').remove();
                
                // Cập nhật lại STT
                const rows = document.querySelectorAll(`#${tableId} tbody tr`);
                rows.forEach((row, index) => {
                    row.querySelector('.stt-cell').textContent = index + 1;
                });
                
                updateTotal(tableId, totalId);
            };

            // Hàm THÊM DÒNG vào bảng
            window.addRowToDetailTable = function(tableId, totalId, data) {
                const tbody = document.querySelector(`#${tableId} tbody`);
                const row = tbody.insertRow();
                const thanhTien = data.soLuong * data.donGia;
                
                row.innerHTML = `
                    <td class="stt-cell text-center">${tbody.rows.length}</td>
                    <td>${data.maSach}</td>
                    <td class="name-cell">${data.tenSach}</td>
                    <td class="qty-cell text-center">${data.soLuong}</td>
                    <td class="price-cell text-right" data-raw="${data.donGia}">${formatNumber(data.donGia)}</td>
                    <td class="total-cell text-right" data-value="${thanhTien}">${formatNumber(thanhTien)}</td>
                    <td class="text-center">
                        <i class="fas fa-pencil-alt action-icon edit-row-icon" 
                           onclick="openItemEditModal(this, '${tableId}')"
                           title="Sửa dòng này"></i>
                        <i class="fas fa-trash action-icon delete-row-icon" 
                           onclick="deleteItemRow(this, '${tableId}', '${totalId}')"
                           style="color:var(--red-accent);" title="Xóa dòng này"></i>
                    </td>
                `;
                updateTotal(tableId, totalId);
            }


            // --- 3. XỬ LÝ LOGIC TRONG MODAL NHỎ (Cập nhật dòng) ---
            const btnSaveLineItem = document.getElementById('btn-save-line-item');
            const itemEditModal = document.getElementById('line-item-modal');

            if(btnSaveLineItem) {
                btnSaveLineItem.addEventListener('click', () => {
                    if (!currentRowToEdit) return;

                    const newQty = parseInt(document.getElementById('item-edit-qty').value);
                    const newPrice = parseNumber(document.getElementById('item-edit-price').value);

                    if (newQty <= 0) { alert("Số lượng phải lớn hơn 0"); return; }

                    // Cập nhật lại dòng trong bảng
                    currentRowToEdit.querySelector('.qty-cell').textContent = newQty;
                    const priceCell = currentRowToEdit.querySelector('.price-cell');
                    priceCell.textContent = formatNumber(newPrice);
                    priceCell.dataset.raw = newPrice;

                    const newTotal = newQty * newPrice;
                    const totalCell = currentRowToEdit.querySelector('.total-cell');
                    totalCell.textContent = formatNumber(newTotal);
                    totalCell.dataset.value = newTotal;

                    // Cập nhật tổng
                    const prefix = currentTableId.split('-')[0]; 
                    updateTotal(currentTableId, `${prefix}-total-amount`);

                    // Đóng modal
                    itemEditModal.style.display = 'none';
                    currentRowToEdit = null;
                    showToast('Đã cập nhật dòng sách!', 'success');
                });
            }

            // --- XỬ LÝ NÚT "ĐẶT LẠI" TRONG MODAL DÒNG ---
            const btnResetLineItem = document.getElementById('btn-reset-line-item');
            
            if (btnResetLineItem) {
                btnResetLineItem.addEventListener('click', () => {
                    if (originalLineItemData) {
                        // Khôi phục lại giá trị trên ô input
                        document.getElementById('item-edit-qty').value = originalLineItemData.qty;
                        document.getElementById('item-edit-price').value = originalLineItemData.price;
                        
                        // (Tùy chọn) Focus lại vào ô số lượng
                        document.getElementById('item-edit-qty').focus();
                    }
                });
            }

            // Đóng modal nhỏ
            document.querySelectorAll('.close-modal-item').forEach(btn => {
                btn.addEventListener('click', () => {
                    itemEditModal.style.display = 'none';
                    currentRowToEdit = null;
                });
            });
            
            // Format input giá modal nhỏ
            const itemEditPrice = document.getElementById('item-edit-price');
            if(itemEditPrice) {
                itemEditPrice.addEventListener('input', function() {
                    const val = this.value.replace(/[^0-9]/g, '');
                    this.value = val ? formatNumber(val) : '';
                });
            }


            // --- 4. DATA GIẢ LẬP & LOGIC FORM ---
            function findBookInfo(maSach) {
                const books = {
                    'S001': { name: 'Mắt biếc', price: 80000 }, 
                    'S002': { name: 'Harry Potter', price: 150000 }
                };
                return books[maSach.toUpperCase()] || null;
            }

            ['add', 'edit'].forEach(prefix => {
                const maSachInput = document.getElementById(`${prefix}-input-ma-sach`);
                const tenSachInput = document.getElementById(`${prefix}-input-ten-sach`);
                const donGiaInput = document.getElementById(`${prefix}-input-don-gia`);

                if(maSachInput && tenSachInput){
                    maSachInput.addEventListener('blur', function() {
                        const book = findBookInfo(this.value);
                        if (book) {
                            tenSachInput.value = book.name;
                            if(donGiaInput && !donGiaInput.value) donGiaInput.value = formatNumber(book.price);
                        }
                    });
                }
                
                if(donGiaInput) {
                    donGiaInput.addEventListener('input', function() {
                        const val = this.value.replace(/[^0-9]/g, '');
                        this.value = val ? formatNumber(val) : '';
                    });
                }

                // Nút "Thêm" vào bảng
                const btnId = `btn-add-to-list${prefix === 'edit' ? '-edit' : ''}`;
                const addToBtn = document.getElementById(btnId);
                
                if(addToBtn) {
                    addToBtn.addEventListener('click', function() {
                        const soLuongInput = document.getElementById(`${prefix}-input-so-luong`);
                        
                        if (!maSachInput.value || !tenSachInput.value) {
                            showToast('Vui lòng nhập sách!', 'error');
                            return;
                        }

                        addRowToDetailTable(`${prefix}-detail-table`, `${prefix}-total-amount`, {
                            maSach: maSachInput.value, 
                            tenSach: tenSachInput.value, 
                            soLuong: parseInt(soLuongInput.value), 
                            donGia: parseNumber(donGiaInput.value)
                        });

                        // Reset
                        maSachInput.value = '';
                        tenSachInput.value = '';
                        soLuongInput.value = '1';
                        donGiaInput.value = '';
                        maSachInput.focus();
                    });
                }
            });


            // --- 5. QUẢN LÝ MODAL CHÍNH ---
            const menuToggle = document.getElementById('menu-toggle');
            const sidebar = document.getElementById('sidebar');
            const container = document.querySelector('.dashboard-container');
            if (menuToggle) menuToggle.addEventListener('click', () => {
                if (window.innerWidth <= 992) sidebar.classList.toggle('active');
                else container.classList.toggle('sidebar-collapsed');
            });

            const addModal = document.getElementById('add-modal');
            const editModal = document.getElementById('edit-modal');

            // Mở Modal Thêm
            const openAddBtn = document.getElementById('open-add-modal');
            if(openAddBtn) {
                openAddBtn.addEventListener('click', () => {
                    resetAddForm();
                    addModal.style.display = 'flex';
                });
            }

            // Mở Modal Sửa
            const viewDetailBtns = document.querySelectorAll('.view-detail-btn');
            viewDetailBtns.forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.dataset.id;
                    document.getElementById('edit-ma-phieu').value = id;
                    document.getElementById('edit-ngay-nhap').value = '2024-11-10';
                    document.getElementById('edit-ma-nv').value = 'NV01';

                    const tbody = document.querySelector('#edit-detail-table tbody');
                    tbody.innerHTML = '';
                    
                    // Thêm dòng mẫu (Quan trọng: Gọi hàm để sinh HTML chuẩn có onclick)
                    addRowToDetailTable('edit-detail-table', 'edit-total-amount', {
                        maSach: 'S001', tenSach: 'Mắt biếc', soLuong: 50, donGia: 75000
                    });

                    setTimeout(() => { originalEditState = getEditState(); }, 100);
                    editModal.style.display = 'flex';
                });
            });

            // Logic Reset/Restore
            const btnResetAdd = document.getElementById('btn-custom-reset'); 
            if (btnResetAdd) {
                btnResetAdd.addEventListener('click', () => {
                    const hasData = document.getElementById('add-ma-nv').value.trim() !== '' || document.querySelector('#add-detail-table tbody').rows.length > 0;
                    if (hasData) {
                        if (confirm('Lưu phiếu này không? OK: Lưu - Cancel: Xóa trắng')) {
                            document.getElementById('btn-save-add').click();
                        } else {
                            resetAddForm();
                        }
                    } else {
                        resetAddForm();
                    }
                });
            }

            function resetAddForm() {
                document.getElementById('add-ma-nv').value = '';
                document.getElementById('add-ngay-nhap').valueAsDate = new Date();
                document.querySelector('#add-detail-table tbody').innerHTML = '';
                document.getElementById('add-total-amount').textContent = '0';
            }

            const btnResetEdit = document.getElementById('btn-reset-edit');
            function getEditState() {
                return {
                    ngayNhap: document.getElementById('edit-ngay-nhap').value,
                    maNV: document.getElementById('edit-ma-nv').value,
                    tableHtml: document.querySelector('#edit-detail-table tbody').innerHTML
                };
            }

            if(btnResetEdit) {
                btnResetEdit.addEventListener('click', () => {
                    if(!originalEditState) return;
                    if (confirm("Khôi phục về ban đầu?")) {
                        document.getElementById('edit-ngay-nhap').value = originalEditState.ngayNhap;
                        document.getElementById('edit-ma-nv').value = originalEditState.maNV;
                        document.querySelector('#edit-detail-table tbody').innerHTML = originalEditState.tableHtml;
                        updateTotal('edit-detail-table', 'edit-total-amount');
                        showToast('Đã khôi phục!');
                    }
                });
            }

            // Lưu & Đóng
            document.getElementById('btn-save-add').addEventListener('click', () => {
                simulateApiCall(() => { addModal.style.display = 'none'; showToast('Thêm thành công!'); });
            });
            document.getElementById('btn-save-edit').addEventListener('click', () => {
                simulateApiCall(() => { editModal.style.display = 'none'; showToast('Cập nhật thành công!'); });
            });

            document.querySelectorAll('.close-modal').forEach(btn => {
                btn.addEventListener('click', () => {
                    addModal.style.display = 'none';
                    editModal.style.display = 'none';
                });
            });
            
            // Xóa phiếu ngoài bảng
            const masterTable = document.getElementById('master-table');
            if (masterTable) {
                masterTable.addEventListener('click', function(e) {
                    if (e.target.classList.contains('delete-icon') || e.target.closest('.delete-icon')) {
                        if(confirm(`Xóa phiếu nhập này?`)) {
                            simulateApiCall(() => { e.target.closest('tr').remove(); showToast('Đã xóa!'); });
                        }
                    }
                });
            }

        });
    </script>

</body>
</html>