            } else {
              // Chọn Cancel -> Chỉ Reset form, KHÔNG ĐÓNG modal
              if (addTacGiaForm) addTacGiaForm.reset();
              showToast('Đã làm mới form!', 'info');
            }
          } else {
            // Nếu chưa nhập gì -> Chỉ Reset cho chắc chắn
            if (addTacGiaForm) addTacGiaForm.reset();
            showToast('Form đã sẵn sàng nhập mới.', 'info');
          }
        });
      }

      if (addTacGiaForm) {
        addTacGiaForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const formData = {
            HoTen: document.getElementById('add-ho-ten-tg').value.trim(),
            NamSinh: document.getElementById('add-nam-sinh-tg').value.trim()
          };

          console.log('[DEBUG] Calling POST /api/books/authors/create with:', formData);
          showLoader();
          try {
            const response = await fetch('/api/books/authors/create', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(formData)
            });
            const data = await response.json();
            hideLoader();

            if (response.ok) {
              showToast(data.message || 'Thêm tác giả thành công!', 'success');
              if (isSaveAndResetTG) {
                // Trường hợp 1: Từ nút "Thêm mới" (Lưu -> Reset form -> Không đóng)
                addTacGiaForm.reset();
                showToast('Đã sẵn sàng nhập tác giả tiếp theo.', 'info');

                // Reset cờ về false sau khi xong việc
                isSaveAndResetTG = false;

              } else {
                addTacGiaModal.style.display = 'none';
                addTacGiaForm.reset();
              }


              // Cập nhật UI trực tiếp - thêm row mới vào bảng
              const tbody = document.querySelector('#table-tac-gia tbody');
              const rowCount = tbody.querySelectorAll('tr').length;
              const newRow = document.createElement('tr');
              newRow.dataset.id = data.data.MaTacGia || '';
              newRow.innerHTML = `
                        <td>${rowCount + 1}</td>
                        <td>${data.data.MaTacGia || ''}</td>
                        <td>${formData.HoTen}</td>
                        <td>${formData.NamSinh || ''}</td>
                        <td>
                            <i class="fas fa-pencil-alt action-icon open-tacgia-edit-modal"></i>
                            <i class="fas fa-trash action-icon delete-icon delete-tacgia-icon" style="margin-left: 12px; color: var(--red-accent);"></i>
                        </td>
                    `;
              tbody.appendChild(newRow);

              // Cập nhật danh sách allAuthors để modal chọn tác giả có data mới
              allAuthors.push({ MaTacGia: data.tacGia?.MaTacGia, HoTen: formData.HoTen, NamSinh: formData.NamSinh });

              // Reset form
              addTacGiaForm.reset();
            } else {
              showToast(data.error || 'Có lỗi xảy ra!', 'error');
            }
          } catch (error) {
            hideLoader();
            console.error('[ERROR] createTacGia:', error);
            showToast('Lỗi kết nối server!', 'error');
          }
        });
      }

      // --- TÁC GIẢ: CHỈNH SỬA ---
      const editTacGiaModal = document.getElementById('tacgia-edit-modal');
      const editTacGiaForm = document.getElementById('edit-tacgia-form');
      let originalTacGiaData = null; // Lưu dữ liệu ban đầu

      document.getElementById('table-tac-gia').addEventListener('click', (e) => {
        if (e.target.classList.contains('open-tacgia-edit-modal') ||
          e.target.closest('.open-tacgia-edit-modal')) {
          const row = e.target.closest('tr');
          if (!row) return;

          const cells = row.cells;
          document.getElementById('edit-ma-tac-gia').value = cells[1].textContent.trim();
          document.getElementById('edit-ho-ten-tg').value = cells[2].textContent.trim();
          document.getElementById('edit-nam-sinh-tg').value = cells[3].textContent.trim();

          // Lưu dữ liệu ban đầu
          originalTacGiaData = {
            maTacGia: cells[1].textContent.trim(),
            hoTen: cells[2].textContent.trim(),
            namSinh: cells[3].textContent.trim()
          };

          editTacGiaModal.style.display = 'flex';
        }
      });

      // Xử lý nút "Đặt lại" cho modal edit tác giả
      const btnResetTacGia = document.getElementById('btn-reset-tacgia');
      if (btnResetTacGia) {
        btnResetTacGia.addEventListener('click', () => {
          if (originalTacGiaData) {
            // Kiểm tra xem dữ liệu có thay đổi không
            const currentHoTen = document.getElementById('edit-ho-ten-tg').value;
            const currentNamSinh = document.getElementById('edit-nam-sinh-tg').value;

            const hasChanges = currentHoTen !== originalTacGiaData.hoTen ||
              currentNamSinh !== originalTacGiaData.namSinh;

            if (hasChanges) {
              if (confirm('Khôi phục dữ liệu ban đầu?\n\nOK: Khôi phục dữ liệu ban đầu\nCancel: Tiếp tục chỉnh sửa với dữ liệu hiện tại.')) {
                //     // OK - Submit form để lưu
                //     editTacGiaForm.requestSubmit();
                // } else {
                // Cancel - Khôi phục dữ liệu ban đầu
                document.getElementById('edit-ma-tac-gia').value = originalTacGiaData.maTacGia;
                document.getElementById('edit-ho-ten-tg').value = originalTacGiaData.hoTen;
                document.getElementById('edit-nam-sinh-tg').value = originalTacGiaData.namSinh;
                showToast('Đã khôi phục dữ liệu ban đầu', 'info');
              }
            } else {
              showToast('Dữ liệu chưa thay đổi', 'info');
            }
          } else {
            showToast('Không thể đặt lại - chưa có dữ liệu gốc', 'error');
          }
        });
      }

      if (editTacGiaForm) {
        editTacGiaForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const maTacGia = document.getElementById('edit-ma-tac-gia').value;
          const formData = {
            HoTen: document.getElementById('edit-ho-ten-tg').value.trim(),
            NamSinh: document.getElementById('edit-nam-sinh-tg').value.trim()
          };

          console.log(`[DEBUG] Calling PATCH /api/books/authors/update/${maTacGia} with:`, formData);
          showLoader();
          try {
            const response = await fetch(`/api/books/authors/update/${maTacGia}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(formData)
            });
            const data = await response.json();
            hideLoader();

            if (response.ok) {
              showToast(data.message || 'Cập nhật thành công!');
              editTacGiaModal.style.display = 'none';

              // Cập nhật UI trực tiếp - tìm và cập nhật row
              const row = document.querySelector(`#table-tac-gia tr[data-id="${maTacGia}"]`);
              if (row) {
                row.cells[2].textContent = formData.HoTen;
                row.cells[3].textContent = formData.NamSinh || '';
              }

              // Cập nhật allAuthors
              const authorIndex = allAuthors.findIndex(a => a.MaTacGia === maTacGia);
              if (authorIndex >= 0) {
                allAuthors[authorIndex].HoTen = formData.HoTen;
                allAuthors[authorIndex].NamSinh = formData.NamSinh;
              }
            } else {
              showToast(data.error || 'Có lỗi xảy ra!', 'error');
            }
          } catch (error) {
            hideLoader();
            console.error('[ERROR] updateTacGia:', error);
            showToast('Lỗi kết nối server!', 'error');
          }
        });
      }

      // --- TÁC GIẢ: XÓA ---
      document.getElementById('table-tac-gia').addEventListener('click', async (e) => {
        if (e.target.classList.contains('delete-tacgia-icon') ||
          e.target.closest('.delete-tacgia-icon')) {
          const row = e.target.closest('tr');
          if (!row) return;

          const maTacGia = row.dataset.id;
          const hoTen = row.cells[2].textContent.trim();

          if (!confirm(`Bạn có chắc chắn muốn xóa tác giả: ${hoTen}?`)) return;

          console.log(`[DEBUG] Calling DELETE /api/books/authors/delete/${maTacGia}`);
          showLoader();
          try {
            const response = await fetch(`/api/books/authors/delete/${maTacGia}`, {
              method: 'DELETE'
            });
            const data = await response.json();
            hideLoader();

            console.log('[DEBUG] Response:', response.status, data);
            if (response.ok) {
              showToast(data.message || 'Xóa thành công!');
              row.remove();
            } else {
              showToast(data.error || 'Có lỗi xảy ra!', 'error');
            }
          } catch (error) {
            hideLoader();
            console.error('[ERROR] deleteTacGia:', error);
            showToast('Lỗi kết nối server!', 'error');
          }
        }
      });

      // --- MODAL CHỌN TÁC GIẢ ---
      const authorModal = document.getElementById('author-select-modal');
      const openAuthorSelectBtns = document.querySelectorAll('.open-author-select');
      const closeAuthorModalBtns = document.querySelectorAll('#author-select-modal .close-modal');
      const confirmAuthorsBtn = document.getElementById('confirm-authors');
      const authorChecklist = document.getElementById('author-checklist');
      const authorSearchInput = document.getElementById('author-search-input');
      const newAuthorInput = document.getElementById('new-author-input');
      const addNewAuthorBtn = document.getElementById('add-new-author-btn');
      let currentAuthorWrapper = null;
      let tempNewAuthors = [];

      openAuthorSelectBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          currentAuthorWrapper = e.target.closest('.author-select-wrapper');
          tempNewAuthors = [];

          const selectedIds = [];
          currentAuthorWrapper.querySelectorAll('.author-tag').forEach(tag => {
            const id = tag.dataset.id;
            const name = tag.textContent.replace('×', '').trim();
            if (id && id.startsWith('TG')) {
              selectedIds.push(id);
            } else {
              tempNewAuthors.push(name);
            }
          });

          authorChecklist.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
            checkbox.checked = selectedIds.includes(checkbox.dataset.id);
          });

          renderTempNewAuthors();
          authorModal.style.display = 'flex';
        });
      });

      if (addNewAuthorBtn) {
        addNewAuthorBtn.addEventListener('click', () => {
          const newName = newAuthorInput.value.trim();
          if (!newName) {
            showToast('Vui lòng nhập tên tác giả!', 'error');
            return;
          }

          const exists = tempNewAuthors.some(n => n.toLowerCase() === newName.toLowerCase());
          const existsInDB = Array.from(authorChecklist.querySelectorAll('input[type="checkbox"]'))
            .some(cb => cb.value.toLowerCase() === newName.toLowerCase());

          if (exists || existsInDB) {
            showToast('Tác giả này đã tồn tại!', 'error');
            return;
          }

          tempNewAuthors.push(newName);
          newAuthorInput.value = '';
          renderTempNewAuthors();
          showToast(`Đã thêm tác giả: ${newName}`, 'success');
        });
      }

      function renderTempNewAuthors() {
        authorChecklist.querySelectorAll('.temp-author-item').forEach(el => el.remove());

        tempNewAuthors.forEach(name => {
          const label = document.createElement('label');
          label.className = 'temp-author-item';
          label.style.color = 'var(--green-accent)';
          label.innerHTML = `
                          <input type="checkbox" value="${name}" data-id="" checked>
                          ${name} <em>(Mới)</em>
                          <i class="fas fa-times" style="margin-left: 8px; cursor: pointer; color: var(--red-accent);" data-name="${name}"></i>
                      `;

          label.querySelector('.fa-times').addEventListener('click', (e) => {
            e.stopPropagation();
            tempNewAuthors = tempNewAuthors.filter(n => n !== e.target.dataset.name);
            renderTempNewAuthors();
          });

          authorChecklist.appendChild(label);
        });
      }

      if (authorSearchInput) {
        authorSearchInput.addEventListener('input', (e) => {
          const searchTerm = e.target.value.toLowerCase();
          authorChecklist.querySelectorAll('label:not(.temp-author-item)').forEach(label => {
            label.style.display = label.textContent.toLowerCase().includes(searchTerm) ? 'flex' : 'none';
          });
        });
      }

      confirmAuthorsBtn.addEventListener('click', () => {
        if (!currentAuthorWrapper) return;
        currentAuthorWrapper.querySelectorAll('.author-tag').forEach(tag => tag.remove());

        authorChecklist.querySelectorAll('input[type="checkbox"]:checked').forEach(checkbox => {
          const tagHTML = `<span class="author-tag" data-id="${checkbox.dataset.id || ''}">${checkbox.value}<span class="remove-tag">×</span></span>`;
          currentAuthorWrapper.querySelector('.author-select-btn').insertAdjacentHTML('beforebegin', tagHTML);
        });

        authorModal.style.display = 'none';
        tempNewAuthors = [];
      });

      document.addEventListener('click', (e) => {
        if (e.target.classList.contains('remove-tag')) {
          e.target.closest('.author-tag').remove();
        }
      });

      closeAuthorModalBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          authorModal.style.display = 'none';
          tempNewAuthors = [];
        });
      });

      // --- CLOSE MODALS ---
      document.querySelectorAll('.close-modal').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.target.closest('.modal-overlay').style.display = 'none';
        });
      });

      window.addEventListener('click', (e) => {
        if (e.target.classList.contains('modal-overlay')) {
          e.target.style.display = 'none';
        }
      });

      // --- SIDEBAR ---
      const menuToggle = document.getElementById('menu-toggle');
      const sidebar = document.getElementById('sidebar');
      const container = document.querySelector('.dashboard-container');

      if (menuToggle && sidebar && container) {
        menuToggle.addEventListener('click', () => {
          if (window.innerWidth <= 992) { sidebar.classList.toggle('active'); }
          else { container.classList.toggle('sidebar-collapsed'); }
        });
      }

      // --- LOGIC TÌM KIẾM SÁCH ---

      // 1. Hàm bật tắt chế độ 'Khoảng' (dùng chung cho cả các trang khác nếu cần)
      window.toggleRange = function (groupId, value) {
        const group = document.getElementById(groupId);
        if (value === 'between') {
          group.classList.add('mode-range');
        } else {
          group.classList.remove('mode-range');
        }
      }

      const bookSearchForm = document.getElementById('book-search-form');
      const btnResetBook = document.getElementById('btn-reset-book-search');

      if (bookSearchForm) {
        // Xử lý nút LÀM MỚI
        if (btnResetBook) {
          btnResetBook.addEventListener('click', () => {
            bookSearchForm.reset();
            document.getElementById('group-sl-ton').classList.remove('mode-range');
            bookSearchForm.dispatchEvent(new Event('submit')); // Reload lại bảng
          });
        }

        // Xử lý sự kiện TÌM KIẾM
        bookSearchForm.addEventListener('submit', function (e) {
          e.preventDefault();
          showLoader();

          setTimeout(() => {
            // A. Lấy giá trị input
            const tenQuery = document.getElementById('search-book-ten').value.toLowerCase();
            const tacGiaQuery = document.getElementById('search-book-tacgia').value.toLowerCase();
            const theLoaiQuery = document.getElementById('search-book-theloai').value.toLowerCase();

            // Logic Số lượng tồn
            const opSL = document.getElementById('op-sl-ton').value;
            const valFrom = parseFloat(document.getElementById('search-sl-ton-from').value);
            const valTo = parseFloat(document.getElementById('search-sl-ton-to').value);

            // B. Lấy các hàng trong bảng Sách (#table-sach)
            // Lưu ý: Loại bỏ hàng thông báo lỗi cũ nếu có
            const tableBody = document.querySelector('#table-sach tbody');
            const rows = Array.from(tableBody.querySelectorAll('tr:not(.no-results-row)'));

            let resultsFound = 0;

            rows.forEach(row => {
              // Cấu trúc cột trong books.ejs:
              // 0: STT | 1: Mã | 2: Tên | 3: Thể loại | 4: Tác giả | 5: NXB | 6: Năm | 7: SL Tồn

              const tenCell = (row.cells[2]?.textContent || '').toLowerCase();
              const theLoaiCell = (row.cells[3]?.textContent || '').toLowerCase();
              const tacGiaCell = (row.cells[4]?.textContent || '').toLowerCase();
              const slTonCell = parseFloat(row.cells[7]?.textContent || 0);

              // C. So sánh chuỗi
              const matchTen = tenCell.includes(tenQuery);
              const matchTG = tacGiaCell.includes(tacGiaQuery);
              const matchTL = theLoaiCell.includes(theLoaiQuery);

              // D. So sánh số (Số lượng tồn)
              let matchSL = true;
              if (!isNaN(valFrom)) {
                switch (opSL) {
                  case '=': matchSL = slTonCell === valFrom; break;
                  case '>': matchSL = slTonCell > valFrom; break;
                  case '>=': matchSL = slTonCell >= valFrom; break;
                  case '<': matchSL = slTonCell < valFrom; break;
                  case '<=': matchSL = slTonCell <= valFrom; break;
                  case 'between':
                    if (!isNaN(valTo)) {
                      matchSL = slTonCell >= valFrom && slTonCell <= valTo;
                    } else {
                      matchSL = slTonCell >= valFrom;
                    }
                    break;
                }
              }

              // E. Kết quả
              if (matchTen && matchTG && matchTL && matchSL) {
                row.style.display = '';
                resultsFound++;
                row.cells[0].textContent = resultsFound; // Cập nhật lại STT
              } else {
                row.style.display = 'none';
              }
            });

            // F. Xử lý khi không tìm thấy
            const existingNo = tableBody.querySelector('.no-results-row');
            if (existingNo) existingNo.remove();

            if (resultsFound === 0) {
              const noRow = tableBody.insertRow();
              noRow.classList.add('no-results-row');
              // Colspan = 9 vì bảng sách có 9 cột
              noRow.innerHTML = `<td colspan="9" style="text-align: center; padding: 2rem;">Không tìm thấy sách nào phù hợp.</td>`;
            }

            hideLoader();
            showToast(`Tìm thấy ${resultsFound} cuốn sách.`, 'success');

          }, 300);
        });
      }

      // --- LOGOUT ---
      const logoutBtn = document.getElementById('logout-button');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async (e) => {
          e.preventDefault();
          if (confirm('Bạn có chắc chắn muốn đăng xuất?')) {
            window.location.href = '/logout';
          }
        });
      }
    });
  </script>
</body>

</html>
