  <script id="authors-data" type="application/json"><%- JSON.stringify(authors || []) %></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // --- HELPER FUNCTIONS ---
      const loader = document.getElementById('loader');
      const toastContainer = document.getElementById('toast-container');
      let currentEditingRow = null;

      // Lấy danh sách tác giả từ server-side data
      const allAuthors = JSON.parse(document.getElementById('authors-data')?.textContent || '[]');

      function showLoader() { if (loader) loader.style.display = 'flex'; }
      function hideLoader() { if (loader) loader.style.display = 'none'; }

      function showToast(message, type = 'success') {
        if (!toastContainer) return;
        const toast = document.createElement('div');
        toast.classList.add('toast', type);
        toast.innerHTML = `<i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} toast-icon"></i><span class="toast-message">${message}</span>`;
        toastContainer.appendChild(toast);
        setTimeout(() => toast.classList.add('show'), 100);
        setTimeout(() => {
          toast.classList.remove('show');
          setTimeout(() => toast.remove(), 300);
        }, 3000);
      }

      function collectAuthorIds(wrapper) {
        return Array.from(wrapper.querySelectorAll('.author-tag'))
          .map(tag => {
            const id = tag.dataset.id;
            const name = tag.textContent.replace('×', '').trim();
            return id && id.startsWith('TG') ? id : name;
          })
          .filter(Boolean);
      }

      // --- TAB SWITCHING ---
      const tabButtons = document.querySelectorAll('.tab-button');
      const tabPanes = document.querySelectorAll('.tab-pane');

      tabButtons.forEach(button => {
        button.addEventListener('click', function () {
          const targetId = this.dataset.target;
          const targetPane = document.querySelector(targetId);
          if (targetPane) {
            tabButtons.forEach(btn => btn.classList.remove('active'));
            tabPanes.forEach(pane => pane.classList.remove('active'));
            this.classList.add('active');
            targetPane.classList.add('active');
          }
        });
      });

      // --- ĐẦU SÁCH: THÊM MỚI ---
      const addDauSachBtn = document.getElementById('open-dausach-add-modal');
      const addDauSachModal = document.getElementById('dausach-add-modal');
      const addDauSachForm = document.getElementById('add-dausach-form');

      if (addDauSachBtn && addDauSachModal) {
        addDauSachBtn.addEventListener('click', () => {
          if (addDauSachForm) addDauSachForm.reset();
          document.getElementById('add-author-wrapper').querySelectorAll('.author-tag').forEach(tag => tag.remove());
          addDauSachModal.style.display = 'flex';
        });
      }
      let isSaveAndResetDS = false
      // NÚt Thêm mới (lưu và refill form) 
      const btnCustomDauSach = document.getElementById('btn-custom-dausach');
      if (btnCustomDauSach) {
        btnCustomDauSach.addEventListener('click', () => {
          // Kiểm tra xem form có dữ liệu không
          const hasData = document.getElementById('add-ten-sach-ds').value.trim() !== '' ||
            document.getElementById('add-author-wrapper').querySelectorAll('.author-tag').length > 0;

          if (hasData) {
            // Nếu có dữ liệu -> Hỏi
            if (confirm('Bạn đã nhập thông tin. Bạn có muốn LƯU Đầu sách này trước khi làm mới không?\n\n- OK: Lưu đầu sách này.\n- Cancel: Xóa trắng để nhập đầu sách khác.')) {
              // Chọn OK -> Lưu
              if (addDauSachForm && addDauSachForm.checkValidity()) {
                isSaveAndResetDS = true;
                addDauSachForm.requestSubmit();
              } else if (addDauSachForm) {
                addDauSachForm.reportValidity();
              }
            } else {
              // Chọn Cancel -> Chỉ Reset form, KHÔNG ĐÓNG modal
              if (addDauSachForm) addDauSachForm.reset();
              document.getElementById('add-author-wrapper').querySelectorAll('.author-tag').forEach(tag => tag.remove());
              showToast('Đã làm mới form!', 'info');
            }
          } else {
            // Nếu chưa nhập gì -> Chỉ Reset cho chắc chắn
            if (addDauSachForm) addDauSachForm.reset();
            document.getElementById('add-author-wrapper').querySelectorAll('.author-tag').forEach(tag => tag.remove());
            showToast('Form đã sẵn sàng nhập mới.', 'info');
          }
        });
      }

      if (addDauSachForm) {
        addDauSachForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const formData = {
            TenSach: document.getElementById('add-ten-sach-ds').value.trim(),
            TenTheLoai: document.getElementById('add-ma-the-loai-ds').value.trim(),
            tacGiaIds: collectAuthorIds(document.getElementById('add-author-wrapper')),
            MoTa: document.getElementById('add-mo-ta-ds').value.trim()
          };

          if (!formData.tacGiaIds || formData.tacGiaIds.length === 0) {
            showToast('Vui lòng chọn ít nhất một tác giả!', 'error');
            return;
          }

          console.log('[DEBUG] Calling POST /api/books/createDauSach with:', formData);
          showLoader();
          try {
            const response = await fetch('/api/books/createDauSach', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(formData)
            });
            const data = await response.json();
            hideLoader();

            console.log('[DEBUG] Response:', response.status, data);
            if (response.ok) {
              showToast(data.message || 'Thêm đầu sách thành công!', 'success');
              if (isSaveAndResetDS) {
                addDauSachForm.reset();
                showToast('Đã sẵn sàng nhập đầu sách tiếp theo.', 'info');
                isSaveAndResetDS = false;
              } else {
                addDauSachModal.style.display = 'none';
              }


              // Cập nhật UI trực tiếp - thêm row mới vào bảng
              const tbody = document.querySelector('#table-dau-sach tbody');
              const rowCount = tbody.querySelectorAll('tr').length;
              const newRow = document.createElement('tr');
              newRow.dataset.id = data.dauSach.MaDauSach || '';
              newRow.innerHTML = `
                        <td>${rowCount + 1}</td>
                        <td>${data.dauSach.MaDauSach || ''}</td>
                        <td>${formData.TenSach}</td>
                        <td>${formData.TenTheLoai}</td>
                        <td>${formData.tacGiaIds.join(', ')}</td>
                        <td>${formData.MoTa || ''}</td>
                        <td>
                            <i class="fas fa-pencil-alt action-icon open-dausach-edit-modal"></i>
                            <i class="fas fa-trash action-icon delete-icon delete-dausach-icon" style="margin-left: 12px; color: var(--red-accent);"></i>
                        </td>
                    `;
              tbody.appendChild(newRow);

              // Reset form
              addDauSachForm.reset();
              document.getElementById('add-author-wrapper').querySelectorAll('.author-tag').forEach(tag => tag.remove());
            } else {
              showToast(data.error || 'Có lỗi xảy ra!', 'error');
            }
          } catch (error) {
            hideLoader();
            console.error('[ERROR] createDauSach:', error);
            showToast('Lỗi kết nối server!', 'error');
          }
        });
      }

      // --- ĐẦU SÁCH: CHỈNH SỬA ---
      const editDauSachModal = document.getElementById('dausach-edit-modal');
      const editDauSachForm = document.getElementById('edit-dausach-form');
      let originalDauSachData = null; // Lưu dữ liệu ban đầu

      // Sử dụng event delegation để xử lý dynamic elements
      document.getElementById('table-dau-sach').addEventListener('click', (e) => {
        if (e.target.classList.contains('open-dausach-edit-modal') ||
          e.target.closest('.open-dausach-edit-modal')) {
          const row = e.target.closest('tr');
          if (!row) return;

          const cells = row.cells;
          const maDauSach = cells[1].textContent.trim();
          const tenSach = cells[2].textContent.trim();
          const theLoai = cells[3].textContent.trim();
          const tacGiaText = cells[4].textContent.trim();
          const moTa = cells[5].textContent.trim();

          document.getElementById('edit-ma-ds').value = maDauSach;
          document.getElementById('edit-ten-sach-ds').value = tenSach;
          document.getElementById('edit-ma-the-loai-ds').value = theLoai;
          document.getElementById('edit-mo-ta-ds').value = moTa;

          const editWrapper = document.getElementById('edit-author-wrapper');
          editWrapper.querySelectorAll('.author-tag').forEach(tag => tag.remove());
          const authorNames = tacGiaText.split(',').map(a => a.trim()).filter(Boolean);

          // Map tên tác giả với ID từ danh sách allAuthors
          const authorTags = [];
          authorNames.forEach(authorName => {
            if (authorName) {
              // Tìm ID tương ứng với tên tác giả
              const author = allAuthors.find(a => a.HoTen.trim() === authorName);
              const authorId = author ? author.MaTacGia : '';
              const tagHTML = `<span class="author-tag" data-id="${authorId}">${authorName}<span class="remove-tag">×</span></span>`;
              editWrapper.querySelector('.author-select-btn').insertAdjacentHTML('beforebegin', tagHTML);
              authorTags.push({ id: authorId, name: authorName });
            }
          });

          // Lưu dữ liệu ban đầu để có thể đặt lại
          originalDauSachData = {
            maDauSach: maDauSach,
            tenSach: tenSach,
            theLoai: theLoai,
            moTa: moTa,
            authorTags: authorTags
          };

          editDauSachModal.style.display = 'flex';
        }
      });

      // Xử lý nút "Đặt lại" cho modal edit đầu sách - Logic từ HTML
      const btnResetDauSach = document.getElementById('btn-reset-dausach');
      if (btnResetDauSach) {
        btnResetDauSach.addEventListener('click', () => {
          if (!originalDauSachData) {
            showToast('Không thể đặt lại - chưa có dữ liệu gốc', 'error');
            return;
          }

          // So sánh dữ liệu hiện tại với dữ liệu gốc
          const currentData = {
            tenSach: document.getElementById('edit-ten-sach-ds').value,
            theLoai: document.getElementById('edit-ma-the-loai-ds').value,
            moTa: document.getElementById('edit-mo-ta-ds').value
          };
          const isChanged = currentData.tenSach !== originalDauSachData.tenSach ||
            currentData.theLoai !== originalDauSachData.theLoai ||
            currentData.moTa !== originalDauSachData.moTa;

          if (!isChanged) {
            showToast('Chưa có thay đổi nào để đặt lại!', 'error');
            return;
          }

          if (confirm('Khôi phục lại dữ liệu ban đầu?\n\n- OK: Khôi phục dữ liệu ban đầu.\n- Cancel: Tiếp tục chỉnh sửa với dữ liệu hiện tại.')) {
            //     // OK: Submit form (Đã có logic save bên dưới)
            //     editDauSachForm.requestSubmit();
            // } else {
            // Cancel: Khôi phục các trường về giá trị ban đầu
            document.getElementById('edit-ma-ds').value = originalDauSachData.maDauSach;
            document.getElementById('edit-ten-sach-ds').value = originalDauSachData.tenSach;
            document.getElementById('edit-ma-the-loai-ds').value = originalDauSachData.theLoai;
            document.getElementById('edit-mo-ta-ds').value = originalDauSachData.moTa;

            // Khôi phục các tác giả
            const editWrapper = document.getElementById('edit-author-wrapper');
            editWrapper.querySelectorAll('.author-tag').forEach(tag => tag.remove());

            originalDauSachData.authorTags.forEach(author => {
              const tagHTML = `<span class="author-tag" data-id="${author.id}">${author.name}<span class="remove-tag">×</span></span>`;
              editWrapper.querySelector('.author-select-btn').insertAdjacentHTML('beforebegin', tagHTML);
            });

            showToast('Đã khôi phục dữ liệu gốc!', 'success');
          }
        });
      }

      if (editDauSachForm) {
        editDauSachForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const maDS = document.getElementById('edit-ma-ds').value;
          const formData = {
            TenSach: document.getElementById('edit-ten-sach-ds').value.trim(),
            TenTheLoai: document.getElementById('edit-ma-the-loai-ds').value.trim(),
            tacGiaIds: collectAuthorIds(document.getElementById('edit-author-wrapper')),
            MoTa: document.getElementById('edit-mo-ta-ds').value.trim()
          };

          console.log('[CLIENT] Form data collected:', formData);
          console.log('[CLIENT] Author IDs:', formData.tacGiaIds);

          if (!formData.tacGiaIds || formData.tacGiaIds.length === 0) {
            console.error('[CLIENT] No authors selected!');
            showToast('Vui lòng chọn ít nhất một tác giả!', 'error');
            return;
          }

          console.log(`[CLIENT] Calling PATCH /api/books/updateDauSach/${maDS} with:`, JSON.stringify(formData, null, 2));
          showLoader();
          try {
            const response = await fetch(`/api/books/updateDauSach/${maDS}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(formData)
            });
            const data = await response.json();
            hideLoader();

            console.log('[CLIENT] Response status:', response.status);
            console.log('[CLIENT] Response data:', data);
            if (response.ok) {
              showToast(data.message || 'Cập nhật thành công!');
              editDauSachModal.style.display = 'none';

              // Cập nhật UI trực tiếp - tìm và cập nhật row
              const row = document.querySelector(`#table-dau-sach tr[data-id="${maDS}"]`);
              if (row) {
                row.cells[2].textContent = formData.TenSach;
                row.cells[3].textContent = formData.TenTheLoai;
                row.cells[4].textContent = formData.tacGiaIds.join(', ');
                row.cells[5].textContent = formData.MoTa || '';
              }
            } else {
              showToast(data.error || 'Có lỗi xảy ra!', 'error');
            }
          } catch (error) {
            hideLoader();
            console.error('[CLIENT ERROR] updateDauSach:', error);
            showToast('Lỗi kết nối server!', 'error');
          }
        });
      }

      // --- ĐẦU SÁCH: XÓA ---
      document.getElementById('table-dau-sach').addEventListener('click', async (e) => {
        if (e.target.classList.contains('delete-dausach-icon') ||
          e.target.closest('.delete-dausach-icon')) {
          const row = e.target.closest('tr');
          if (!row) return;

          const maDS = row.dataset.id;
          const tenSach = row.cells[2].textContent.trim();

          if (!confirm(`Bạn có chắc chắn muốn xóa đầu sách: ${tenSach}?`)) return;

          console.log(`[DEBUG] Calling DELETE /api/books/deleteDauSach/${maDS}`);
          showLoader();
          try {
            const response = await fetch(`/api/books/deleteDauSach/${maDS}`, {
              method: 'DELETE'
            });
            const data = await response.json();
            hideLoader();

            console.log('[DEBUG] Response:', response.status, data);
            if (response.ok) {
              showToast(data.message || 'Xóa thành công!');
              row.remove();
            } else {
              showToast(data.error || 'Có lỗi xảy ra!', 'error');
            }
          } catch (error) {
            hideLoader();
            console.error('[ERROR] deleteDauSach:', error);
            showToast('Lỗi kết nối server!', 'error');
          }
        }
      });

      // --- SÁCH: THÊM MỚI ---
      const addSachBtn = document.getElementById('open-sach-add-modal');
      const addSachModal = document.getElementById('sach-add-modal');
      const addSachForm = document.getElementById('add-sach-form');
      const addMaDauSachSelect = document.getElementById('add-ma-dau-sach-s');
      let isSaveAndResetS = false;
      if (addSachBtn && addSachModal) {
        addSachBtn.addEventListener('click', () => {
          if (addSachForm) addSachForm.reset();
          document.getElementById('add-ten-sach-s').value = '';
          document.getElementById('add-tac-gia-s').value = '';
          document.getElementById('add-the-loai-s').value = '';
          addSachModal.style.display = 'flex';
        });
      }

      // Nút Thêm mới (lưu và refill form) - Logic từ customers.ejs
      const btnCustomSach = document.getElementById('btn-custom-sach');
      if (btnCustomSach) {
        btnCustomSach.addEventListener('click', () => {
          // Kiểm tra xem form có dữ liệu không
          const hasData = document.getElementById('add-ma-dau-sach-s').value.trim() !== '' ||
            document.getElementById('add-nxb-s').value.trim() !== '';

          if (hasData) {
