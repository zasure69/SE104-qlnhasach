    <script>
        document.addEventListener('DOMContentLoaded', function() {
            
            // --- Xử lý Responsive Sidebar (ĐÃ CẬP NHẬT THEO YÊU CẦU MỚI) ---
            const menuToggle = document.getElementById('menu-toggle');
            const sidebar = document.getElementById('sidebar');
            const container = document.querySelector('.dashboard-container'); 
            // XÓA: const sidebarCloseToggle = ...

            if (menuToggle && sidebar && container) {
                menuToggle.addEventListener('click', function() {
                    // SỬA: Nút này (Hamburger) DÙNG ĐỂ TẮT VÀ MỞ
                    if (window.innerWidth <= 992) {
                        // Mobile: Toggle
                        sidebar.classList.toggle('active');
                    } else {
                        // Desktop: Toggle (bằng cách toggle class thu gọn)
                        container.classList.toggle('sidebar-collapsed');
                    }
                });
            }

            // XÓA: Toàn bộ Event listener cho nút đóng 'X'

            // --- Xử lý Mở/Đóng Modal ---
            const addModal = document.getElementById('add-modal');
            const editModal = document.getElementById('edit-modal');
            
            const openAddModalBtn = document.getElementById('open-add-modal');
            const openEditModalBtns = document.querySelectorAll('.open-edit-modal');
            const closeModalBtns = document.querySelectorAll('.close-modal');

            // Mở modal Thêm mới
            if (openAddModalBtn && addModal) {
                openAddModalBtn.addEventListener('click', function() {
                    addModal.style.display = 'flex';
                });
            }

            // Mở modal Chỉnh sửa (cho tất cả các nút bút chì)
            if (openEditModalBtns.length > 0 && editModal) {
                openEditModalBtns.forEach(btn => {
                    btn.addEventListener('click', function() {
                        // (Trong ứng dụng thật, bạn sẽ lấy data của hàng này và điền vào form)
                        editModal.style.display = 'flex';
                    });
                });
            }

            // Đóng modal (cho tất cả các nút X và nút Hủy)
            if (closeModalBtns.length > 0) {
                closeModalBtns.forEach(btn => {
                    btn.addEventListener('click', function() {
                        // Tìm modal cha gần nhất và ẩn nó đi
                        btn.closest('.modal-overlay').style.display = 'none';
                    });
                });
            }

            // Đóng modal khi nhấn ra ngoài
            window.addEventListener('click', function(event) {
                if (event.target.classList.contains('modal-overlay')) {
                    event.target.style.display = 'none';
                }
            });

        });
    </script>

</body>
</html>

