                                mới Tác giả </button>
                        </div>
                        <div class="table-responsive">
                            <table class="data-table" id="table-tac-gia"> <!-- Thêm ID cho bảng -->
                                <thead>
                                    <tr>
                                        <th>Mã Tác giả</th>
                                        <th>Họ Tên</th>
                                        <th>Năm Sinh</th>
                                        <th></th> <!-- Cột Sửa/Xóa -->
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr data-id="TG001"> <!-- Thêm data-id -->
                                        <td>TG001</td>
                                        <td>Nguyễn Nhật Ánh</td>
                                        <td>1955</td>
                                        <td> <i class="fas fa-pencil-alt action-icon open-tacgia-edit-modal"></i> </td>
                                    </tr>
                                    <tr data-id="TG002"> <!-- Thêm data-id -->
                                        <td>TG002</td>
                                        <td>J.K. Rowling</td>
                                        <td>1965</td>
                                        <td> <i class="fas fa-pencil-alt action-icon open-tacgia-edit-modal"></i> </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>


    <!-- --- MODALS CHO THỂ LOẠI --- -->
    <div class="modal-overlay" id="theloai-add-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Thêm mới thông tin Thể loại</h2>
                <button class="close-modal"><i class="fas fa-times"></i></button>
            </div>
            <form id="add-the-loai-form">
                <div class="modal-body">
                    <div class="modal-form-grid">
                        <div class="form-group">
                            <label for="add-ten-the-loai">Tên thể loại</label>
                            <input type="text" id="add-ten-the-loai" placeholder="Tiểu thuyết" required>
                        </div>
                        <div class="form-group">
                            <label for="add-mo-ta">Mô tả</label>
                            <textarea id="add-mo-ta" placeholder="Mô tả ngắn..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary close-modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Lưu</button>
                </div>
            </form>
        </div>
    </div>
    <div class="modal-overlay" id="theloai-edit-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Chỉnh sửa thông tin Thể loại</h2>
                <button class="close-modal"><i class="fas fa-times"></i></button>
            </div>
            <form id="edit-the-loai-form">
                <div class="modal-body">
                    <div class="modal-form-grid">
                        <div class="form-group">
                            <label for="edit-ten-the-loai">Tên thể loại</label>
                            <input type="text" id="edit-ten-the-loai" value="Tiểu thuyết" required>
                        </div>
                        <div class="form-group">
                            <label for="edit-mo-ta">Mô tả</label>
                            <textarea id="edit-mo-ta">Mô tả về tiểu thuyết...</textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer edit-modal-footer">
                    <button type="button" class="btn btn-danger" id="delete-theloai-button">Xóa thể loại</button>
                    <div>
                        <button type="button" class="btn btn-secondary close-modal">Hủy</button>
                        <button type="submit" class="btn btn-primary">Lưu</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <!-- --- KẾT THÚC MODALS THỂ LOẠI --- -->


    <!-- --- MODALS CHO TÁC GIẢ --- -->
    <div class="modal-overlay" id="tacgia-add-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Thêm mới Tác giả</h2> <button class="close-modal"><i class="fas fa-times"></i></button>
            </div>
            <form id="add-tacgia-form">
                <div class="modal-body">
                    <div class="modal-form-grid">
                        <div class="form-group"> <label for="add-ma-tg">Mã Tác giả</label> <input type="text"
                                id="add-ma-tg" required> </div>
                        <div class="form-group"> <label for="add-ho-ten">Họ Tên</label> <input type="text"
                                id="add-ho-ten" required> </div>
                        <div class="form-group"> <label for="add-nam-sinh">Năm Sinh</label> <input type="number"
                                id="add-nam-sinh"> </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary close-modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Lưu</button>
                </div>
            </form>
        </div>
    </div>
    <div class="modal-overlay" id="tacgia-edit-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Chỉnh sửa Tác giả</h2> <button class="close-modal"><i class="fas fa-times"></i></button>
            </div>
            <form id="edit-tacgia-form">
                <div class="modal-body">
                    <div class="modal-form-grid">
                        <div class="form-group"> <label for="edit-ma-tg">Mã Tác giả</label> <input type="text"
                                id="edit-ma-tg" readonly> </div>
                        <div class="form-group"> <label for="edit-ho-ten">Họ Tên</label> <input type="text"
                                id="edit-ho-ten" required> </div>
                        <div class="form-group"> <label for="edit-nam-sinh">Năm Sinh</label> <input type="number"
                                id="edit-nam-sinh"> </div>
                    </div>
                </div>
                <div class="modal-footer edit-modal-footer">
                    <button type="button" class="btn btn-danger" id="delete-tacgia-button">Xóa Tác giả</button>
                    <div>
                        <button type="button" class="btn btn-secondary close-modal">Hủy</button>
                        <button type="submit" class="btn btn-primary">Lưu</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <!-- --- KẾT THÚC MODALS TÁC GIẢ --- -->


    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // --- THÊM: Các hàm điều khiển Loader và Toast ---
            const loader = document.getElementById('loader');
            const toastContainer = document.getElementById('toast-container');
            let currentEditingRow = null; // Biến lưu hàng đang sửa (cho cả 2 tab)

            function showLoader() {
                loader.style.display = 'flex';
            }
            function hideLoader() {
                loader.style.display = 'none';
            }

            function showToast(message, type = 'success') {
                const toast = document.createElement('div');
                toast.classList.add('toast', type);
                toast.innerHTML = `
                    <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} toast-icon"></i>
                    <span class="toast-message">${message}</span>
                `;
                toastContainer.appendChild(toast);

                // Hiển thị toast
                setTimeout(() => {
                    toast.classList.add('show');
                }, 100); // 100ms sau khi thêm vào DOM

                // Tự động ẩn sau 3 giây
                setTimeout(() => {
                    toast.classList.remove('show');
                    // Xóa hẳn khỏi DOM sau khi animation kết thúc
                    toast.addEventListener('transitionend', () => {
                        if (toast.parentNode) {
                            toast.parentNode.removeChild(toast);
                        }
                    });
                }, 3000);
            }

            // Hàm giả lập API call
            function simulateApiCall(callback) {
                showLoader();
                setTimeout(() => {
                    hideLoader();
                    const success = Math.random() < 0; 
                    callback(success); 
                }, 1500); 
            }
            // --- KẾT THÚC HÀM MỚI ---

            // --- Xử lý Sidebar ---
            const menuToggle = document.getElementById('menu-toggle');
            const sidebar = document.getElementById('sidebar');
            const container = document.querySelector('.dashboard-container');
            if (menuToggle && sidebar && container) {
                menuToggle.addEventListener('click', function () {
                    if (window.innerWidth <= 992) { sidebar.classList.toggle('active'); }
                    else { container.classList.toggle('sidebar-collapsed'); }
                });
            }

            // --- Xử lý Chuyển Tab ---
            const tabButtons = document.querySelectorAll('.tab-button');
            const tabPanes = document.querySelectorAll('.tab-pane');
            if (tabButtons.length > 0 && tabPanes.length > 0) {
                tabButtons.forEach(button => {
                    button.addEventListener('click', function () {
                        const targetId = this.dataset.target;
                        const targetPane = document.querySelector(targetId);
                        if (targetPane) {
                            tabButtons.forEach(btn => btn.classList.remove('active'));
                            tabPanes.forEach(pane => pane.classList.remove('active'));
                            this.classList.add('active');
                            targetPane.classList.add('active');
                        }
                    });
                });
            }

            // --- Xử lý Modals THỂ LOẠI ---
            const theloaiAddModal = document.getElementById('theloai-add-modal');
            const theloaiEditModal = document.getElementById('theloai-edit-modal');
            const openTheloaiAddBtn = document.getElementById('open-theloai-add-modal');
            const openTheloaiEditBtns = document.querySelectorAll('.open-theloai-edit-modal');
            const addTheLoaiForm = document.getElementById('add-the-loai-form');
            const editTheLoaiForm = document.getElementById('edit-the-loai-form');
            const deleteTheLoaiBtn = document.getElementById('delete-theloai-button');

            if (openTheloaiAddBtn) openTheloaiAddBtn.addEventListener('click', () => {
                addTheLoaiForm.reset();
                theloaiAddModal.style.display = 'flex';
            });
            openTheloaiEditBtns.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    currentEditingRow = e.target.closest('tr'); // Lưu hàng đang sửa
                    // Giả lập lấy data
                    document.getElementById('edit-ten-the-loai').value = currentEditingRow.cells[2].textContent;
                    document.getElementById('edit-mo-ta').value = currentEditingRow.cells[3].textContent;
                    theloaiEditModal.style.display = 'flex';
                });
            });

            // SỬA: Logic submit form Thêm Thể loại
            if (addTheLoaiForm) {
                addTheLoaiForm.addEventListener('submit', (e) => {
                    e.preventDefault();
                    simulateApiCall((success) => {
                        if (success) {
                            // Thêm logic cập nhật bảng (giả lập)
                            const table = document.getElementById('table-the-loai').getElementsByTagName('tbody')[0];
                            const newRow = table.insertRow();
                            newRow.innerHTML = `
                                <td>${table.rows.length + 1}</td>
                                <td>TL${String(table.rows.length + 1).padStart(2, '0')}</td>
                                <td>${document.getElementById('add-ten-the-loai').value}</td>
                                <td>${document.getElementById('add-mo-ta').value}</td>
                                <td> <i class="fas fa-pencil-alt action-icon open-theloai-edit-modal"></i> </td>
                            `;
                            theloaiAddModal.style.display = 'none';
                            showToast('Thêm thể loại thành công!', 'success');
                        } else {
                            showToast('Có lỗi xảy ra!', 'error');
                        }
                    });
                });
            }

            // SỬA: Logic submit form Sửa Thể loại
            if (editTheLoaiForm) {
                editTheLoaiForm.addEventListener('submit', (e) => {
                    e.preventDefault();
                    simulateApiCall((success) => {
                        if (success) {
                            // Cập nhật bảng (giả lập)
                            if (currentEditingRow) {
                                currentEditingRow.cells[2].textContent = document.getElementById('edit-ten-the-loai').value;
                                currentEditingRow.cells[3].textContent = document.getElementById('edit-mo-ta').value;
                            }
                            theloaiEditModal.style.display = 'none';
                            showToast('Cập nhật thể loại thành công!', 'success');
                            currentEditingRow = null;
                        } else {
                            showToast('Có lỗi xảy ra!', 'error');
                        }
                    });
                });
            }

            // SỬA: Logic nút Xóa Thể loại
            if (deleteTheLoaiBtn) {
                deleteTheLoaiBtn.addEventListener('click', () => {
                    if (confirm('Bạn có chắc chắn muốn xóa?')) {
                        simulateApiCall((success) => {
                            if (success) {
                                if (currentEditingRow) {
                                    currentEditingRow.remove();
                                }
                                theloaiEditModal.style.display = 'none';
                                showToast('Xóa thể loại thành công!', 'success');
                                currentEditingRow = null;
                            } else {
                                showToast('Có lỗi xảy ra!', 'error');
                            }
                        });
                    }
                });
            }

            // --- Xử lý Modals TÁC GIẢ ---
            const tacgiaAddModal = document.getElementById('tacgia-add-modal');
            const tacgiaEditModal = document.getElementById('tacgia-edit-modal');
            const openTacgiaAddBtn = document.getElementById('open-tacgia-add-modal');
            const openTacgiaEditBtns = document.querySelectorAll('.open-tacgia-edit-modal');
            const addTacGiaForm = document.getElementById('add-tacgia-form');
            const editTacGiaForm = document.getElementById('edit-tacgia-form');
            const deleteTacGiaBtn = document.getElementById('delete-tacgia-button');

            if (openTacgiaAddBtn) openTacgiaAddBtn.addEventListener('click', () => {
                addTacGiaForm.reset();
                tacgiaAddModal.style.display = 'flex';
            });
            openTacgiaEditBtns.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    currentEditingRow = e.target.closest('tr');
                    const maTG = currentEditingRow.cells[0].textContent;
                    const hoTen = currentEditingRow.cells[1].textContent;
                    const namSinh = currentEditingRow.cells[2].textContent;

                    document.getElementById('edit-ma-tg').value = maTG;
                    document.getElementById('edit-ho-ten').value = hoTen;
                    document.getElementById('edit-nam-sinh').value = namSinh;

                    tacgiaEditModal.style.display = 'flex';
                });
            });

            // SỬA: Logic submit form Thêm Tác giả
            if (addTacGiaForm) {
                addTacGiaForm.addEventListener('submit', (e) => {
                    e.preventDefault();
                    simulateApiCall((success) => {
                        if (success) {
                            const table = document.getElementById('table-tac-gia').getElementsByTagName('tbody')[0];
                            const newRow = table.insertRow();
                            newRow.innerHTML = `
                                <td>${document.getElementById('add-ma-tg').value}</td>
                                <td>${document.getElementById('add-ho-ten').value}</td>
                                <td>${document.getElementById('add-nam-sinh').value}</td>
                                <td> <i class="fas fa-pencil-alt action-icon open-tacgia-edit-modal"></i> </td>
                            `;
                            tacgiaAddModal.style.display = 'none';
                            showToast('Thêm tác giả thành công!', 'success');
                        } else {
                            showToast('Có lỗi xảy ra!', 'error');
                        }
                    });
                });
            }

            // SỬA: Logic submit form Sửa Tác giả
            if (editTacGiaForm) {
                editTacGiaForm.addEventListener('submit', (e) => {
                    e.preventDefault();
                    simulateApiCall((success) => {
                        if (success) {
                            if (currentEditingRow) {
                                currentEditingRow.cells[1].textContent = document.getElementById('edit-ho-ten').value;
                                currentEditingRow.cells[2].textContent = document.getElementById('edit-nam-sinh').value;
                            }
                            tacgiaEditModal.style.display = 'none';
                            showToast('Cập nhật tác giả thành công!', 'success');
                            currentEditingRow = null;
                        } else {
                            showToast('Có lỗi xảy ra!', 'error');
                        }
                    });
                });
            }

            // SỬA: Logic nút Xóa Tác giả
            if (deleteTacGiaBtn) {
                deleteTacGiaBtn.addEventListener('click', () => {
                    if (confirm('Bạn có chắc chắn muốn xóa?')) {
                        simulateApiCall((success) => {
                            if (success) {
                                if (currentEditingRow) {
                                    currentEditingRow.remove();
                                }
                                tacgiaEditModal.style.display = 'none';
                                showToast('Xóa tác giả thành công!', 'success');
                                currentEditingRow = null;
                            } else {
                                showToast('Có lỗi xảy ra!', 'error');
                            }
                        });
                    }
                });
            }


            // --- Xử lý Đóng Modal (Chung) ---
            const closeModalBtns = document.querySelectorAll('.close-modal');
            closeModalBtns.forEach(btn => {
                btn.addEventListener('click', function () {
                    btn.closest('.modal-overlay').style.display = 'none';
                    currentEditingRow = null; // Reset khi đóng
                });
            });
            window.addEventListener('click', function (event) {
                if (event.target.classList.contains('modal-overlay')) {
                    event.target.style.display = 'none';
                    currentEditingRow = null; // Reset khi đóng
                }
            });

            // --- LOGOUT ---
    const logoutBtn = document.getElementById('logout-button');
    if(logoutBtn) {
        logoutBtn.addEventListener('click', async (e) => {
            e.preventDefault();
            if(confirm('Bạn có chắc chắn muốn đăng xuất?')) {
                window.location.href = '/logout';
            }
        });
    }

        });
    </script>

</body>

</html>