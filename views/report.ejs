    <script>
        function tableHasNoData(rows) {
            return (
                rows.length === 0 ||
                (rows.length === 1 &&
                    rows[0].innerText.toLowerCase().includes("không có"))
            );
        }

        function formatPeriodFromMonthInput(value) {
            if (!value || typeof value !== 'string' || !value.includes('-')) return '';
            const [year, month] = value.split('-');
            const m = parseInt(month, 10);
            if (!year || Number.isNaN(m)) return value;
            return `Tháng ${m}/${year}`;
        }

        function preparePrint(activePane, monthInputId, documentTitle) {
            if (!activePane) return;

            const monthValue = document.getElementById(monthInputId)?.value || '';
            const periodText = formatPeriodFromMonthInput(monthValue);
            const nowText = new Date().toLocaleString('vi-VN');

            activePane.querySelectorAll('.print-period').forEach((el) => {
                el.textContent = periodText;
            });
            activePane.querySelectorAll('.print-datetime').forEach((el) => {
                el.textContent = nowText;
            });

            if (documentTitle) {
                document.title = documentTitle;
            }
        }

        function confirmPrint(title = "Báo cáo", monthInputId) {
            const ok = confirm(`Bạn có muốn in ${title} không?`);
            if (!ok) return;

            const activePane = document.querySelector('.tab-pane.active');
            const monthValue = monthInputId ? (document.getElementById(monthInputId)?.value || '') : '';
            const safeMonth = monthValue ? monthValue.replace('-', '_') : '';
            const docTitle = `${title}${safeMonth ? ' - ' + safeMonth : ''}`;
            if (monthInputId) {
                preparePrint(activePane, monthInputId, docTitle);
            }
            window.print();
        }
        document.addEventListener('DOMContentLoaded', function () {

            // ============================================================
            // 1. CÁC HÀM TIỆN ÍCH (UI & FORMAT)
            // ============================================================
            const loader = document.getElementById('loader');
            const toastContainer = document.getElementById('toast-container');

            // Hàm định dạng tiền tệ (VND)
            const formatCurrency = (amount) => {
                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
            };

            function showLoader() { if (loader) loader.style.display = 'flex'; }
            function hideLoader() { if (loader) loader.style.display = 'none'; }

            function showToast(message, type = 'success') {
                const toast = document.createElement('div');
                toast.classList.add('toast', type);
                toast.innerHTML = `
                <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} toast-icon"></i>
                <span class="toast-message">${message}</span>
            `;
                if (toastContainer) {
                    toastContainer.appendChild(toast);
                    setTimeout(() => { toast.classList.add('show'); }, 100);
                    setTimeout(() => {
                        toast.classList.remove('show');
                        toast.addEventListener('transitionend', () => {
                            if (toast.parentNode) toast.parentNode.removeChild(toast);
                        });
                    }, 3000);
                }
            }

            // ============================================================
            // 2. HÀM GỌI API (THAY THẾ simulateApiCall)
            // ============================================================
            async function fetchReportData(type, dateString) {
                if (!dateString) return null;
                showLoader();
                try {
                    // dateString dạng "2024-05" -> Tách ra year=2024, month=05
                    const [year, month] = dateString.split('-');

                    let url = '';
                    if (type === 'doanhthu') url = `/api/report/revenue?month=${month}&year=${year}`;
                    else if (type === 'congno') url = `/api/report/debt?month=${month}&year=${year}`;
                    else if (type === 'ton') url = `/api/report/inventory?month=${month}&year=${year}`;

                    const response = await fetch(url);
                    const result = await response.json();

                    if (!response.ok) {
                        // Hiển thị thông báo lỗi từ server (ví dụ: báo cáo chưa khả dụng)
                        hideLoader();
                        showToast(result.error || `Lỗi server: ${response.status}`, 'error');
                        return null;
                    }

                    hideLoader();
                    showToast('Cập nhật dữ liệu thành công!', 'success');
                    return result;
                } catch (error) {
                    hideLoader();
                    console.error(error);
                    showToast('Không tải được báo cáo: ' + error.message, 'error');
                    return null;
                }
            }

            // ============================================================
            // 3. CÁC HÀM RENDER (VẼ BẢNG)
            // ============================================================

            // --- Render Bảng Doanh Thu ---
            function renderRevenueTable(data, totalRevenue) {
                const tbody = document.querySelector('#revenue-report-table tbody');
                const summaryDiv = document.getElementById('display-tong-doanh-thu'); // Cần ID này trong HTML

                // Cập nhật dòng tổng tiền
                if (summaryDiv) {
                    summaryDiv.textContent = `Tổng doanh thu: ${formatCurrency(totalRevenue || 0)}`;
                }

                if (!tbody) return;
                tbody.innerHTML = ''; // Xóa dữ liệu cũ

                if (!data || data.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; padding: 20px;">Không có dữ liệu tháng này</td></tr>`;
                    return;
                }

                data.forEach((item, index) => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                    <td>${index + 1}</td>
                    <td>${item.MaTheLoai}</td> <td>${item.SoLuongBan}</td>
                    <td>${formatCurrency(item.ThanhTien)}</td>
                    <td>${item.TiLe}</td>
                `;
                    tbody.appendChild(tr);
                });
            }

            // --- Render Bảng Công Nợ ---
            function renderDebtTable(data) {
                const tbody = document.querySelector('#debt-report-table tbody');
                if (!tbody) return;
                tbody.innerHTML = '';

                if (!data || data.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding: 20px;">Không có dữ liệu công nợ</td></tr>`;
                    return;
                }

                data.forEach((item, index) => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                    <td>${index + 1}</td>
                    <td>${item.MaKhachHang}</td>
                    <td>${item.HoVaTen}</td>
                    <td>${formatCurrency(item.NoDau)}</td>
                    <td>${formatCurrency(item.NoPhatSinh)}</td>
                    <td>${formatCurrency(item.NoCuoi)}</td>
                `;
                    tbody.appendChild(tr);
                });
            }

            // --- Render Bảng Tồn Kho ---
            function renderInventoryTable(data) {
                const tbody = document.querySelector('#inventory-report-table tbody');
                if (!tbody) return;
                tbody.innerHTML = '';

                if (!data || data.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding: 20px;">Không có dữ liệu tồn kho</td></tr>`;
                    return;
                }

                data.forEach((item, index) => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                    <td>${index + 1}</td>
                    <td>${item.TenSach}</td>
                    <td>${item.TonDau}</td>
                    <td>${item.Nhap}</td>
                    <td>${item.Ban}</td>
                    <td>${item.TonCuoi}</td>
                `;
                    tbody.appendChild(tr);
                });
            }

            // ============================================================
            // 4. SỰ KIỆN & KHỞI TẠO (LOGIC CHÍNH)
            // ============================================================

            // --- Xử lý Sidebar (Giữ nguyên của bạn) ---
            const menuToggle = document.getElementById('menu-toggle');
            const sidebar = document.getElementById('sidebar');
            const container = document.querySelector('.dashboard-container');
            if (menuToggle && sidebar && container) {
                menuToggle.addEventListener('click', function () {
                    if (window.innerWidth <= 992) { sidebar.classList.toggle('active'); }
                    else { container.classList.toggle('sidebar-collapsed'); }
                });
            }

            // --- Lấy các Input Date ---
            const inputDoanhThu = document.getElementById('month-doanh-thu');
            const inputCongNo = document.getElementById('month-cong-no');
            const inputTon = document.getElementById('month-ton');

            // --- Sự kiện khi chọn ngày (Thay đổi Input) ---
            if (inputDoanhThu) {
                inputDoanhThu.addEventListener('change', async function () {
                    const result = await fetchReportData('doanhthu', this.value);
                    if (!result) return;

                    // 1. Render lại bảng
                    renderRevenueTable(result.data, result.totalRevenue);

                    // 2. NẾU biểu đồ doanh thu đang tồn tại → UPDATE
                    if (doanhThuChart) {
                        const rows = document.querySelectorAll("#revenue-report-table tbody tr");
                        const labels = [];
                        const data = [];

                        rows.forEach(row => {
                            const cells = row.querySelectorAll("td");
                            if (cells.length >= 5) {
                                labels.push(cells[1].innerText.trim()); // Thể loại
                                data.push(
                                    Number(cells[3].innerText.replace(/[^\d]/g, "")) || 0
                                ); // Thành tiền
                            }
                        });

                        doanhThuChart.data.labels = labels;
                        doanhThuChart.data.datasets[0].data = data;
                        doanhThuChart.update();
                    }
                });
            }

            if (inputCongNo) {
                inputCongNo.addEventListener('change', async function () {
                    const result = await fetchReportData('congno', this.value);
                    if (!result) return;

                    renderDebtTable(result.data);

                    // Nếu biểu đồ đang mở → cập nhật
                    const wrapper = document.getElementById("chart-congno-wrapper");
                    if (congNoChart && wrapper.style.display === "block") {
                        const rows = document.querySelectorAll("#debt-report-table tbody tr");
                        const labels = [];
                        const data = [];

                        rows.forEach(row => {
                            const cells = row.querySelectorAll("td");
                            if (cells.length >= 6) {
                                labels.push(cells[2].innerText.trim());
                                data.push(Number(
                                    cells[5].innerText.replace(/[^\d]/g, "")
                                ) || 0);
                            }
                        });

                        congNoChart.data.labels = labels;
                        congNoChart.data.datasets[0].data = data;
                        congNoChart.update();
                    }
                });
            }

            if (inputTon) {
                inputTon.addEventListener('change', async function () {
                    const result = await fetchReportData('ton', this.value);
                    if (!result) return;

                    renderInventoryTable(result.data);

                    // Nếu biểu đồ đang tồn tại & đang hiện → update
                    const wrapper = document.getElementById("chart-ton-wrapper");
                    if (tonKhoChart && wrapper.style.display === "block") {
                        const rows = document.querySelectorAll("#inventory-report-table tbody tr");
                        const labels = [];
                        const data = [];

                        rows.forEach(row => {
                            const cells = row.querySelectorAll("td");
                            if (cells.length >= 6) {
                                labels.push(cells[1].innerText.trim());
                                data.push(Number(cells[5].innerText) || 0);
                            }
                        });

                        tonKhoChart.data.labels = labels;
                        tonKhoChart.data.datasets[0].data = data;
                        tonKhoChart.update();
                    }

                });
            }

            // --- Khởi tạo giá trị mặc định (Tháng hiện tại) ---
            const now = new Date();
            const currentMonthStr = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;

            [inputDoanhThu, inputCongNo, inputTon].forEach(input => {
                if (input) input.value = currentMonthStr;
            });

            // Tự động tải dữ liệu cho tab mặc định (Báo cáo Tồn)
            if (inputTon) inputTon.dispatchEvent(new Event('change'));


            // --- Xử lý Chuyển Tab và Tải dữ liệu khi chuyển ---
            const tabButtons = document.querySelectorAll('.tab-button');
            const tabPanes = document.querySelectorAll('.tab-pane');

            if (tabButtons.length > 0) {
                tabButtons.forEach(button => {
                    button.addEventListener('click', function () {
                        // UI Switch
                        tabButtons.forEach(btn => btn.classList.remove('active'));
                        tabPanes.forEach(pane => pane.classList.remove('active'));
                        this.classList.add('active');
                        const targetId = this.dataset.target;
                        const targetPane = document.querySelector(targetId);
                        if (targetPane) targetPane.classList.add('active');

                        // Data Load Trigger (Nếu tab đó chưa có dữ liệu hoặc muốn reload)
                        if (targetId === '#tab-doanh-thu' && inputDoanhThu)
                            inputDoanhThu.dispatchEvent(new Event('change'));

                        if (targetId === '#tab-cong-no' && inputCongNo)
                            inputCongNo.dispatchEvent(new Event('change'));

                        if (targetId === '#tab-ton' && inputTon)
                            inputTon.dispatchEvent(new Event('change'));
                    });
                });
            }

            // --- LOGOUT ---
            const logoutBtn = document.getElementById('logout-button');
            if (logoutBtn) {
                logoutBtn.addEventListener('click', async (e) => {
                    e.preventDefault();
                    if (confirm('Bạn có chắc chắn muốn đăng xuất?')) {
                        window.location.href = '/logout';
                    }
                });
            }

        });

        let tonKhoChart = null;
        let congNoChart = null;
        let doanhThuChart = null;
        document.addEventListener("DOMContentLoaded", function () {
            document.getElementById("btn-xem-bieudo-ton")
                .addEventListener("click", function () {

                    const wrapper = document.getElementById("chart-ton-wrapper");
                    const ctx = document.getElementById("chart-ton-kho").getContext("2d");

                    if (wrapper.style.display === "block") {
                        wrapper.style.display = "none";
                        return;
                    }

                    const rows = document.querySelectorAll("#inventory-report-table tbody tr");

                    //KHÔNG CÓ DỮ LIỆU
                    if (tableHasNoData(rows)) {
                        alert("Không có dữ liệu tồn kho tháng này");
                        return;
                    }

                    const labels = [];
                    const data = [];

                    rows.forEach(row => {
                        const cells = row.querySelectorAll("td");
                        labels.push(cells[1].innerText.trim());
                        data.push(Number(cells[5].innerText) || 0);
                    });

                    if (tonKhoChart) tonKhoChart.destroy();

                    tonKhoChart = new Chart(ctx, {
                        type: "bar",
                        data: {
                            labels,
                            datasets: [{
                                label: "Tồn cuối",
                                data,
                                backgroundColor: "#1abc9c"
                            }]
                        },
                        options: {
                            responsive: true,
                            scales: { y: { beginAtZero: true } }
                        }
                    });

                    wrapper.style.display = "block";
                });

            document.getElementById("btn-xem-bieudo-congno")
                .addEventListener("click", function () {

                    const wrapper = document.getElementById("chart-congno-wrapper");
                    const ctx = document.getElementById("chart-congno").getContext("2d");

                    if (wrapper.style.display === "block") {
                        wrapper.style.display = "none";
                        return;
                    }

                    const rows = document.querySelectorAll("#debt-report-table tbody tr");

                    // KHÔNG CÓ DỮ LIỆU
                    if (tableHasNoData(rows)) {
                        alert("Không có dữ liệu công nợ tháng này");
                        return;
                    }

                    const labels = [];
                    const data = [];

                    rows.forEach(row => {
                        const cells = row.querySelectorAll("td");
                        labels.push(cells[2].innerText.trim());
                        data.push(Number(cells[5].innerText.replace(/[^\d]/g, "")) || 0);
                    });

                    if (congNoChart) congNoChart.destroy();

                    congNoChart = new Chart(ctx, {
                        type: "bar",
                        data: {
                            labels,
                            datasets: [{
                                label: "Nợ cuối",
                                data,
                                backgroundColor: "#3498db"
                            }]
                        },
                        options: {
                            responsive: true,
                            scales: { y: { beginAtZero: true } }
                        }
                    });

                    wrapper.style.display = "block";
                });

            document.getElementById("btn-xem-bieudo-doanhthu")
                .addEventListener("click", function () {

                    const wrapper = document.getElementById("chart-doanhthu-wrapper");
                    const ctx = document.getElementById("chart-doanhthu").getContext("2d");

                    if (wrapper.style.display === "block") {
                        wrapper.style.display = "none";
                        return;
                    }

                    const rows = document.querySelectorAll("#revenue-report-table tbody tr");

                    // KHÔNG CÓ DỮ LIỆU
                    if (tableHasNoData(rows)) {
                        alert("Không có dữ liệu doanh thu tháng này");
                        return;
                    }

                    const labels = [];
                    const data = [];

                    rows.forEach(row => {
                        const cells = row.querySelectorAll("td");
                        labels.push(cells[1].innerText.trim());
                        data.push(Number(cells[4].innerText.replace('%', '')) || 0);
                    });

                    if (doanhThuChart) doanhThuChart.destroy();

                    doanhThuChart = new Chart(ctx, {
                        type: "pie",
                        data: {
                            labels,
                            datasets: [{
                                data,
                                backgroundColor: [
                                    "#1abc9c", "#3498db", "#9b59b6",
                                    "#f1c40f", "#e67e22", "#e74c3c"
                                ]
                            }]
                        },
                        options: {
                            responsive: true,
                            plugins: {
                                legend: { position: "right" }
                            }
                        }
                    });

                    wrapper.style.display = "block";
                });



            document.getElementById("btn-xuat-ton").addEventListener("click", function () {
                const table = document.getElementById("inventory-report-table");

                if (!table) {
                    alert("Không tìm thấy bảng dữ liệu!");
                    return;
                }

                // Lấy tháng năm để đặt tên file
                const monthValue = document.getElementById("month-ton").value || "baocao";
                const fileName = `Bao_cao_ton_${monthValue}.xlsx`;

                // Chuyển HTML table → worksheet
                const worksheet = XLSX.utils.table_to_sheet(table);

                // Tạo workbook
                const workbook = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(workbook, worksheet, "BaoCaoTon");

                // Xuất file Excel
                XLSX.writeFile(workbook, fileName);
            });


            // In báo cáo tồn
            document.getElementById("btn-in-ton")?.addEventListener("click", function () {
                confirmPrint("Báo cáo tồn kho", "month-ton");
            });
            document.getElementById("btn-xuat-congno").addEventListener("click", function () {
                const table = document.getElementById("debt-report-table");

                if (!table) {
                    alert("Không tìm thấy bảng công nợ!");
                    return;
                }

                const monthValue = document.getElementById("month-cong-no").value || "baocao";
                const fileName = `Bao_cao_cong_no_${monthValue}.xlsx`;

                const worksheet = XLSX.utils.table_to_sheet(table);
                const workbook = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(workbook, worksheet, "BaoCaoCongNo");

                XLSX.writeFile(workbook, fileName);
            });

            // In báo cáo công nợ
            document.getElementById("btn-in-congno")?.addEventListener("click", function () {
                confirmPrint("Báo cáo công nợ", "month-cong-no");
            });
            // ==============================
            // XUẤT BÁO CÁO DOANH THU
            // ==============================
            document.getElementById("btn-xuat-doanhthu")?.addEventListener("click", function () {
                const table = document.getElementById("revenue-report-table");

                if (!table) {
                    alert("Không tìm thấy bảng doanh thu!");
                    return;
                }

                // Lấy tháng năm
                const monthValue = document.getElementById("month-doanh-thu").value || "baocao";
                const fileName = `Bao_cao_doanh_thu_${monthValue}.xlsx`;

                // Chuyển table → worksheet
                const worksheet = XLSX.utils.table_to_sheet(table);

                // Tạo workbook
                const workbook = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(workbook, worksheet, "BaoCaoDoanhThu");

                // Xuất file
                XLSX.writeFile(workbook, fileName);
            });


            // In báo cáo doanh thu
            document.getElementById("btn-in-doanhthu")?.addEventListener("click", function () {
                confirmPrint("Báo cáo doanh thu", "month-doanh-thu");
            });


        });
    </script>

</body>

</html>