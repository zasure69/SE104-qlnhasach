              }
            }

            if (
              e.target.classList.contains("open-edit-modal") ||
              e.target.closest(".open-edit-modal")
            ) {
              const btn = e.target.closest(".open-edit-modal");
              currentEditingRow = btn.closest("tr");
              if (!currentEditingRow) return;

              // --- LOGIC ĐIỀN DỮ LIỆU VÀO FORM ---
              // Cấu trúc bảng: STT(0), Mã(1), Tên(2), Ngày sinh(3), SĐT(4), Giới tính(5), Địa chỉ(6), Tổng nợ(7), Actions(8)
              const cells = currentEditingRow.cells;
              document.getElementById("edit-ho-ten-kh").value =
                cells[2].textContent.trim();
              document.getElementById("edit-ngay-sinh-kh").value =
                currentEditingRow.dataset.ngaySinh || '';
              document.getElementById("edit-sdt-kh").value =
                cells[4].textContent.trim();
              document.getElementById("edit-gioi-tinh-kh").value =
                cells[5].textContent.trim();
              document.getElementById("edit-dia-chi-kh").value =
