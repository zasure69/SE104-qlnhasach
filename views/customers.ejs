        //     editBtns.forEach(btn => {
        //         btn.addEventListener('click', (e) => {
        //             currentEditingRow = e.target.closest('tr');
        //             if(!currentEditingRow) return;

        //             // --- LOGIC ĐIỀN DỮ LIỆU VÀO FORM ---
        //             // Cấu trúc bảng: STT(0), Mã(1), Tên(2), Ngày sinh(3), SĐT(4), Giới tính(5), Địa chỉ(6)
        //             const cells = currentEditingRow.cells;
        //             document.getElementById('edit-ho-ten-kh').value = cells[2].textContent;
        //             document.getElementById('edit-ngay-sinh-kh').value = currentEditingRow.dataset.ngaySinh;
        //             document.getElementById('edit-sdt-kh').value = cells[4].textContent;
        //             document.getElementById('edit-gioi-tinh-kh').value = cells[5].textContent;
        //             document.getElementById('edit-dia-chi-kh').value = cells[6].textContent;

        //             // SAU KHI điền xong, lưu lại trạng thái gốc
        //             setTimeout(() => {
        //                  if(editForm) originalFormData = getFormData(editForm);
        //             }, 50);

        //             editModal.style.display = 'flex';
        //         });
        //     });
        // }

        // C. Xử lý nút ĐẶT LẠI (Thông minh)
        if (resetBtn && editForm) {
          resetBtn.addEventListener("click", () => {
            const currentData = getFormData(editForm);
            // So sánh dữ liệu hiện tại với bản gốc
            const isChanged =
              JSON.stringify(currentData) !==
              JSON.stringify(originalFormData);

            if (!isChanged) {
              showToast("Chưa có thay đổi nào để đặt lại!", "error");
              return;
            }

