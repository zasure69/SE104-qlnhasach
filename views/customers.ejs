            if (soDienThoai.length !== 10) {
              showToast('Số điện thoại không hợp lệ! Vui lòng nhập đủ 10 số.', 'error');
              return;
            }

            // Validate ngày sinh không được sau ngày hiện tại
            if (data.ngaySinh) {
              const ngaySinh = new Date(data.ngaySinh);
              const today = new Date();
              today.setHours(0, 0, 0, 0);
              if (ngaySinh > today) {
                showToast('Ngày sinh không hợp lệ! Không được sau ngày hiện tại.', 'error');
                return;
              }
            }

            showLoader();
            try {
              const response = await fetch(
                `/api/customers/updateCustomers/${maKH}`,
                {
                  method: "PATCH",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify(data),
                }
              );
              const result = await response.json();
              hideLoader();
              if (response.ok) {
                showToast("Cập nhật thành công!", "success");
                editModal.style.display = "none";
                // Cập nhật hàng (hoặc reload)
                const options = {
                  year: "numeric",
                  month: "2-digit",
                  day: "2-digit",
                };
                currentEditingRow.cells[2].textContent =
                  result.customer.HoVaTen;
                currentEditingRow.cells[3].textContent =
                  result.customer.NgaySinh;
                currentEditingRow.cells[4].textContent =
                  result.customer.SoDienThoai;
                currentEditingRow.cells[5].textContent =
                  result.customer.GioiTinh;
                currentEditingRow.cells[6].textContent =
                  result.customer.DiaChi;
                currentEditingRow.dataset.ngaySinh = new Date(
                  result.customer.NgaySinh
                )
                  .toISOString()
                  .split("T")[0];
                currentEditingRow = null;
              } else {
                showToast(`Cập nhật thất bại: ${result.error}`, "error");
              }
            } catch (err) {
              hideLoader();
              showToast("Lỗi kết nối máy chủ.", "error");
            }
          });
        }
      }

      // --- 4. GỌI HÀM SETUP CHO KHÁCH HÀNG ---
      setupSmartModal({
        addBtnId: "open-add-modal",
        addModalId: "add-modal",
        addFormId: "add-kh-form",
        editModalId: "edit-modal",
        formId: "edit-kh-form",
        editBtnClass: ".open-edit-modal",
        resetBtnId: "btn-reset-edit", // ID nút Đặt lại
        tableSelector: "#customer-table", // ID bảng khách hàng
        typeName: "Khách hàng",
      });

      // --- 5. XỬ LÝ NÚT "THÊM MỚI" (CUSTOM RESET) Ở MODAL THÊM ---
      // Logic: Nút "Thêm mới" màu xám.
      // - Nếu có dữ liệu: Hỏi Lưu hay Reset. Reset thì xóa trắng, KHÔNG đóng modal.
      // - Nếu chưa có dữ liệu: Reset, KHÔNG đóng modal.

      const btnCustomReset = document.getElementById("btn-custom-reset");
      const addKhForm = document.getElementById("add-kh-form");
      let isSaveAndReset = false;
      if (btnCustomReset && addKhForm) {
        btnCustomReset.addEventListener("click", () => {
          // Kiểm tra xem form có dữ liệu không (check tên KH)
          const hasData =
            document.getElementById("add-ho-ten-kh").value.trim() !== "";

          if (hasData) {
            // Nếu có dữ liệu -> Hỏi
            if (
              confirm(
                "Bạn đã nhập thông tin. Bạn có muốn LƯU Khách hàng này trước khi làm mới không?\n\n- OK: Lưu khách hàng này.\n- Cancel: Xóa trắng để nhập khách hàng khác."
              )
            ) {
              // Chọn OK -> Lưu
              if (addKhForm.checkValidity()) {
                isSaveAndReset = true;
                addKhForm.requestSubmit();
              } else {
                addKhForm.reportValidity();
              }
            } else {
              // Chọn Cancel -> Chỉ Reset form, KHÔNG ĐÓNG modal
              addKhForm.reset();
              showToast("Đã làm mới form!", "info");
            }
          } else {
            // Nếu chưa nhập gì -> Chỉ Reset cho chắc chắn
            addKhForm.reset();
            showToast("Form đã sẵn sàng nhập mới.", "info");
          }
        });

        // Xử lý sự kiện Submit Form Thêm
        addKhForm.addEventListener("submit", async (e) => {
          e.preventDefault();

          const data = {
            hoTen: document.getElementById("add-ho-ten-kh").value,
            ngaySinh:
              document.getElementById("add-ngay-sinh-kh").value || null,
            gioiTinh: document.getElementById("add-gioi-tinh-kh").value,
            soDienThoai: document.getElementById("add-sdt-kh").value,
            diaChi: document.getElementById("add-dia-chi-kh").value,
          };

          // Validate số điện thoại phải đủ 10 số
          const soDienThoai = data.soDienThoai.toString().replace(/\D/g, '');
          if (soDienThoai.length !== 10) {
            showToast('Số điện thoại không hợp lệ! Vui lòng nhập đủ 10 số.', 'error');
            isSaveAndReset = false;
            return;
          }

          // Validate ngày sinh không được sau ngày hiện tại
          if (data.ngaySinh) {
            const ngaySinh = new Date(data.ngaySinh);
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            if (ngaySinh > today) {
              showToast('Ngày sinh không hợp lệ! Không được sau ngày hiện tại.', 'error');
              isSaveAndReset = false;
              return;
            }
          }

          showLoader();
          try {
            const response = await fetch("/api/customers/createCustomers", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(data),
            });
            const result = await response.json();
            hideLoader();
            if (response.ok) {
              await showToast("Thêm khách hàng thành công!", "success");
              if (isSaveAndReset) {
                // Trường hợp 1: Từ nút "Thêm mới" (Lưu -> Reset form -> Không đóng)
                addKhForm.reset();
                showToast("Đã sẵn sàng nhập khách hàng tiếp theo.", "info");

                // Reset cờ về false sau khi xong việc
                isSaveAndReset = false;
              } else {
                document.getElementById("add-modal").style.display = "none";
                addKhForm.reset();
              }

              fetchCustomers(); // Tải lại danh sách khách hàng
            } else {
              // Chọn Cancel -> Chỉ Reset form, KHÔNG ĐÓNG modal
              addKhForm.reset();
              showToast("Thêm khách hàng thất bại: " + result.error, "error");
