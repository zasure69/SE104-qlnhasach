  <script>
    document.addEventListener("DOMContentLoaded", function () {
      // --- 1. CÁC HÀM TIỆN ÍCH (LOADER, TOAST, FETCH DATA) ---
      const loader = document.getElementById("loader");
      const toastContainer = document.getElementById("toast-container");
      let currentEditingRow = null;

      function showLoader() {
        loader.style.display = "flex";
      }
      function hideLoader() {
        loader.style.display = "none";
      }

      function showToast(message, type = "success") {
        const toast = document.createElement("div");
        toast.classList.add("toast", type);
        const iconClass =
          type === "success" ? "fa-check-circle" : "fa-exclamation-circle";
        toast.innerHTML = `<i class="fas ${iconClass} toast-icon"></i><span class="toast-message">${message}</span>`;
        toastContainer.appendChild(toast);
        setTimeout(() => {
          toast.classList.add("show");
        }, 100);
        setTimeout(() => {
          toast.classList.remove("show");
          toast.addEventListener("transitionend", () => {
            if (toast.parentNode) {
              toast.parentNode.removeChild(toast);
            }
          });
        }, 3000);
      }

      function simulateApiCall(callback) {
        showLoader();
        setTimeout(() => {
          hideLoader();
          const success = Math.random() > 0.1; // 90% thành công
          callback(success);
        }, 1000);
      }

      // Hàm load danh sách khách hàng từ Server
      async function fetchCustomers() {
        // 1. Hiển thị loader trong lúc chờ dữ liệu
        // (Nếu bạn có element loader thì bỏ comment dòng dưới)
        // showLoader();

        try {
          // 2. Gọi API (Đường dẫn này phải khớp với backend của bạn)
          const response = await fetch("/api/customers/getCustomers");

          if (!response.ok) {
            throw new Error("Không thể tải dữ liệu");
          }

          // 3. Chuyển đổi dữ liệu nhận được sang JSON
          const customers = await response.json();

          // 4. Tìm thẻ tbody của bảng để bắt đầu vẽ
          const tbody = document.querySelector("#customer-table tbody");
          tbody.innerHTML = ""; // Xóa sạch dữ liệu cũ (nếu có)

          // 5. Kiểm tra xem có dữ liệu không
          if (customers && customers.length > 0) {
            // 6. Duyệt qua từng khách hàng để tạo dòng
            customers.forEach((customer, index) => {
              // --- XỬ LÝ NGÀY THÁNG ---
              let rawNgaySinh = '';
              let formattedNgaySinh = '';
              
              if (customer.NgaySinh) {
                const dateObj = new Date(customer.NgaySinh);
                if (!isNaN(dateObj.getTime())) {
                  rawNgaySinh = dateObj.toISOString().split("T")[0];
                  formattedNgaySinh = dateObj.toLocaleDateString("vi-VN", {
                    day: "2-digit",
                    month: "2-digit", 
                    year: "numeric"
                  });
                }
              }

              // --- TẠO DÒNG TR ---
              const tr = document.createElement("tr");

              // Lưu các dữ liệu quan trọng vào dataset để nút Sửa dễ lấy
              tr.dataset.id = customer.MaKhachHang;
              tr.dataset.ngaySinh = rawNgaySinh;

              // --- ĐIỀN NỘI DUNG HTML ---
              tr.innerHTML = `
                                <td>${index + 1}</td>
                                <td>${customer.MaKhachHang}</td>
                                <td>${customer.HoVaTen || ''}</td>
                                <td>${formattedNgaySinh}</td>
                                <td>${customer.SoDienThoai || ''}</td>
                                <td>${customer.GioiTinh || ''}</td>
                                <td>${customer.DiaChi || ''}</td>
                                <td>${new Intl.NumberFormat('vi-VN').format(Math.round(customer.TongNo || 0))}</td>
                                <td>
                                    <i class="fas fa-pencil-alt action-icon open-edit-modal"></i>
                                    <i class="fas fa-trash action-icon delete-icon" style="margin-left: 12px; color: var(--red-accent); cursor: pointer;" title="Xóa"></i>
                                </td>
                            `;

              // Gắn dòng vừa tạo vào bảng
              tbody.appendChild(tr);
            });
          } else {
            // Trường hợp không có dữ liệu
            tbody.innerHTML =
              '<tr><td colspan="9" style="text-align: center; padding: 20px;">Không có khách hàng nào.</td></tr>';
          }
        } catch (error) {
          console.error("Lỗi tải dữ liệu:", error);
          showToast("Lỗi tải danh sách khách hàng!", "error");
