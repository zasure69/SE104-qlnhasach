      // --- 6. CÁC TIỆN ÍCH KHÁC (Close modal) ---
      const closeModalBtns = document.querySelectorAll(".close-modal");
      closeModalBtns.forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.target.closest(".modal-overlay").style.display = "none";
        });
      });
      window.addEventListener("click", (e) => {
        if (e.target.classList.contains("modal-overlay"))
          e.target.style.display = "none";
      });

      // --- 7. VALIDATE DỮ LIỆU ĐẦU VÀO (MỚI THÊM) ---
      function setupInputValidation() {
        // 1. Validate HỌ TÊN (Hỗ trợ tiếng Việt tốt)
        const nameInputs = [
          document.getElementById("add-ho-ten-kh"),
          document.getElementById("edit-ho-ten-kh"),
        ];

        nameInputs.forEach((input) => {
          if (input) {
            let isComposing = false; // Cờ kiểm tra đang gõ tiếng Việt

            // Bắt đầu gõ tổ hợp phím (ví dụ: a + a = â)
            input.addEventListener("compositionstart", () => {
              isComposing = true;
            });

            // Kết thúc tổ hợp phím
            input.addEventListener("compositionend", () => {
              isComposing = false;
              validateName(input);
            });

            // Sự kiện nhập liệu thông thường
            input.addEventListener("input", function () {
              if (!isComposing) validateName(this);
            });
          }
        });

        function validateName(el) {
          // Regex \p{L}: Chấp nhận mọi ký tự chữ cái Unicode (Tiếng Việt, Anh...)
          // Loại bỏ số và ký tự đặc biệt
          const validValue = el.value.replace(/[^\p{L}\s]/gu, "");
          if (el.value !== validValue) {
            el.value = validValue;
          }
        }

        // 2. Validate SỐ ĐIỆN THOẠI (Chỉ số, Max 10)
        const phoneInputs = [
          document.getElementById("add-sdt-kh"),
          document.getElementById("edit-sdt-kh"),
        ];

        phoneInputs.forEach((input) => {
          if (input) {
            input.addEventListener("input", function () {
              // Chỉ giữ lại số
              this.value = this.value.replace(/[^0-9]/g, "");
              // Cắt nếu dài hơn 10 ký tự
              if (this.value.length > 10) {
                this.value = this.value.slice(0, 10);
              }
            });
          }
        });
      }

      // Gọi hàm kích hoạt validation
      setupInputValidation();

      // --- 9. LOGIC TÌM KIẾM KHÁCH HÀNG (MỚI) ---

      // Hàm bật/tắt chế độ nhập khoảng (Giống file search.ejs)
      window.toggleRange = function (groupId, value) {
        const group = document.getElementById(groupId);
        if (value === "between") {
          group.classList.add("mode-range");
        } else {
          group.classList.remove("mode-range");
        }
      };

      // Xử lý sự kiện Submit Form Tìm kiếm
      const searchForm = document.getElementById("customer-search-form");
      const btnResetSearch = document.getElementById("btn-reset-search");

      if (searchForm) {
        // Xử lý nút LÀM MỚI
        if (btnResetSearch) {
          btnResetSearch.addEventListener("click", () => {
            searchForm.reset();
            // Reset về mặc định: Ẩn input khoảng
            document
              .getElementById("group-tong-no")
              .classList.remove("mode-range");
            // Gọi lại sự kiện submit để hiện lại toàn bộ bảng
            searchForm.dispatchEvent(new Event("submit"));
          });
        }

        searchForm.addEventListener("submit", function (event) {
          event.preventDefault();
          showLoader(); // Hiển thị loader giả lập cho mượt

          setTimeout(() => {
            // 1. Lấy giá trị input
            const hoTenQuery = document
              .getElementById("search-ho-ten")
              .value.toLowerCase();
            const sdtQuery = document
              .getElementById("search-sdt")
              .value.toLowerCase();
            const diaChiQuery = document
              .getElementById("search-dia-chi")
              .value.toLowerCase();

            // Lấy logic tổng nợ
            const opTongNo = document.getElementById("op-tong-no").value;
            const valFrom = parseFloat(
              document.getElementById("search-tong-no-from").value
            );
            const valTo = parseFloat(
              document.getElementById("search-tong-no-to").value
            );

            // 2. Lấy các hàng trong bảng (Loại bỏ hàng thông báo lỗi nếu có)
            const tableBody = document.querySelector("#customer-table tbody");
            const rows = Array.from(
              tableBody.querySelectorAll("tr:not(.no-results-row)")
            );

            let resultsFound = 0;

            rows.forEach((row) => {
              // Cấu trúc cột trong customers.ejs:
              // 0: STT | 1: Mã | 2: Tên | 3: NS | 4: SĐT | 5: GT | 6: ĐC | 7: Nợ | 8: Action

              const hoTenCell = (
                row.cells[2]?.textContent || ""
              ).toLowerCase();
              const sdtCell = (row.cells[4]?.textContent || "").toLowerCase();
              const diaChiCell = (
                row.cells[6]?.textContent || ""
              ).toLowerCase();

              // Xử lý tiền: Loại bỏ dấu chấm/phẩy trong chuỗi "1.000.000" để thành số 1000000
              const rawDebt = row.cells[7]?.textContent || "0";
              const tongNoCell =
                parseFloat(rawDebt.replace(/\./g, "").replace(/,/g, "")) || 0;

              // 3. Kiểm tra điều kiện match
              const hoTenMatch = hoTenCell.includes(hoTenQuery);
              const sdtMatch = sdtCell.includes(sdtQuery);
              const diaChiMatch = diaChiCell.includes(diaChiQuery);
              let tongNoMatch = true;

              // Logic so sánh số (Tổng nợ)
              if (!isNaN(valFrom)) {
                switch (opTongNo) {
                  case "=":
                    tongNoMatch = tongNoCell === valFrom;
                    break;
                  case ">":
                    tongNoMatch = tongNoCell > valFrom;
                    break;
                  case ">=":
                    tongNoMatch = tongNoCell >= valFrom;
                    break;
                  case "<":
                    tongNoMatch = tongNoCell < valFrom;
                    break;
                  case "<=":
                    tongNoMatch = tongNoCell <= valFrom;
                    break;
                  case "between":
                    if (!isNaN(valTo)) {
                      tongNoMatch =
                        tongNoCell >= valFrom && tongNoCell <= valTo;
                    } else {
                      tongNoMatch = tongNoCell >= valFrom;
                    }
                    break;
                }
              }

              // 4. Ẩn/Hiện hàng
              if (hoTenMatch && sdtMatch && diaChiMatch && tongNoMatch) {
                row.style.display = "";
                resultsFound++;
                // Cập nhật lại STT (cột 0) cho đẹp mắt
                row.cells[0].textContent = resultsFound;
              } else {
                row.style.display = "none";
              }
            });

            // 5. Xử lý khi không tìm thấy kết quả
            const existingNoResults =
              tableBody.querySelector(".no-results-row");
            if (existingNoResults) existingNoResults.remove();

            if (resultsFound === 0) {
              const noResultsRow = tableBody.insertRow();
              noResultsRow.classList.add("no-results-row");
              // Colspan = 9 vì bảng có 9 cột
              noResultsRow.innerHTML = `<td colspan="9" style="text-align: center;">Không tìm thấy khách hàng nào phù hợp tiêu chí.</td>`;
            }

            hideLoader();
            showToast(`Tìm thấy ${resultsFound} khách hàng.`, "success");
          }, 300); // Delay nhỏ để tạo hiệu ứng
        });
      }

      // --- LOGOUT ---
      const logoutBtn = document.getElementById("logout-button");
      if (logoutBtn) {
        logoutBtn.addEventListener("click", async (e) => {
          e.preventDefault();
          if (confirm("Bạn có chắc chắn muốn đăng xuất?")) {
            window.location.href = "/logout";
          }
        });
      }
    });
  </script>
