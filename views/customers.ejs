        }

        // E. Xử lý Submit Form Sửa
        if (editForm) {
          editForm.addEventListener("submit", async (e) => {
            e.preventDefault();
            if (!currentEditingRow) return;

            const maKH = currentEditingRow.dataset.id;
            const data = {
              hoTen: document.getElementById("edit-ho-ten-kh").value,
              ngaySinh:
                document.getElementById("edit-ngay-sinh-kh").value || null,
              gioiTinh: document.getElementById("edit-gioi-tinh-kh").value,
              soDienThoai: document.getElementById("edit-sdt-kh").value,
              diaChi: document.getElementById("edit-dia-chi-kh").value,
            };

            // Validate số điện thoại phải đủ 10 số
