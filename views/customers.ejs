              )
            ) {
              //   editForm.requestSubmit(); // Submit form
              // } else {
              restoreFormData(editForm, originalFormData); // Reset form về gốc
              showToast("Đã khôi phục dữ liệu ban đầu!", "success");
            }
          });
        }

        // D. Xử lý nút XÓA (Icon thùng rác ở bảng) và nút CHỈNH SỬA
        if (table) {
          table.addEventListener("click", async (e) => {
            // Bắt sự kiện click vào icon xóa
            if (
              e.target.classList.contains("delete-icon") ||
              e.target.closest(".delete-icon")
            ) {
              const row = e.target.closest("tr");
              const itemName = row.cells[2].textContent.trim(); // Lấy tên KH (cột 3)
              const maKH = row.getAttribute("data-id"); // Lấy mã KH từ thuộc tính data-id
              if (
