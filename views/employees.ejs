    <script>
        document.addEventListener('DOMContentLoaded', function() {
            
            // --- 1. CÁC HÀM TIỆN ÍCH (LOADER, TOAST, FETCH DATA) ---
            const loader = document.getElementById('loader');
            const toastContainer = document.getElementById('toast-container');
            let currentEditingRow = null; 
    
            function showLoader() { loader.style.display = 'flex'; }
            function hideLoader() { loader.style.display = 'none'; }
            
            function showToast(message, type = 'success') {
                const toast = document.createElement('div');
                toast.classList.add('toast', type);
                toast.innerHTML = `<i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} toast-icon"></i><span class="toast-message">${message}</span>`;
                toastContainer.appendChild(toast);
                setTimeout(() => { toast.classList.add('show'); }, 100);
                setTimeout(() => {
                    toast.classList.remove('show');
                    toast.addEventListener('transitionend', () => {
                        if (toast.parentNode) { toast.parentNode.removeChild(toast); }
                    });
                }, 3000);
            }
    
            function simulateApiCall(callback) {
                showLoader();
                setTimeout(() => {
                    hideLoader();
                    const success = Math.random() > 0.1; // 90% thành công
                    callback(success); 
                }, 1000); 
            }

            async function fetchEmployees() {
                try {
                    const response = await fetch('/api/employees/getEmployees'); // Đổi lại đường dẫn API của bạn nếu khác
                    if (!response.ok) throw new Error('Không thể tải dữ liệu');
                    
                    const employees = await response.json();
                    const tbody = document.querySelector('#employee-table tbody');
                    tbody.innerHTML = ''; // Xóa sạch dữ liệu cũ

                    if (employees && employees.length > 0) {
                        employees.forEach((employee, index) => {
                            const options = { year: 'numeric', month: '2-digit', day: '2-digit' };
                            
                            // Xử lý ngày tháng (để hiện dd/mm/yyyy)
                            const formattedNgaySinh = employee.NgaySinh ? new Date(employee.NgaySinh).toLocaleDateString('en-US', options) : '';
                            const formattedNgayNhanViec = employee.NgayNhanViec ? new Date(employee.NgayNhanViec).toLocaleDateString('en-US', options) : '';
                            
                            // Xử lý ngày chuẩn (để lưu vào dataset cho nút Sửa)
                            const rawNgaySinh = employee.NgaySinh ? new Date(employee.NgaySinh).toISOString().split('T')[0] : '';
                            const rawNgayNhanViec = employee.NgayNhanViec ? new Date(employee.NgayNhanViec).toISOString().split('T')[0] : '';

                            const tr = document.createElement('tr');
                            tr.dataset.id = employee.MaNhanVien;
                            tr.dataset.ngaySinh = rawNgaySinh;
                            tr.dataset.ngayNhanViec = rawNgayNhanViec;

                            // Nút Sửa/Xóa chỉ hiện nếu không phải admin (giống logic EJS của bạn)
                            let actionButtons = '';
                            if (employee.Username !== 'admin') {
                                actionButtons = `
                                    <i class="fas fa-pencil-alt action-icon open-edit-modal"></i>
                                    <i class="fas fa-trash action-icon delete-icon" style="margin-left: 12px; color: var(--red-accent);"></i>
                                `;
                            }

                            tr.innerHTML = `
                                <td>${index + 1}</td>
                                <td>${employee.MaNhanVien}</td>
                                <td>${employee.HoTen}</td>
                                <td>${formattedNgaySinh}</td>
                                <td>${employee.SoDienThoai}</td>
                                <td>${employee.ChucVu}</td>
                                <td>${employee.Username}</td>
                                <td>******</td>
                                <td>${formattedNgayNhanViec}</td>
                                <td>${actionButtons}</td>
                            `;
                            tbody.appendChild(tr);
                        });
                    } else {
                        tbody.innerHTML = '<tr><td colspan="10" style="text-align: center;">Không có người dùng nào.</td></tr>';
                    }
                } catch (error) {
                    console.error("Lỗi tải người dùng:", error);
                    // showToast('Lỗi tải danh sách người dùng', 'error');
                }
            }
    
            // --- 2. XỬ LÝ SIDEBAR & RESPONSIVE ---
            const menuToggle = document.getElementById('menu-toggle');
            const sidebar = document.getElementById('sidebar');
            const container = document.querySelector('.dashboard-container'); 
    
            if (menuToggle && sidebar && container) {
                menuToggle.addEventListener('click', function() {
                    if (window.innerWidth <= 992) { sidebar.classList.toggle('active'); } 
                    else { container.classList.toggle('sidebar-collapsed'); }
                });
            }
    
            // --- 3. HÀM LOGIC CỐT LÕI (SMART MODAL) ---
            
            // Hàm lấy dữ liệu từ Form (snapshot)
            function getFormData(form) {
                const data = {};
                const inputs = form.querySelectorAll('input, select, textarea');
                inputs.forEach(input => {
                    if(input.type !== 'submit' && input.type !== 'button') {
                        data[input.id] = input.value;
                    }
                });
                return data;
            }
    
            // Hàm khôi phục dữ liệu Form
            function restoreFormData(form, data) {
                for (const [key, value] of Object.entries(data)) {
                    const input = form.querySelector(`#${key}`);
                    if (input) input.value = value;
                }
            }
    
            // Hàm Setup Modal Thông minh (Dùng chung cho Sửa/Xóa/Reset)
            function setupSmartModal(config) {
                const addBtn = document.getElementById(config.addBtnId);
                const addModal = document.getElementById(config.addModalId);
                
                const editModal = document.getElementById(config.editModalId);
                const editForm = document.getElementById(config.formId);
                const editBtns = document.querySelectorAll(config.editBtnClass);
                
                const resetBtn = document.getElementById(config.resetBtnId);
                const table = document.querySelector(config.tableSelector);
                
                let originalFormData = {}; // Biến lưu snapshot dữ liệu gốc
    
                // A. Mở Modal Thêm mới
                if (addBtn && addModal) {
                    addBtn.addEventListener('click', () => {
                        if(config.addFormId) {
                            document.getElementById(config.addFormId).reset();
                        }
                        addModal.style.display = 'flex';
                    });
                }
    
                // // B. Mở Modal Sửa (Điền dữ liệu & Lưu snapshot)
                // if (editBtns.length > 0 && editModal) {
                //     editBtns.forEach(btn => {
                //         btn.addEventListener('click', (e) => {
                //             currentEditingRow = e.target.closest('tr');
                //             if(!currentEditingRow) return;
    
                //             // --- LOGIC ĐIỀN DỮ LIỆU VÀO FORM (MAPPING) ---
                //             // Lưu ý: Cần mapping đúng thứ tự cột trong bảng của bạn
                //             const cells = currentEditingRow.cells;
                //             document.getElementById('edit-ho-ten').value = cells[2].textContent;
                //             // Giả lập ngày sinh (do format hiển thị khác value input)
                //             document.getElementById('edit-ngay-sinh').value = currentEditingRow.dataset.ngaySinh;
                //             document.getElementById('edit-sdt').value = cells[4].textContent;
                //             document.getElementById('edit-chuc-vu').value = cells[5].textContent; // Value option phải khớp text
                //             document.getElementById('edit-username').value = cells[6].textContent;
                //             document.getElementById('edit-ngay-nhan-viec').value = currentEditingRow.dataset.ngayNhanViec;
                //             document.getElementById('edit-password').value = ''; // Reset mật khẩu
    
                //             // SAU KHI điền xong, lưu lại trạng thái gốc ngay lập tức
                //             setTimeout(() => {
                //                  if(editForm) originalFormData = getFormData(editForm);
                //             }, 50); 
                            
                //             editModal.style.display = 'flex';
                //         });
                //     });
                // }
    
                // C. Xử lý nút ĐẶT LẠI (Thông minh)
                if (resetBtn && editForm) {
                    resetBtn.addEventListener('click', () => {
                        const currentData = getFormData(editForm);
                        // So sánh dữ liệu hiện tại với bản gốc
                        const isChanged = JSON.stringify(currentData) !== JSON.stringify(originalFormData);
    
                        if (!isChanged) {
                            showToast('Chưa có thay đổi nào để đặt lại!', 'error');
                            return;
                        }
    
                        if (confirm("Dữ liệu đã thay đổi. Bạn có muốn LƯU LẠI không?\n\n- OK: Lưu thay đổi.\n- Cancel: Khôi phục lại dữ liệu gốc.")) {
                            editForm.requestSubmit(); // Submit form
                        } else {
                            restoreFormData(editForm, originalFormData); // Reset form
                            showToast('Đã khôi phục dữ liệu gốc!', 'success');
                        }
                    });
                }
    
                // D. Xử lý nút XÓA (Icon thùng rác ở bảng) và nút CHỈNH SỬA
                if (table) {
                    table.addEventListener('click', async (e) => {
                        // Bắt sự kiện click vào icon xóa hoặc nút chứa icon xóa
                        if (e.target.classList.contains('delete-icon') || e.target.closest('.delete-icon')) {
                            const row = e.target.closest('tr');
                            const itemName = row.cells[2].textContent; // Lấy tên người dùng (cột 3)
                            const maNV = row.cells[1].textContent; // Lấy mã người dùng (cột 2)
                            
                            if (confirm(`Bạn có chắc chắn muốn XÓA người dùng: ${itemName}?`)) {
                                showLoader();
                                try {
                                    console.log('Xóa người dùng:', row);
                                    // --- SỬA: GỌI API 'delete' ---
                                    const response = await fetch(`/api/employees/deleteEmployee/${maNV}`, {
                                        method: 'DELETE'
                                    });
                                    const result = await response.json();
                                    hideLoader();
                                    console.log('Kết quả xóa:', result);
                                    
                                    if(response.ok) {
                                        row.remove();
                                        showToast('Xóa người dùng thành công!', 'success');
                                        const tableBody = document.getElementById('employee-table').getElementsByTagName('tbody')[0];
                                        if (tableBody.rows.length === 0) {
                                            // Nếu <tbody> không còn hàng nào
                                            const newRow = tableBody.insertRow(); // Thêm 1 hàng mới
                                            // Thêm ô "Không có người dùng nào"
                                            newRow.innerHTML = `<td colspan="10" style="text-align: center;">Không có người dùng nào.</td>`;
                                        }
                                    } else {
                                        showToast(`Xóa thất bại: ${result.error}`, 'error');
                                    }
                                } catch (err) {
                                    hideLoader();
                                    console.log('Lỗi delete employee:', err);
                                    showToast('Lỗi kết nối máy chủ.', 'error');
                                }
                            }
                        }

                        if (e.target.classList.contains('open-edit-modal') || e.target.closest('.open-edit-modal')) {
                            const btn  = e.target.closest('.open-edit-modal');
                            currentEditingRow = btn.closest('tr');
                            if(!currentEditingRow) return;
                            
                            // --- LOGIC ĐIỀN DỮ LIỆU VÀO FORM (MAPPING) ---
                            // Lưu ý: Cần mapping đúng thứ tự cột trong bảng của bạn
                            const cells = currentEditingRow.cells;
                            document.getElementById('edit-ho-ten').value = cells[2].textContent;
                            // Giả lập ngày sinh (do format hiển thị khác value input)
                            document.getElementById('edit-ngay-sinh').value = currentEditingRow.dataset.ngaySinh;
                            document.getElementById('edit-sdt').value = cells[4].textContent;
                            document.getElementById('edit-chuc-vu').value = cells[5].textContent; // Value option phải khớp text
                            document.getElementById('edit-username').value = cells[6].textContent;
                            document.getElementById('edit-ngay-nhan-viec').value = currentEditingRow.dataset.ngayNhanViec;
                            document.getElementById('edit-password').value = ''; // Reset mật khẩu
    
                            // SAU KHI điền xong, lưu lại trạng thái gốc ngay lập tức
                            setTimeout(() => {
                                 if(editForm) originalFormData = getFormData(editForm);
                            }, 50); 
                            
                            editModal.style.display = 'flex';

                        }
                    });
                }
    
                // E. Xử lý Submit Form Sửa
                if (editForm) {
                    editForm.addEventListener('submit', async (e) => {
                        e.preventDefault();
                        if (!currentEditingRow) return;

                    const maNV = currentEditingRow.dataset.id;
                    const data = {
                        hoTen: document.getElementById('edit-ho-ten').value,
                        ngaySinh: document.getElementById('edit-ngay-sinh').value,
                        soDienThoai: document.getElementById('edit-sdt').value,
                        chucVu: document.getElementById('edit-chuc-vu').value,
                        ngayNhanViec: document.getElementById('edit-ngay-nhan-viec').value,
                        password: document.getElementById('edit-password').value // Gửi cả password (trống hoặc mới)
                    };

                    const ngaySinhInput = document.getElementById('edit-ngay-sinh').value;
                    const ngayNhanViecInput = document.getElementById('edit-ngay-nhan-viec').value;

                    if (!checkAgeRequirement(ngaySinhInput, ngayNhanViecInput)) {
                        showToast('Người dùng chưa đủ 18 tuổi tính đến ngày nhận việc!', 'error');
                        return; // Dừng lại, không gửi dữ liệu đi
                    }

                    showLoader();
                    try {
                        // --- GỌI API 'update' ---
                        const response = await fetch(`/api/employees/updateEmployee/${maNV}`, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        });
                        const result = await response.json();
                        hideLoader();

                        if (response.ok) {
                            showToast('Cập nhật thành công!', 'success');
                            editModal.style.display = 'none';
                            const options = { year: 'numeric', month: '2-digit', day: '2-digit' };
                            // Cập nhật hàng trong bảng
                            currentEditingRow.cells[2].textContent = result.user.HoTen;
                            currentEditingRow.cells[3].textContent = result.user.NgaySinh;
                            currentEditingRow.cells[4].textContent = result.user.SoDienThoai;
                            currentEditingRow.cells[5].textContent = result.user.ChucVu;
                            currentEditingRow.cells[8].textContent = result.user.NgayNhanViec;
                            //Cập nhật "bộ nhớ" data- attributes của hàng cho lần sửa tiếp theo
                            currentEditingRow.dataset.ngaySinh = new Date(result.user.NgaySinh).toISOString().split('T')[0];
                            currentEditingRow.dataset.ngayNhanViec = new Date(result.user.NgayNhanViec).toISOString().split('T')[0];
                            currentEditingRow = null;
                        } else {
                            restoreFormData(editForm, originalFormData); // Reset form
                            showToast('Đã khôi phục dữ liệu gốc!', 'success');
                        }
                    } catch (err) {
                        hideLoader();
                        showToast('Lỗi kết nối máy chủ.', 'error');
                    }
                    });
                }
            }
    
            // --- 4. GỌI HÀM SETUP CHO NGƯỜI DÙNG ---
            setupSmartModal({
                addBtnId: 'open-add-modal',
                addModalId: 'add-modal',
                addFormId: 'add-employee-form',
                editModalId: 'edit-modal',
                formId: 'edit-employee-form',
                editBtnClass: '.open-edit-modal',
                resetBtnId: 'btn-reset-edit',      // ID nút Đặt lại
                tableSelector: '#employee-table',  // ID bảng người dùng
                typeName: 'Người dùng'
            });
    
    
            // --- 5. XỬ LÝ NÚT "THÊM MỚI" (CUSTOM RESET) Ở MODAL THÊM ---
            // Logic mới: Nút này dùng để "Làm mới" form.
            // - Nếu có dữ liệu: Hỏi Lưu hay Xóa trắng. Chọn Không -> Xóa trắng form (giữ modal).
            // - Nếu không có dữ liệu: Xóa trắng form (giữ modal).
            
            const btnCustomReset = document.getElementById('btn-custom-reset');
            const addEmployeeForm = document.getElementById('add-employee-form');
            // const addModal = document.getElementById('add-modal'); // Không cần biến này ở đây nữa vì không đóng
            let isSaveAndReset = false;
            if (btnCustomReset && addEmployeeForm) {
                btnCustomReset.addEventListener('click', () => {
                    // Kiểm tra xem form có dữ liệu không (check tên người dùng)
                    const hasData = document.getElementById('add-ho-ten').value.trim() !== '';

                    if (hasData) {
                        // Nếu có dữ liệu -> Hỏi
                        if (confirm('Bạn đã nhập thông tin. Bạn có muốn LƯU Người dùng này trước khi làm mới không?\n\n- OK: Lưu người dùng này.\n- Cancel: Xóa trắng để nhập người dùng khác.')) {
                            // Chọn OK -> Lưu
                            if (addEmployeeForm.checkValidity()) {
                                isSaveAndReset = true;
                                addEmployeeForm.requestSubmit(); 
                            } else {
                                addEmployeeForm.reportValidity();
                            }
                        } else {
                            // Chọn Cancel -> Chỉ Reset form, KHÔNG ĐÓNG modal
                            addEmployeeForm.reset();
                            showToast('Đã làm mới form!', 'info');
                        }
                    } else {
                        // Nếu chưa nhập gì -> Chỉ Reset cho chắc chắn
                        addEmployeeForm.reset();
                        showToast('Form đã được làm mới.', 'info');
                    }
                });

                // Xử lý sự kiện Submit Form (Giữ nguyên)
                addEmployeeForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    
                    const data = {
                        hoTen: document.getElementById('add-ho-ten').value,
                        ngaySinh: document.getElementById('add-ngay-sinh').value,
                        soDienThoai: document.getElementById('add-sdt').value,
                        chucVu: document.getElementById('add-chuc-vu').value,
                        username: document.getElementById('add-username').value,
                        password: document.getElementById('add-password').value,
                        ngayNhanViec: document.getElementById('add-ngay-nhan-viec').value,
                    };

                    const ngaySinhInput = document.getElementById('add-ngay-sinh').value;
                    const ngayNhanViecInput = document.getElementById('add-ngay-nhan-viec').value;

                    if (!checkAgeRequirement(ngaySinhInput, ngayNhanViecInput)) {
                        showToast('Nhân viên chưa đủ 18 tuổi tính đến ngày nhận việc!', 'error');
                        isSaveAndReset = false;
                        return; // Dừng lại, không gửi dữ liệu đi
                    }
                    showLoader();
                    try {
                        // --- SỬA: GỌI API 'register' ---
                        const response = await fetch('/api/employees/registerEmployee', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        });

                        const result = await response.json();
                        hideLoader();

                        if (response.ok) {
                            await showToast('Thêm người dùng thành công!', 'success');

                            if (isSaveAndReset) {
                                // Trường hợp 1: Từ nút "Thêm mới" (Lưu -> Reset form -> Không đóng)
                                addEmployeeForm.reset(); 
                                showToast('Đã sẵn sàng nhập người dùng tiếp theo.', 'info');
                                
                                // Reset cờ về false sau khi xong việc
                                isSaveAndReset = false; 
                            } else {
                                // Trường hợp 2: Submit thường (Lưu -> Đóng form)
                                document.getElementById('add-modal').style.display = 'none';
                                addEmployeeForm.reset(); // Reset luôn cho sạch
                            } 
                            fetchEmployees(); // tải lại danh sách người dùng
                        } else {
                            showToast(`Thêm thất bại: ${result.error}`, 'error');
                        }
                    } catch (err) {
                        hideLoader();
                        console.log("[register employee] error:", err);
                        showToast('Lỗi kết nối máy chủ.', 'error');
                    }
                });
            }
    
    
            // --- 6. CÁC TIỆN ÍCH KHÁC (Close modal, Password toggle) ---
            
            // Đóng modal chung
            const closeModalBtns = document.querySelectorAll('.close-modal');
            closeModalBtns.forEach(btn => {
                btn.addEventListener('click', (e) => { e.target.closest('.modal-overlay').style.display = 'none'; });
            });
            window.addEventListener('click', (e) => {
                if (e.target.classList.contains('modal-overlay')) e.target.style.display = 'none';
            });
    
            // Ẩn hiện mật khẩu
            const togglePasswordBtns = document.querySelectorAll('.toggle-password');
            togglePasswordBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    const input = this.closest('.password-wrapper').querySelector('input'); 
                    const icon = this.querySelector('i');
                    if (input.type === 'password') {
                        input.type = 'text';
                        icon.classList.remove('fa-eye-slash'); icon.classList.add('fa-eye');
                    } else {
                        input.type = 'password';
                        icon.classList.remove('fa-eye'); icon.classList.add('fa-eye-slash');
                    }
                });
            });

            // --- 7. VALIDATE DỮ LIỆU ĐẦU VÀO (MỚI THÊM) ---
            
            function setupInputValidation() {
                // 1. Validate HỌ TÊN: Fix lỗi gõ tiếng Việt
                const nameInputs = [document.getElementById('add-ho-ten'), document.getElementById('edit-ho-ten')];
                
                nameInputs.forEach(input => {
                    if (input) {
                        // Cờ đánh dấu: Người dùng có đang gõ tổ hợp phím tiếng Việt không?
                        let isComposing = false;

                        // Khi bắt đầu gõ tổ hợp (ví dụ gõ chữ 'a' đầu tiên của 'â')
                        input.addEventListener('compositionstart', () => {
                            isComposing = true;
                        });

                        // Khi kết thúc tổ hợp (ví dụ đã hiện ra chữ 'â')
                        input.addEventListener('compositionend', () => {
                            isComposing = false;
                            // Gọi validate ngay khi gõ xong chữ tiếng Việt
                            validateName(input);
                        });

                        // Sự kiện nhập liệu thông thường
                        input.addEventListener('input', function() {
                            // Nếu đang gõ dở tiếng Việt thì KHÔNG can thiệp
                            if (isComposing) return;
                            
                            validateName(this);
                        });
                    }
                });

                // Hàm xử lý chung cho Họ tên
                function validateName(el) {
                    // Regex: /[^\p{L}\s]/gu
                    // \p{L}: Bất kỳ ký tự chữ cái nào (Unicode Letter) -> Bao gồm cả Tiếng Việt, Tiếng Anh, v.v.
                    // \s: Khoảng trắng
                    // ^: Phủ định (Không phải chữ và không phải khoảng trắng thì xóa)
                    // u: Cờ unicode
                    
                    const validValue = el.value.replace(/[^\p{L}\s]/gu, '');
                    
                    // Chỉ cập nhật lại nếu giá trị thực sự thay đổi (để tránh nhảy con trỏ chuột không cần thiết)
                    if (el.value !== validValue) {
                        el.value = validValue;
                    }
                }

                // 2. Validate SỐ ĐIỆN THOẠI (Giữ nguyên)
                const phoneInputs = [document.getElementById('add-sdt'), document.getElementById('edit-sdt')];
                phoneInputs.forEach(input => {
                    if (input) {
                        input.addEventListener('input', function() {
                            this.value = this.value.replace(/[^0-9]/g, '');
                            if (this.value.length > 10) this.value = this.value.slice(0, 10);
                        });
                    }
                });

                // 3. Validate USERNAME (Giữ nguyên)
                const usernameInputs = [document.getElementById('add-username'), document.getElementById('edit-username')];
                usernameInputs.forEach(input => {
                    if (input) {
                        input.addEventListener('input', function() {
                            this.value = this.value.replace(/[^a-zA-Z0-9]/g, '');
                        });
                    }
                });
            }

            // Gọi hàm khởi tạo validation
            setupInputValidation();

            // --- 8. HÀM KIỂM TRA ĐỦ 18 TUỔI (MỚI) ---
            function checkAgeRequirement(ngaySinhStr, ngayNhanViecStr) {
                if (!ngaySinhStr || !ngayNhanViecStr) return true; // Để validator của HTML lo nếu rỗng

                const ngaySinh = new Date(ngaySinhStr);
                const ngayNhanViec = new Date(ngayNhanViecStr);

                // Tính ngày sinh nhật thứ 18
                const sinhNhatThu18 = new Date(ngaySinh);
                sinhNhatThu18.setFullYear(ngaySinh.getFullYear() + 18);

                // So sánh: Nếu ngày vào làm < ngày sinh nhật thứ 18 -> Chưa đủ tuổi
                // setHours(0,0,0,0) để chỉ so sánh ngày, bỏ qua giờ giấc
                ngayNhanViec.setHours(0,0,0,0);
                sinhNhatThu18.setHours(0,0,0,0);

                if (ngayNhanViec < sinhNhatThu18) {
                    return false;
                }
                return true;
            }

            // --- LOGOUT ---
    const logoutBtn = document.getElementById('logout-button');
    if(logoutBtn) {
        logoutBtn.addEventListener('click', async (e) => {
            e.preventDefault();
            if(confirm('Bạn có chắc chắn muốn đăng xuất?')) {
                window.location.href = '/logout';
            }
        });
    }
    
        });
    </script>

