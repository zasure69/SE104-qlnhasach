        <main class="main-content">

            <header class="top-bar">
                <div class="top-bar-left"> <button class="menu-toggle" id="menu-toggle"> <i class="fas fa-bars"></i>
                    </button>
                    <h1>Danh sách Khuyến mãi</h1>
                </div>
                <div class="user-menu"> Chào, Admin <i class="fas fa-chevron-down"></i> </div>
            </header>

            <div class="content-wrapper">
                <div class="content-header">
                    <h2>Khuyến mãi</h2> <button class="btn btn-primary btn-add-new" id="open-add-modal"> <i
                            class="fas fa-plus"></i> Thêm mới KM </button>
                </div>
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Mã KM</th>
                                <th>Tên KM</th>
                                <th>Giá trị KM</th>
                                <th>Điều kiện tối thiểu HĐ</th>
                                <th>Ngày bắt đầu</th>
                                <th>Ngày kết thúc</th>
                                <th>Đối tượng áp dụng</th>
                                <th>Trạng thái</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1</td>
                                <td>ABC123</td>
                                <td>HAPPY</td>
                                <td>10%</td>
                                <td>1000000</td>
                                <td>10/10/2025</td>
                                <td>30/10/2025</td>
                                <td>Truyện ngắn</td>
                                <td>Đang hoạt động</td>
                                <td> <i class="fas fa-pencil-alt action-icon open-edit-modal"></i> </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- --- MODAL THÊM MỚI KHUYẾN MÃI --- -->
    <div class="modal-overlay" id="add-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Thêm mới thông tin Khuyến mãi</h2> <button class="close-modal"><i class="fas fa-times"></i></button>
            </div>
            <form id="add-km-form">
                <div class="modal-body">
                    <div class="modal-form-grid">
                        <div class="form-group"> <label for="add-ma-km">Mã KM</label> <input type="text" id="add-ma-km"
                                value="ABC124" readonly> </div>
                        <div class="form-group"> <label for="add-ten-km">Tên KM</label> <input type="text"
                                id="add-ten-km" placeholder="HAPPY"> </div>
                        <div class="form-group"> <label for="add-gia-tri-km">Giá trị KM (%)</label> <input type="number"
                                id="add-gia-tri-km" placeholder="10"> </div>
                        <div class="form-group"> <label for="add-dieu-kien-hd">Giá trị tối thiểu của HĐ</label> <input
                                type="number" id="add-dieu-kien-hd" placeholder="1000000"> </div>
                        <div class="form-group"> <label for="add-ngay-bat-dau">Ngày bắt đầu</label>
                            <div class="date-input-wrapper"> <input type="date" id="add-ngay-bat-dau"
                                    value="1999-01-01"></div>
                        </div>
                        <div class="form-group"> <label for="add-ngay-ket-thuc">Ngày kết thúc</label>
                            <div class="date-input-wrapper"> <input type="date" id="add-ngay-ket-thuc"
                                    value="1999-01-01"></div>
                        </div>

                        <div class="target-group">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label for="add-doi-tuong">Đối tượng áp dụng</label>
                                <!-- SỬA: Thêm wrapper -->
                                <div class="select-wrapper">
                                    <select id="add-doi-tuong">
                                        <option value="all">Tất cả</option>
                                        <option value="category">Thể loại sách cụ thể</option>
                                        <option value="book">Mã sách cụ thể</option>
                                    </select>
                                    <i class="fas fa-chevron-down dropdown-icon"></i> <!-- Thêm icon -->
                                </div>
                            </div>
                            <div class="target-details-wrapper" id="add-target-details-wrapper">
                                <input type="text" class="target-details-input" id="add-target-details-input"
                                    placeholder="Chọn chi tiết" readonly>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer"> <button type="button" class="btn btn-secondary close-modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Lưu</button> </div>
            </form>
        </div>
    </div>

    <!-- --- MODAL SỬA KHUYẾN MÃI --- -->
    <div class="modal-overlay" id="edit-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Sửa thông tin Khuyến mãi</h2> <button class="close-modal"><i class="fas fa-times"></i></button>
            </div>
            <form id="edit-km-form">
                <div class="modal-body">
                    <div class="modal-form-grid">
                        <div class="form-group"> <label for="edit-ma-km">Mã KM</label> <input type="text"
                                id="edit-ma-km" value="ABC124" readonly> </div>
                        <div class="form-group"> <label for="edit-ten-km">Tên KM</label> <input type="text"
                                id="edit-ten-km" value="HAPPY"> </div>
                        <div class="form-group"> <label for="edit-gia-tri-km">Giá trị KM (%)</label> <input
                                type="number" id="edit-gia-tri-km" value="10"> </div>
                        <div class="form-group"> <label for="edit-dieu-kien-hd">Giá trị tối thiểu của HĐ</label> <input
                                type="number" id="edit-dieu-kien-hd" value="1000000"> </div>
                        <div class="form-group"> <label for="edit-ngay-bat-dau">Ngày bắt đầu</label>
                            <div class="date-input-wrapper"> <input type="date" id="edit-ngay-bat-dau"
                                    value="1999-01-01"></div>
                        </div>
                        <div class="form-group"> <label for="edit-ngay-ket-thuc">Ngày kết thúc</label>
                            <div class="date-input-wrapper"> <input type="date" id="edit-ngay-ket-thuc"
                                    value="1999-01-01"></div>
                        </div>

                        <div class="target-group">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label for="edit-doi-tuong">Đối tượng áp dụng</label>
                                <!-- SỬA: Thêm wrapper -->
                                <div class="select-wrapper">
                                    <select id="edit-doi-tuong">
                                        <option value="all">Tất cả</option>
                                        <option value="category">Thể loại sách cụ thể</option>
                                        <option value="book">Mã sách cụ thể</option>
                                    </select>
                                    <i class="fas fa-chevron-down dropdown-icon"></i> <!-- Thêm icon -->
                                </div>
                            </div>
                            <div class="target-details-wrapper" id="edit-target-details-wrapper">
                                <input type="text" class="target-details-input" id="edit-target-details-input"
                                    placeholder="Chọn chi tiết" readonly>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger">Xóa khuyến mãi</button>
                    <div> <button type="button" class="btn btn-secondary close-modal">Hủy</button> <button type="submit"
                            class="btn btn-primary">Lưu</button> </div>
                </div>
            </form>
        </div>
    </div>

    <!-- --- MODAL CHI TIẾT (Chọn Thể loại/Mã sách) --- -->
    <div class="modal-overlay" id="details-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="details-modal-title">Chọn chi tiết</h2> <button class="close-modal"
                    data-target-modal="details-modal"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body">
                <div class="checklist-container" id="details-checklist"></div>
            </div>
            <div class="modal-footer"> <button type="button" class="btn btn-secondary close-modal"
                    data-target-modal="details-modal">Hủy</button> <button type="button" class="btn btn-primary"
                    id="confirm-details">Xác nhận</button> </div>
        </div>
    </div>

    <script>
        // --- Giữ nguyên JavaScript ---
        document.addEventListener('DOMContentLoaded', function () {
            let addModalSelectedDetails = "";
            let editModalSelectedDetails = "";
            let currentEditingRowData = null;

            const menuToggle = document.getElementById('menu-toggle');
            const sidebar = document.getElementById('sidebar');
            const container = document.querySelector('.dashboard-container');
            if (menuToggle && sidebar && container) {
                menuToggle.addEventListener('click', function () {
                    if (window.innerWidth <= 992) { sidebar.classList.toggle('active'); }
                    else { container.classList.toggle('sidebar-collapsed'); }
                });
            }

            const addModal = document.getElementById('add-modal');
            const editModal = document.getElementById('edit-modal');
            const openAddModalBtn = document.getElementById('open-add-modal');
            const openEditModalBtns = document.querySelectorAll('.open-edit-modal');
            const mainCloseModalBtns = document.querySelectorAll('#add-modal .close-modal, #edit-modal .close-modal');

            if (openAddModalBtn && addModal) {
                openAddModalBtn.addEventListener('click', () => {
                    document.getElementById('add-km-form').reset();
                    document.getElementById('add-target-details-input').value = addModalSelectedDetails;
                    const addTargetSelect = document.getElementById('add-doi-tuong');
                    const addDetailsWrapper = document.getElementById('add-target-details-wrapper');
                    if (addTargetSelect.value === 'category' || addTargetSelect.value === 'book') {
                        addDetailsWrapper.style.display = 'grid';
                        if (addModalSelectedDetails) {
                            document.getElementById('add-target-details-input').value = addModalSelectedDetails;
                        }
                    } else {
                        addDetailsWrapper.style.display = 'none';
                    }
                    addModal.style.display = 'flex';
                });
            }
            if (openEditModalBtns.length > 0 && editModal) {
                openEditModalBtns.forEach(btn => {
                    btn.addEventListener('click', (event) => {
                        const row = event.target.closest('tr');
                        currentEditingRowData = {
                            maKM: row.cells[1].textContent, tenKM: row.cells[2].textContent, giaTri: row.cells[3].textContent.replace('%', ''),
                            dieuKien: row.cells[4].textContent, ngayBD: '1999-01-01', ngayKT: '1999-01-01',
                            doiTuongValue: 'category', doiTuongText: row.cells[7].textContent
                        };
                        document.getElementById('edit-ma-km').value = currentEditingRowData.maKM;
                        document.getElementById('edit-ten-km').value = currentEditingRowData.tenKM;
                        document.getElementById('edit-gia-tri-km').value = currentEditingRowData.giaTri;
                        document.getElementById('edit-dieu-kien-hd').value = currentEditingRowData.dieuKien;
                        const editTargetSelect = document.getElementById('edit-doi-tuong');
                        const editDetailsWrapper = document.getElementById('edit-target-details-wrapper');
                        const editDetailsInput = document.getElementById('edit-target-details-input');
                        editModalSelectedDetails = editModalSelectedDetails || currentEditingRowData.doiTuongText;
                        editTargetSelect.value = currentEditingRowData.doiTuongValue;
                        if (editTargetSelect.value === 'category' || editTargetSelect.value === 'book') {
                            editDetailsWrapper.style.display = 'grid';
                            editDetailsInput.value = editModalSelectedDetails;
                        } else {
                            editDetailsWrapper.style.display = 'none';
                            editDetailsInput.value = '';
                        }
                        editModal.style.display = 'flex';
                    });
                });
            }
            mainCloseModalBtns.forEach(btn => {
                btn.addEventListener('click', (event) => {
                    const modal = event.target.closest('.modal-overlay');
                    if (modal.id === 'edit-modal') { editModalSelectedDetails = ""; currentEditingRowData = null; }
                    modal.style.display = 'none';
                });
            });
            window.addEventListener('click', function (event) {
                if (event.target.id === 'add-modal' || event.target.id === 'edit-modal') {
                    const modal = event.target;
                    if (modal.id === 'edit-modal') { editModalSelectedDetails = ""; currentEditingRowData = null; }
                    modal.style.display = 'none';
                }
            });

            const targetSelects = document.querySelectorAll('#add-doi-tuong, #edit-doi-tuong');
            targetSelects.forEach(select => {
                select.addEventListener('change', function () {
                    const detailsWrapper = this.closest('.target-group').querySelector('.target-details-wrapper');
                    const detailsInput = detailsWrapper.querySelector('.target-details-input');
                    if (this.value === 'category' || this.value === 'book') { detailsWrapper.style.display = 'grid'; }
                    else { detailsWrapper.style.display = 'none'; }
                    detailsInput.value = '';
                    if (this.id === 'add-doi-tuong') addModalSelectedDetails = "";
                    else if (this.id === 'edit-doi-tuong') editModalSelectedDetails = "";
                });
            });

            const detailsModal = document.getElementById('details-modal');
            const detailsChecklist = document.getElementById('details-checklist');
            const detailsModalTitle = document.getElementById('details-modal-title');
            const confirmDetailsBtn = document.getElementById('confirm-details');
            const detailsCloseBtns = document.querySelectorAll('#details-modal .close-modal');
            let currentTargetInput = null;
            let currentModalContext = null;

            document.querySelectorAll('.target-details-input').forEach(element => {
                element.addEventListener('click', function () {
                    const wrapper = this.closest('.target-details-wrapper');
                    const select = wrapper.closest('.target-group').querySelector('select');
                    currentTargetInput = this;
                    currentModalContext = this.closest('.modal-overlay').id;
                    const targetType = select.value;

                    let items = []; let modalTitle = "Chọn chi tiết";
                    if (targetType === 'category') {
                        modalTitle = "Chọn Thể loại sách";
                        items = [{ id: 'cat1', name: 'Tiểu thuyết' }, { id: 'cat2', name: 'Truyện ngắn' }, { id: 'cat3', name: 'Kinh dị' }, { id: 'cat4', name: 'Trinh thám' }, { id: 'cat5', name: 'Khoa học viễn tưởng' }];
                    } else if (targetType === 'book') {
                        modalTitle = "Chọn Mã sách";
                        items = [{ id: 'book1', name: 'BOOK001 - Mắt biếc' }, { id: 'book2', name: 'BOOK002 - Harry Potter' }, { id: 'book3', name: 'BOOK003 - Đắc nhân tâm' }, { id: 'book4', name: 'BOOK004 - Nhà giả kim' }];
                    }

                    detailsChecklist.innerHTML = '';
                    let currentSelectedValues = [];
                    if (currentModalContext === 'add-modal' && addModalSelectedDetails) { currentSelectedValues = addModalSelectedDetails.split(',').map(s => s.trim()).filter(Boolean); }
                    else if (currentModalContext === 'edit-modal' && editModalSelectedDetails) { currentSelectedValues = editModalSelectedDetails.split(',').map(s => s.trim()).filter(Boolean); }
                    else { currentSelectedValues = currentTargetInput.value.split(',').map(s => s.trim()).filter(Boolean); }

                    items.forEach(item => {
                        const isChecked = currentSelectedValues.includes(item.name);
                        detailsChecklist.innerHTML += ` <label> <input type="checkbox" value="${item.name}" data-id="${item.id}" ${isChecked ? 'checked' : ''}> ${item.name} </label> `;
                    });

                    detailsModalTitle.textContent = modalTitle;
                    detailsModal.style.display = 'flex';
                });
            });

            detailsCloseBtns.forEach(btn => { btn.addEventListener('click', () => { detailsModal.style.display = 'none'; }); });
            window.addEventListener('click', function (event) { if (event.target.id === 'details-modal') { detailsModal.style.display = 'none'; } });

            if (confirmDetailsBtn) {
                confirmDetailsBtn.addEventListener('click', function () {
                    if (currentTargetInput) {
                        const selectedItems = [];
                        detailsChecklist.querySelectorAll('input[type="checkbox"]:checked').forEach(checkbox => { selectedItems.push(checkbox.value); });
                        const selectedValueString = selectedItems.join(', ');
                        currentTargetInput.value = selectedValueString;
                        if (currentModalContext === 'add-modal') { addModalSelectedDetails = selectedValueString; }
                        else if (currentModalContext === 'edit-modal') { editModalSelectedDetails = selectedValueString; }
                    }
                    detailsModal.style.display = 'none';
                });
            }
        });
    </script>

</body>

</html>