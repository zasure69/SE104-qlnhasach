              row.innerHTML = `
                  <td class="stt-cell text-center">${index + 1}</td>
                  <td>${item.MaSach}</td>
                  <td class="name-cell">${tenSach}</td>
                  <td class="sl-hethong-cell text-center">${slHeThong}</td>
                  <td class="sl-thucte-cell text-center">${slThucTe}</td>
                  <td class="diff-cell text-center ${diffClass}" data-value="${chenhLech}">${chenhLech > 0 ? "+" : ""
                }${chenhLech}</td>
                  <td class="lydo-cell">${lyDoDisplay}</td>
                  <td class="text-center">
                    <i class="fas fa-pencil-alt action-icon edit-row-icon" style="color:var(--secondary-color);" title="Sửa dòng này"></i>
                    <i class="fas fa-trash action-icon delete-row-icon" 
                       onclick="deleteItemRow(this, 'edit-detail-table', 'edit-diff-count')"
                       style="color:var(--red-accent);" title="Xóa dòng này"></i>
                  </td>
                `;
            });
          }

          document.getElementById("edit-diff-count").textContent = diffCount;

          // Lưu trạng thái ban đầu để dùng cho nút "Đặt lại"
          setTimeout(() => {
            originalEditState = getEditState();
          }, 100);

          editModal.style.display = "flex";
        }
      });

      // Hàm lấy trạng thái hiện tại của edit modal
      function getEditState() {
        return {
          ngayKiem: document.getElementById("edit-ngay-kiem").value,
          maNV: document.getElementById("edit-ma-nv").value,
          ghiChu: document.getElementById("edit-ghi-chu").value,
          tableHtml: document.querySelector("#edit-detail-table tbody")
            .innerHTML,
        };
      }

      // Logic nút "Đặt lại" trong edit modal
      const btnResetEdit = document.getElementById("btn-reset-edit");
      if (btnResetEdit) {
        btnResetEdit.addEventListener("click", () => {
          if (!originalEditState) return;

          // Kiểm tra thay đổi
          const currentState = getEditState();
          const isChanged =
            JSON.stringify(currentState) !==
            JSON.stringify(originalEditState);

          if (!isChanged) {
            showToast("Chưa có thay đổi nào để đặt lại!", "info");
            return;
          }

          // Hỏi xác nhận
          if (
            confirm(
              "Khôi phục lại dữ liệu ban đầu?\n\nOK: Khôi phục lại dữ liệu ban đầu \n Cancel: Tiếp tục chỉnh sửa với dữ liệu hiện tại."
            )
          ) {
            //   // Chọn OK -> Lưu
            //   document.getElementById("btn-save-edit").click();
            // } else {
            // Chọn Cancel -> Khôi phục
            document.getElementById("edit-ngay-kiem").value =
              originalEditState.ngayKiem;
            document.getElementById("edit-ma-nv").value =
              originalEditState.maNV;
            document.getElementById("edit-ghi-chu").value =
              originalEditState.ghiChu;
            document.querySelector("#edit-detail-table tbody").innerHTML =
              originalEditState.tableHtml;
            updateDiffCount("edit-detail-table", "edit-diff-count");
            showToast("Đã khôi phục dữ liệu ban đầu!", "info");
          }
        });
      }

      // Logic nút "Lưu" trong edit modal
      const btnSaveEdit = document.getElementById("btn-save-edit");
      if (btnSaveEdit) {
        btnSaveEdit.addEventListener("click", async () => {
          const maPhieu = document.getElementById("edit-ma-phieu").value;
          const ngayKiem = document.getElementById("edit-ngay-kiem").value;
          const maNV = document.getElementById("edit-ma-nv").value.trim();
          const ghiChu = document.getElementById("edit-ghi-chu").value.trim();

          const rows = document.querySelectorAll(
            "#edit-detail-table tbody tr"
          );
          if (rows.length === 0) {
            showToast("Vui lòng thêm ít nhất một sách!", "error");
            return;
          }

          const chiTiet = Array.from(rows).map((row) => {
            const reasonsJson = row.dataset.reasonsJson || '[]';
            return {
              MaSach: row.cells[1].textContent.trim(),
              SoLuongHeThong: parseInt(row.cells[3].textContent),
              SoLuongThucTe: parseInt(row.cells[4].textContent),
              DanhSachLyDo: JSON.parse(reasonsJson),
            };
          });

          const result = await apiCall(
            `/api/inventory/update/${maPhieu}`,
            "PATCH",
            {
              NgayKiem: ngayKiem,
              MaNhanVien: maNV || null,
              GhiChu: ghiChu || null,
              chiTiet,
            }
          );

          if (result.success) {
            showToast("Cập nhật phiếu kiểm kê thành công!");
            editModal.style.display = "none";
            loadInventoryList(); // Reload danh sách
          } else {
            showToast(result.error || "Có lỗi xảy ra!", "error");
          }
        });
      }

      // Auto-fill sách cho edit modal
      const editMaSachInput = document.getElementById("edit-input-ma-sach");
      const editTenSachInput = document.getElementById("edit-input-ten-sach");
      const editSlHeThongInput = document.getElementById(
        "edit-input-sl-hethong"
      );

      if (editMaSachInput) {
        editMaSachInput.addEventListener("blur", async function () {
          const maSach = this.value.trim();
          if (!maSach) return;

          const book = await findBookInfo(maSach);
          if (book) {
            editTenSachInput.value = book.TenSach || "";
            editSlHeThongInput.value = book.SoLuongTon || 0;
          } else {
            showToast("Không tìm thấy sách với mã: " + maSach, "error");
            editTenSachInput.value = "";
            editSlHeThongInput.value = "";
          }
        });
      }

      // Nút thêm sách vào bảng edit
      const btnAddToListEdit = document.getElementById(
        "btn-add-to-list-edit"
      );
      if (btnAddToListEdit) {
        btnAddToListEdit.addEventListener("click", function () {
          const maSach = editMaSachInput.value.trim();
          const tenSach = editTenSachInput.value.trim();
          const slHeThong = editSlHeThongInput.value;
          const slThucTe = document.getElementById(
            "edit-input-sl-thucte"
          ).value;
          
          // Lấy danh sách lý do từ JSON
          const reasonsJson = document.getElementById('edit-input-reasons-json').value;
          const danhSachLyDo = JSON.parse(reasonsJson || '[]');
          const lyDoDisplay = formatReasonsForDisplay(danhSachLyDo);

          if (!maSach || !tenSach) {
            showToast("Vui lòng nhập mã sách hợp lệ!", "error");
            return;
          }

          const slThucTeNum = parseInt(slThucTe);
          const slHeThongNum = parseInt(slHeThong);

          if (isNaN(slThucTeNum) || slThucTeNum < 0) {
            showToast("Số lượng thực tế không hợp lệ!", "error");
            return;
          }

          // Kiểm tra: Nếu có chênh lệch thì phải có lý do
          if (slThucTeNum !== slHeThongNum && danhSachLyDo.length === 0) {
            showToast("Vui lòng nhập chi tiết lý do khi có chênh lệch!", "error");
            return;
          }

          // Kiểm tra sách đã có trong bảng chưa
          const existingRows = document.querySelectorAll(
            "#edit-detail-table tbody tr"
          );
          for (let row of existingRows) {
            if (row.cells[1].textContent.trim() === maSach) {
              showToast("Sách này đã có trong phiếu!", "error")
              return;
            }
          }

          addRowToDetailTable("edit-detail-table", "edit-diff-count", {
            maSach,
            tenSach,
            slHeThong: slHeThongNum,
            slThucTe: slThucTeNum,
            lyDo: lyDoDisplay,
            DanhSachLyDo: danhSachLyDo,
          });

          // Reset
          editMaSachInput.value = "";
          editTenSachInput.value = "";
          editSlHeThongInput.value = "";
          document.getElementById("edit-input-sl-thucte").value = "0";
          document.getElementById("edit-input-reasons-json").value = "[]";
          document.getElementById("reasons-summary-edit").textContent = "Chưa có lý do";
          editMaSachInput.focus();
        });
      }

      // --- LINE ITEM MODAL (Chỉnh sửa từng dòng) ---
      const lineItemModal = document.getElementById("line-item-modal");
      let currentEditingRow = null;
      let originalLineItemData = {}; // Lưu giá trị gốc để reset modal dòng

      // Mở modal chỉnh sửa dòng khi click vào icon edit
      document.addEventListener("click", function (e) {
        if (
          e.target.classList.contains("edit-row-icon") ||
          e.target.closest(".edit-row-icon")
        ) {
          const icon = e.target.classList.contains("edit-row-icon")
            ? e.target
            : e.target.closest(".edit-row-icon");
          currentEditingRow = icon.closest("tr");

          const tenSach =
            currentEditingRow.querySelector(".name-cell").textContent;
          const slHeThong = parseInt(
            currentEditingRow.querySelector(".sl-hethong-cell").textContent
          );
          const slThucTe = parseInt(
            currentEditingRow.querySelector(".sl-thucte-cell").textContent
          );
          
          // Lấy danh sách lý do từ data attribute
          const reasonsJson = currentEditingRow.dataset.reasonsJson || '[]';
          const danhSachLyDo = JSON.parse(reasonsJson);

          // Lưu giá trị gốc để reset
          originalLineItemData = { slHeThong, slThucTe, danhSachLyDo };

          document.getElementById("item-edit-name").value = tenSach;
          document.getElementById("item-edit-sl-hethong").value = slHeThong;
          document.getElementById("item-edit-sl-thucte").value = slThucTe;
          
          // Set danh sách lý do
          document.getElementById("lineitem-input-reasons-json").value = reasonsJson;
          
          // Cập nhật summary
          let summaryText = 'Chưa có lý do';
          if (danhSachLyDo.length > 0) {
            const totalQty = danhSachLyDo.reduce((sum, r) => sum + r.SoLuong, 0);
            if (danhSachLyDo.length === 1) {
              summaryText = getReasonDisplayName(danhSachLyDo[0].MaLyDo, danhSachLyDo[0].LyDoKhac) + ` (${danhSachLyDo[0].SoLuong})`;
            } else {
              summaryText = `${danhSachLyDo.length} lý do (${totalQty} cuốn)`;
            }
          }
          document.getElementById("reasons-summary-lineitem").textContent = summaryText;

          lineItemModal.style.display = "flex";
        }
      });

      // Lưu chỉnh sửa dòng
      const btnSaveLineItem = document.getElementById("btn-save-line-item");
      if (btnSaveLineItem) {
        btnSaveLineItem.addEventListener("click", function () {
          if (!currentEditingRow) return;

          const slHeThong = parseInt(
            document.getElementById("item-edit-sl-hethong").value
          );
          const slThucTe = parseInt(
            document.getElementById("item-edit-sl-thucte").value
          );
          
          // Lấy danh sách lý do từ JSON
          const reasonsJson = document.getElementById("lineitem-input-reasons-json").value;
          const danhSachLyDo = JSON.parse(reasonsJson || '[]');
          const lyDoDisplay = formatReasonsForDisplay(danhSachLyDo);

          if (isNaN(slThucTe) || slThucTe < 0) {
            showToast("Số lượng thực tế không hợp lệ!", "error");
            return;
          }

          // Kiểm tra: Nếu có chênh lệch thì phải có lý do
          const chenhLech = slThucTe - slHeThong;
          if (chenhLech !== 0 && danhSachLyDo.length === 0) {
            showToast("Vui lòng nhập chi tiết lý do khi có chênh lệch!", "error");
            return;
          }

          // Cập nhật row
          currentEditingRow.querySelector(".sl-thucte-cell").textContent =
            slThucTe;
          currentEditingRow.querySelector(".lydo-cell").textContent = lyDoDisplay;
          
          // Cập nhật data attribute
          currentEditingRow.dataset.reasonsJson = reasonsJson;

          // Cập nhật chênh lệch
          const diffCell = currentEditingRow.querySelector(".diff-cell");
          diffCell.textContent = (chenhLech > 0 ? "+" : "") + chenhLech;
          diffCell.dataset.value = chenhLech;

          // Cập nhật class màu
          diffCell.classList.remove(
            "diff-negative",
            "diff-positive",
            "diff-zero"
          );
          if (chenhLech < 0) diffCell.classList.add("diff-negative");
          else if (chenhLech > 0) diffCell.classList.add("diff-positive");
          else diffCell.classList.add("diff-zero");

          // Cập nhật số mặt hàng lệch
          updateDiffCount("edit-detail-table", "edit-diff-count");

          lineItemModal.style.display = "none";
          currentEditingRow = null;
          showToast("Đã cập nhật dòng!", "success");
        });
      }

      // Nút Đặt lại (Reset)
      const btnResetLineItem = document.getElementById("btn-reset-line-item");
      if (btnResetLineItem) {
        btnResetLineItem.addEventListener("click", () => {
          if (originalLineItemData) {
            document.getElementById("item-edit-sl-thucte").value = originalLineItemData.slThucTe;
            
            // Reset danh sách lý do
            const danhSachLyDo = originalLineItemData.danhSachLyDo || [];
            document.getElementById("lineitem-input-reasons-json").value = JSON.stringify(danhSachLyDo);
            
            // Cập nhật summary
            let summaryText = 'Chưa có lý do';
            if (danhSachLyDo.length > 0) {
              const totalQty = danhSachLyDo.reduce((sum, r) => sum + r.SoLuong, 0);
              if (danhSachLyDo.length === 1) {
                summaryText = getReasonDisplayName(danhSachLyDo[0].MaLyDo, danhSachLyDo[0].LyDoKhac) + ` (${danhSachLyDo[0].SoLuong})`;
              } else {
                summaryText = `${danhSachLyDo.length} lý do (${totalQty} cuốn)`;
              }
            }
            document.getElementById("reasons-summary-lineitem").textContent = summaryText;
            
            showToast("Đã khôi phục dữ liệu ban đầu!", "info");
          }
        });
      }

      // Đóng line item modal
      document.querySelectorAll(".close-modal-item").forEach((btn) => {
        btn.addEventListener("click", () => {
          lineItemModal.style.display = "none";
          currentEditingRow = null;
        });
      });

      // In phiếu
      document.addEventListener("click", function (e) {
        const btn = e.target.closest(".print-btn");
        if (btn) {
          const maPhieu = btn.dataset.id;
          printInventory(maPhieu);
        }
      });

      async function printInventory(maPhieu) {
        const result = await apiCall(`/api/inventory/${maPhieu}`);

        if (!result.success) {
          showToast("Không thể lấy dữ liệu để in!", "error");
          return;
        }

        const data = result.data.receipt;
        const date = new Date(data.NgayKiem);
        const dateStr = `Ngày ${date.getDate()} tháng ${date.getMonth() + 1
          } năm ${date.getFullYear()}`;

        let itemsHtml = "";
        let stt = 1;

        if (data.ChiTiet) {
          data.ChiTiet.forEach((item) => {
            const tenSach = item.Sach?.DauSach?.TenSach || "Sách đã xóa";
            const chenhLech = item.SoLuongThucTe - item.SoLuongHeThong;
            itemsHtml += `
                            <tr>
                                <td style="text-align: center;">${stt++}</td>
                                <td>${tenSach}</td>
                                <td style="text-align: center;">${item.SoLuongHeThong
              }</td>
                                <td style="text-align: center;">${item.SoLuongThucTe
              }</td>
                                <td style="text-align: center; ${chenhLech < 0
                ? "color: red;"
                : chenhLech > 0
                  ? "color: green;"
                  : ""
              }">${chenhLech > 0 ? "+" : ""}${chenhLech}</td>
                                <td>${item.LyDo || ""}</td>
                            </tr>
                        `;
          });
        }

        const printContent = `
                <html>
                <head>
                    <title>In Phiếu Kiểm Kê - ${maPhieu}</title>
                    <style>
                        body { font-family: 'Times New Roman', Times, serif; font-size: 14px; margin: 20px; }
                        .header { text-align: center; margin-bottom: 20px; }
                        .store-name { font-size: 18px; font-weight: bold; text-transform: uppercase; }
                        .title { font-size: 22px; font-weight: bold; margin-top: 10px; }
                        .info { margin-bottom: 20px; }
                        .info p { margin: 5px 0; }
                        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
                        th, td { border: 1px solid #333; padding: 8px; }
                        th { background-color: #f0f0f0; }
                        .signature-section { display: flex; justify-content: space-between; text-align: center; margin-top: 50px; }
                        .signature-box { width: 30%; }
                    </style>
                </head>
                <body>
                    <div class="header">
                        <div class="store-name">NHÀ SÁCH ABC</div>
                        <div>Địa chỉ: 123 Đường Hàn Thuyên, P. Thủ Đức, TP.HCM - SĐT: 0909.123.456</div>
                        <div class="title">BIÊN BẢN KIỂM KÊ KHO</div>
                        <div>(${dateStr})</div>
                    </div>

                    <div class="info">
                        <p><strong>Mã phiếu:</strong> ${data.MaPhieuKiem}</p>
                        <p><strong>Người kiểm kê:</strong> ${data.NhanVien?.HoTen || data.MaNhanVien || "---"
          }</p>
                        <p><strong>Ghi chú:</strong> ${data.GhiChu || "---"}</p>
                    </div>

                    <table>
                        <thead>
                            <tr>
                                <th style="width: 50px;">STT</th>
                                <th>Tên Sách</th>
                                <th style="width: 100px;">Tồn Hệ Thống</th>
                                <th style="width: 100px;">Tồn Thực Tế</th>
                                <th style="width: 100px;">Chênh Lệch</th>
                                <th>Lý Do</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${itemsHtml}
                        </tbody>
                    </table>

                    <div class="signature-section">
                        <div class="signature-box">
                            <strong>Người kiểm kê</strong><br>
                            (Ký, họ tên)<br><br><br><br>
                        </div>
                        <div class="signature-box">
                            <strong>Thủ kho</strong><br>
                            (Ký, họ tên)<br><br><br><br>
                        </div>
                    </div>
                </body>
                </html>
                `;

        const printWindow = window.open("", "", "height=600,width=800");
        printWindow.document.write(printContent);
        printWindow.document.close();

        setTimeout(() => {
          printWindow.focus();
          printWindow.print();
        }, 500);
      }

      // Xóa phiếu
      document.addEventListener("click", async function (e) {
        if (
          e.target.classList.contains("delete-icon") ||
          e.target.closest(".delete-icon")
        ) {
          const row = e.target.closest("tr");
          const maPhieu = row.cells[1].textContent.trim();

          if (confirm(`Xóa phiếu kiểm kê ${maPhieu}?`)) {
            const result = await apiCall(
              `/api/inventory/delete/${maPhieu}`,
              "DELETE"
            );
            if (result.success) {
              row.remove();
              showToast("Xóa phiếu kiểm kê thành công!");

              const tableBody = document.querySelector("#master-table tbody");
              if (tableBody.rows.length === 0) {
                const newRow = tableBody.insertRow();
                newRow.innerHTML = `<td colspan="6" style="text-align: center;">Chưa có phiếu kiểm kê nào.</td>`;
              }
            } else {
              showToast(result.error || "Có lỗi xảy ra!", "error");
            }
          }
        }
      });

      // Đóng modal
      document.querySelectorAll(".close-modal").forEach((btn) => {
        btn.addEventListener("click", () => {
          addModal.style.display = "none";
          editModal.style.display = "none";
        });
      });

      // Load danh sách phiếu kiểm kê (tôn trọng query filters trên URL)
      async function loadInventoryList() {
        const qs = window.location.search || "";
        const result = await apiCall(`/api/inventory/all${qs}`);

        if (!result.success) {
          showToast("Không thể tải danh sách phiếu kiểm kê!", "error");
          return;
        }

        const tbody = document.querySelector("#master-table tbody");
        tbody.innerHTML = "";

        const receipts = result.data.receipts;
        if (receipts && receipts.length > 0) {
          receipts.forEach((receipt, index) => {
            // Tính tổng độ lệch tuyệt đối: Sum(Abs(ThucTe - HeThong))
            // Nếu API đã trả TongLech/HasDiscrepancy thì ưu tiên dùng
            let tongLech = Number(receipt.TongLech);
            let hasDiscrepancy = Boolean(receipt.HasDiscrepancy);
            let hasShortage = Boolean(receipt.HasShortage);
            let hasSurplus = Boolean(receipt.HasSurplus);

            if (!Number.isFinite(tongLech)) {
              tongLech = 0;
              hasDiscrepancy = false;
              hasShortage = false;
              hasSurplus = false;
              if (receipt.ChiTiet && receipt.ChiTiet.length > 0) {
                receipt.ChiTiet.forEach((item) => {
                  const slHT = item.SoLuongHeThong || 0;
                  const slTT = item.SoLuongThucTe || 0;
                  const lech = Math.abs(slTT - slHT);
                  tongLech += lech;
                  if (lech > 0) {
                    hasDiscrepancy = true;
                    if (slHT > slTT) hasShortage = true;
                    if (slHT < slTT) hasSurplus = true;
                  }
                });
              }
            }

            // Determine badge
            let badgeHtml = '';
            if (hasDiscrepancy) {
              if (hasShortage && hasSurplus) {
                badgeHtml = `<span class="badge badge-mixed">🟣 Lệch hỗn hợp ${tongLech.toLocaleString("vi-VN")} cuốn</span>`;
              } else if (hasShortage) {
                badgeHtml = `<span class="badge badge-shortage">🔴 Lệch thiếu ${tongLech.toLocaleString("vi-VN")} cuốn</span>`;
              } else if (hasSurplus) {
                badgeHtml = `<span class="badge badge-surplus">🟡 Lệch thừa ${tongLech.toLocaleString("vi-VN")} cuốn</span>`;
              } else {
                badgeHtml = `<span class="badge badge-discrepancy">🔴 Lệch ${tongLech.toLocaleString("vi-VN")} cuốn</span>`;
              }
            } else {
              badgeHtml = `<span class="badge badge-balanced">🟢 Cân bằng</span>`;
            }

            const row = tbody.insertRow();
            row.innerHTML = `
                            <td>${index + 1}</td>
                            <td>${receipt.MaPhieuKiem}</td>
                            <td>${new Date(receipt.NgayKiem).toLocaleDateString(
              "vi-VN"
            )}</td>
                            <td>${receipt.NhanVien?.HoTen ||
              receipt.MaNhanVien ||
              "---"
              }</td>
                            <td>
                              ${badgeHtml}
                            </td>
                            <td>
                                <button class="btn btn-sm btn-secondary view-detail-btn" data-id="${receipt.MaPhieuKiem
              }">
                                    <i class="fas fa-eye"></i> Chi tiết
                                </button>
                                <button class="btn btn-sm btn-print ml-2 print-btn" data-id="${receipt.MaPhieuKiem
              }"> 
                                    <i class="fas fa-print"></i>
                                </button>
                                <i class="fas fa-trash action-icon delete-icon" style="margin-left: 12px; color: var(--red-accent);"></i>
                            </td>
                        `;
          });
        } else {
          const row = tbody.insertRow();
          row.innerHTML = `<td colspan="6" style="text-align: center;">Chưa có phiếu kiểm kê nào.</td>`;
        }
      }

      // Load khi vào trang
      loadInventoryList();

      // Filter UX
      (function initInventoryFilters() {
        const maPhieu = document.getElementById("f-ma-phieu");
        if (maPhieu) {
          maPhieu.addEventListener("input", () => {
            maPhieu.value = maPhieu.value.toUpperCase();
          });
        }
      })();

      // Logout
      const logoutBtn = document.getElementById("logout-button");
      if (logoutBtn) {
        logoutBtn.addEventListener("click", async (e) => {
          e.preventDefault();
          if (confirm("Bạn có chắc chắn muốn đăng xuất?")) {
            window.location.href = "/logout";
          }
        });
      }
    });
  </script>
</body>

</html>