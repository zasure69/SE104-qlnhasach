    <script>
      document.addEventListener("DOMContentLoaded", function () {
        // --- BIẾN & TIỆN ÍCH ---
        const loader = document.getElementById("loader");
        const toastContainer = document.getElementById("toast-container");

        function showLoader() {
          loader.style.display = "flex";
        }
        function hideLoader() {
          loader.style.display = "none";
        }

        function showToast(message, type = "success") {
          const toast = document.createElement("div");
          toast.classList.add("toast", type);
          const iconClass =
            type === "success"
              ? "fa-check-circle"
              : type === "error"
              ? "fa-exclamation-circle"
              : "fa-info-circle";
          toast.innerHTML = `<i class="fas ${iconClass} toast-icon"></i><span class="toast-message">${message}</span>`;
          toastContainer.appendChild(toast);
          setTimeout(() => {
            toast.classList.add("show");
          }, 100);
          setTimeout(() => {
            toast.classList.remove("show");
            setTimeout(() => toast.remove(), 300);
          }, 3000);
        }

        async function apiCall(url, method = "GET", body = null) {
          showLoader();
          try {
            const options = {
              method,
              headers: { "Content-Type": "application/json" },
            };
            if (body) options.body = JSON.stringify(body);

            const response = await fetch(url, options);

            if (!response.ok) {
              const errorText = await response.text();
              hideLoader();
              throw new Error(
                `Server error ${response.status}: ${errorText.substring(
                  0,
                  100
                )}`
              );
            }

            const data = await response.json();
            hideLoader();
            return { success: true, data };
          } catch (error) {
            hideLoader();
            console.error("API Error:", error);
            return { success: false, error: error.message };
          }
        }

        // --- HÀM XỬ LÝ BẢNG ---
        function updateDiffCount(tableId, countId) {
          const rows = document.querySelectorAll(`#${tableId} tbody tr`);
          let count = 0;
          rows.forEach((row) => {
            const diffCell = row.querySelector(".diff-cell");
            if (
              diffCell &&
              diffCell.dataset.value &&
              parseInt(diffCell.dataset.value) !== 0
            ) {
              count++;
            }
          });
          document.getElementById(countId).textContent = count;
        }

        function addRowToDetailTable(tableId, countId, data) {
          const tbody = document.querySelector(`#${tableId} tbody`);
          const row = tbody.insertRow();

          const slHeThong = parseInt(data.slHeThong) || 0;
          const slThucTe = parseInt(data.slThucTe) || 0;
          const chenhLech = slThucTe - slHeThong;

          let diffClass = "diff-zero";
          if (chenhLech < 0) diffClass = "diff-negative";
          else if (chenhLech > 0) diffClass = "diff-positive";

          row.innerHTML = `
                    <td class="stt-cell text-center">${tbody.rows.length}</td>
                    <td>${data.maSach}</td>
                    <td class="name-cell">${data.tenSach}</td>
                    <td class="sl-hethong-cell text-center">${slHeThong}</td>
                    <td class="sl-thucte-cell text-center">${slThucTe}</td>
                    <td class="diff-cell text-center ${diffClass}" data-value="${chenhLech}">${
            chenhLech > 0 ? "+" : ""
          }${chenhLech}</td>
                    <td class="lydo-cell">${data.lyDo || ""}</td>
                    <td class="text-center">
                        <i class="fas fa-trash action-icon delete-row-icon" 
                           onclick="deleteItemRow(this, '${tableId}', '${countId}')"
                           style="color:var(--red-accent);" title="Xóa dòng này"></i>
                    </td>
                `;
          updateDiffCount(tableId, countId);
        }

        window.deleteItemRow = function (element, tableId, countId) {
          element.closest("tr").remove();

          const rows = document.querySelectorAll(`#${tableId} tbody tr`);
          rows.forEach((row, index) => {
            row.querySelector(".stt-cell").textContent = index + 1;
          });

          updateDiffCount(tableId, countId);
        };

        // --- AUTO-FILL SÁCH ---
        async function findBookInfo(maSach) {
          try {
            const response = await fetch(`/api/books/getSach/${maSach}`);
            if (!response.ok) return null;

            const contentType = response.headers.get("content-type");
            if (!contentType || !contentType.includes("application/json"))
              return null;

            const data = await response.json();
            return data.sach || null;
          } catch (error) {
            console.error("[ERROR] Fetching book:", error);
            return null;
          }
        }

        const addMaSachInput = document.getElementById("add-input-ma-sach");
        const addTenSachInput = document.getElementById("add-input-ten-sach");
        const addSlHeThongInput = document.getElementById(
          "add-input-sl-hethong"
        );

        if (addMaSachInput) {
          addMaSachInput.addEventListener("blur", async function () {
            const maSach = this.value.trim();
            if (!maSach) return;

            const book = await findBookInfo(maSach);
            if (book) {
              addTenSachInput.value = book.TenSach || "";
              addSlHeThongInput.value = book.SoLuongTon || 0;
            } else {
              showToast("Không tìm thấy sách với mã: " + maSach, "error");
              addTenSachInput.value = "";
              addSlHeThongInput.value = "";
            }
          });
        }

        const btnAddToList = document.getElementById("btn-add-to-list");
        if (btnAddToList) {
          btnAddToList.addEventListener("click", function () {
            const maSach = addMaSachInput.value.trim();
            const tenSach = addTenSachInput.value.trim();
            const slHeThong = addSlHeThongInput.value;
            const slThucTe = document.getElementById(
              "add-input-sl-thucte"
            ).value;
            const lyDo = document
              .getElementById("add-input-ly-do")
              .value.trim();

            if (!maSach || !tenSach) {
              showToast("Vui lòng nhập mã sách hợp lệ!", "error");
              return;
            }

            const slThucTeNum = parseInt(slThucTe);
            const slHeThongNum = parseInt(slHeThong);

            if (isNaN(slThucTeNum) || slThucTeNum < 0) {
              showToast("Số lượng thực tế không hợp lệ!", "error");
              return;
            }

            // Kiểm tra: Nếu có chênh lệch thì phải có lý do
            if (slThucTeNum !== slHeThongNum && !lyDo) {
              showToast("Vui lòng nhập lý do khi có chênh lệch!", "error");
              return;
            }

            addRowToDetailTable("add-detail-table", "add-diff-count", {
              maSach,
              tenSach,
              slHeThong: slHeThongNum,
              slThucTe: slThucTeNum,
              lyDo,
            });

            // Reset
            addMaSachInput.value = "";
            addTenSachInput.value = "";
            addSlHeThongInput.value = "";
            document.getElementById("add-input-sl-thucte").value = "0";
            document.getElementById("add-input-ly-do").value = "";
            addMaSachInput.focus();
          });
        }

        // --- QUẢN LÝ MODAL ---
        const menuToggle = document.getElementById("menu-toggle");
        const sidebar = document.getElementById("sidebar");
        const container = document.querySelector(".dashboard-container");
        if (menuToggle) {
          menuToggle.addEventListener("click", () => {
            if (window.innerWidth <= 992) sidebar.classList.toggle("active");
            else container.classList.toggle("sidebar-collapsed");
          });
        }

        const addModal = document.getElementById("add-modal");
        const editModal = document.getElementById("edit-modal");

        // Biến lưu trạng thái ban đầu cho edit modal
        let originalEditState = null;

        // Biến cho logic Thêm mới -> Lưu -> Reset form
        let isSaveAndReset = false;

        // Hàm reset form thêm mới
        function resetAddForm() {
          document.getElementById("add-ngay-kiem").valueAsDate = new Date();
          document.getElementById("add-ghi-chu").value = "";
          document.querySelector("#add-detail-table tbody").innerHTML = "";
          document.getElementById("add-diff-count").textContent = "0";
          document.getElementById("add-input-ma-sach").value = "";
          document.getElementById("add-input-ten-sach").value = "";
          document.getElementById("add-input-sl-hethong").value = "";
          document.getElementById("add-input-sl-thucte").value = "0";
          document.getElementById("add-input-ly-do").value = "";
        }

        // Nút "Thêm mới" - Logic tương tự books_import
        const btnResetAdd = document.getElementById("btn-custom-reset");
        if (btnResetAdd) {
          btnResetAdd.addEventListener("click", () => {
            const hasData =
              document.querySelector("#add-detail-table tbody").rows.length > 0;

            if (hasData) {
              if (
                confirm(
                  "Bạn đang nhập dở phiếu kiểm kê. Bạn có muốn LƯU phiếu này không?\n\n- OK: Lưu phiếu.\n- Cancel: Xóa trắng để nhập phiếu khác."
                )
              ) {
                // Chọn OK -> Gọi submit form (Lưu)
                isSaveAndReset = true;
                document.getElementById("btn-save-add").click();
              } else {
                // Chọn Cancel -> Reset form, KHÔNG ĐÓNG MODAL
                resetAddForm();
                showToast("Đã làm mới form!", "info");
              }
            } else {
              // Chưa nhập gì -> Reset
              resetAddForm();
              showToast("Form đã sẵn sàng nhập mới.", "info");
            }
          });
        }

        // Mở Modal Thêm
        const openAddBtn = document.getElementById("open-add-modal");
        if (openAddBtn) {
          openAddBtn.addEventListener("click", () => {
            document.getElementById("add-ngay-kiem").valueAsDate = new Date();
            document.getElementById("add-ghi-chu").value = "";
            document.querySelector("#add-detail-table tbody").innerHTML = "";
            document.getElementById("add-diff-count").textContent = "0";
            addModal.style.display = "flex";
          });
        }

        // Lưu Thêm Mới
        const btnSaveAdd = document.getElementById("btn-save-add");
        if (btnSaveAdd) {
          btnSaveAdd.addEventListener("click", async () => {
            const ngayKiem = document.getElementById("add-ngay-kiem").value;
            const maNV = document.getElementById("add-ma-nv").value.trim();
            const ghiChu = document.getElementById("add-ghi-chu").value.trim();

            const rows = document.querySelectorAll(
              "#add-detail-table tbody tr"
            );
            if (rows.length === 0) {
              showToast("Vui lòng thêm ít nhất một sách!", "error");
              return;
            }

            const chiTiet = Array.from(rows).map((row) => {
              return {
                MaSach: row.cells[1].textContent.trim(),
                SoLuongHeThong: parseInt(row.cells[3].textContent),
                SoLuongThucTe: parseInt(row.cells[4].textContent),
                LyDo: row.cells[6].textContent.trim(),
              };
            });

            const result = await apiCall("/api/inventory/create", "POST", {
              NgayKiem: ngayKiem,
              MaNhanVien: maNV || null,
              GhiChu: ghiChu || null,
              chiTiet,
            });

            if (result.success) {
              showToast("Thêm phiếu kiểm kê thành công!");

              // Thêm dòng mới vào bảng ngay lập tức
              const tbody = document.querySelector("#master-table tbody");
              const firstRow = tbody.rows[0];

              // Xóa dòng "Chưa có phiếu" nếu có
              if (
                firstRow &&
                firstRow.cells.length === 1 &&
                firstRow.cells[0].colSpan === 7
              ) {
                firstRow.remove();
              }

              const newMaPhieu = result.data.MaPhieuKiem;
              const receipt = result.data.receipt;
              const stt = tbody.rows.length + 1;

              // Format ngày
              const dateObj = new Date(ngayKiem);
              const dateStr = dateObj.toLocaleDateString("vi-VN");

              // Tính tổng SL từ chiTiet đã gửi
              let tongSLHeThong = 0;
              let tongSLThucTe = 0;
              chiTiet.forEach((item) => {
                tongSLHeThong += item.SoLuongHeThong || 0;
                tongSLThucTe += item.SoLuongThucTe || 0;
              });

              const newRow = tbody.insertRow(0); // Thêm vào đầu bảng
              newRow.innerHTML = `
                <td>${stt}</td>
                <td>${newMaPhieu}</td>
                <td>${dateStr}</td>
                <td>${receipt?.NhanVien?.HoTen || maNV}</td>
                <td>${tongSLHeThong.toLocaleString("vi-VN")}</td>
                <td>${tongSLThucTe.toLocaleString("vi-VN")}</td>
                <td>
                  <button class="btn btn-sm btn-secondary view-detail-btn" data-id="${newMaPhieu}">
                    <i class="fas fa-eye"></i> Chi tiết
                  </button>
                  <button class="btn btn-sm btn-print ml-2 print-btn" data-id="${newMaPhieu}"> 
                    <i class="fas fa-print"></i>
                  </button>
                  <i class="fas fa-trash action-icon delete-icon" style="margin-left: 12px; color: var(--red-accent);"></i>
                </td>
              `;

              // Cập nhật lại STT cho các dòng sau
              Array.from(tbody.rows).forEach((row, index) => {
                row.cells[0].textContent = index + 1;
              });

              // Xử lý logic: Nếu bấm từ nút "Thêm mới" thì reset form, không đóng modal
              if (isSaveAndReset) {
                resetAddForm();
                showToast("Đã sẵn sàng nhập phiếu kiểm kê tiếp theo.", "info");
                isSaveAndReset = false;
              } else {
                addModal.style.display = "none";
              }
            } else {
              showToast(result.error || "Có lỗi xảy ra!", "error");
            }
          });
        }

        // Xem chi tiết / Chỉnh sửa
        document.addEventListener("click", async function (e) {
          if (
            e.target.classList.contains("view-detail-btn") ||
            e.target.closest(".view-detail-btn")
          ) {
            const btn = e.target.closest(".view-detail-btn");
            const maPhieu = btn.dataset.id;

            const result = await apiCall(`/api/inventory/${maPhieu}`);

            if (!result.success) {
              showToast("Không thể tải dữ liệu phiếu kiểm kê!", "error");
              return;
            }

            const phieu = result.data.receipt;

            // Điền thông tin chung vào form edit
            document.getElementById("edit-ma-phieu").value = phieu.MaPhieuKiem;
            document.getElementById("edit-ngay-kiem").value = phieu.NgayKiem
              ? phieu.NgayKiem.substring(0, 10)
              : "";
            document.getElementById("edit-ma-nv").value =
              phieu.MaNhanVien || "";
            document.getElementById("edit-ghi-chu").value = phieu.GhiChu || "";

            // Clear các input thêm sách
            document.getElementById("edit-input-ma-sach").value = "";
            document.getElementById("edit-input-ten-sach").value = "";
            document.getElementById("edit-input-sl-hethong").value = "";
            document.getElementById("edit-input-sl-thucte").value = "0";
            document.getElementById("edit-input-ly-do").value = "";

            const tbody = document.querySelector("#edit-detail-table tbody");
            tbody.innerHTML = "";

            let diffCount = 0;
            if (phieu.ChiTiet && phieu.ChiTiet.length > 0) {
              phieu.ChiTiet.forEach((item, index) => {
                const tenSach = item.Sach?.DauSach?.TenSach || "Không xác định";
                const slHeThong = item.SoLuongHeThong || 0;
                const slThucTe = item.SoLuongThucTe || 0;
                const chenhLech = slThucTe - slHeThong;

                if (chenhLech !== 0) diffCount++;

                let diffClass = "diff-zero";
                if (chenhLech < 0) diffClass = "diff-negative";
                else if (chenhLech > 0) diffClass = "diff-positive";

                const row = tbody.insertRow();
                row.innerHTML = `
                  <td class="stt-cell text-center">${index + 1}</td>
                  <td>${item.MaSach}</td>
                  <td class="name-cell">${tenSach}</td>
                  <td class="sl-hethong-cell text-center">${slHeThong}</td>
                  <td class="sl-thucte-cell text-center">${slThucTe}</td>
                  <td class="diff-cell text-center ${diffClass}" data-value="${chenhLech}">${
                  chenhLech > 0 ? "+" : ""
                }${chenhLech}</td>
                  <td class="lydo-cell">${item.LyDo || ""}</td>
                  <td class="text-center">
                    <i class="fas fa-pencil-alt action-icon edit-row-icon" style="color:var(--secondary-color);" title="Sửa dòng này"></i>
                    <i class="fas fa-trash action-icon delete-row-icon" 
                       onclick="deleteItemRow(this, 'edit-detail-table', 'edit-diff-count')"
                       style="color:var(--red-accent);" title="Xóa dòng này"></i>
                  </td>
                `;
              });
            }

            document.getElementById("edit-diff-count").textContent = diffCount;

            // Lưu trạng thái ban đầu để dùng cho nút "Đặt lại"
            setTimeout(() => {
              originalEditState = getEditState();
            }, 100);

            editModal.style.display = "flex";
          }
        });

        // Hàm lấy trạng thái hiện tại của edit modal
        function getEditState() {
          return {
            ngayKiem: document.getElementById("edit-ngay-kiem").value,
            maNV: document.getElementById("edit-ma-nv").value,
            ghiChu: document.getElementById("edit-ghi-chu").value,
            tableHtml: document.querySelector("#edit-detail-table tbody")
              .innerHTML,
          };
        }

        // Logic nút "Đặt lại" trong edit modal
        const btnResetEdit = document.getElementById("btn-reset-edit");
        if (btnResetEdit) {
          btnResetEdit.addEventListener("click", () => {
            if (!originalEditState) return;

            // Kiểm tra thay đổi
            const currentState = getEditState();
            const isChanged =
              JSON.stringify(currentState) !==
              JSON.stringify(originalEditState);

            if (!isChanged) {
              showToast("Chưa có thay đổi nào để đặt lại!", "info");
              return;
            }

            // Hỏi xác nhận
            if (
              confirm(
                "Dữ liệu đã thay đổi. Bạn có muốn LƯU LẠI không?\n\n- OK: Lưu thay đổi.\n- Cancel: Khôi phục lại dữ liệu gốc."
              )
            ) {
              // Chọn OK -> Lưu
              document.getElementById("btn-save-edit").click();
            } else {
              // Chọn Cancel -> Khôi phục
              document.getElementById("edit-ngay-kiem").value =
                originalEditState.ngayKiem;
              document.getElementById("edit-ma-nv").value =
                originalEditState.maNV;
              document.getElementById("edit-ghi-chu").value =
                originalEditState.ghiChu;
              document.querySelector("#edit-detail-table tbody").innerHTML =
                originalEditState.tableHtml;
              updateDiffCount("edit-detail-table", "edit-diff-count");
              showToast("Đã khôi phục dữ liệu ban đầu!", "info");
            }
          });
        }

        // Logic nút "Lưu" trong edit modal
        const btnSaveEdit = document.getElementById("btn-save-edit");
        if (btnSaveEdit) {
          btnSaveEdit.addEventListener("click", async () => {
            const maPhieu = document.getElementById("edit-ma-phieu").value;
            const ngayKiem = document.getElementById("edit-ngay-kiem").value;
            const maNV = document.getElementById("edit-ma-nv").value.trim();
            const ghiChu = document.getElementById("edit-ghi-chu").value.trim();

            const rows = document.querySelectorAll(
              "#edit-detail-table tbody tr"
            );
            if (rows.length === 0) {
              showToast("Vui lòng thêm ít nhất một sách!", "error");
              return;
            }

            const chiTiet = Array.from(rows).map((row) => {
              return {
                MaSach: row.cells[1].textContent.trim(),
                SoLuongHeThong: parseInt(row.cells[3].textContent),
                SoLuongThucTe: parseInt(row.cells[4].textContent),
                LyDo: row.cells[6].textContent.trim(),
              };
            });

            const result = await apiCall(
              `/api/inventory/update/${maPhieu}`,
              "PATCH",
              {
                NgayKiem: ngayKiem,
                MaNhanVien: maNV || null,
                GhiChu: ghiChu || null,
                chiTiet,
              }
            );

            if (result.success) {
              showToast("Cập nhật phiếu kiểm kê thành công!");
              editModal.style.display = "none";
              loadInventoryList(); // Reload danh sách
            } else {
              showToast(result.error || "Có lỗi xảy ra!", "error");
            }
          });
        }

        // Auto-fill sách cho edit modal
        const editMaSachInput = document.getElementById("edit-input-ma-sach");
        const editTenSachInput = document.getElementById("edit-input-ten-sach");
        const editSlHeThongInput = document.getElementById(
          "edit-input-sl-hethong"
        );

        if (editMaSachInput) {
          editMaSachInput.addEventListener("blur", async function () {
            const maSach = this.value.trim();
            if (!maSach) return;

            const book = await findBookInfo(maSach);
            if (book) {
              editTenSachInput.value = book.TenSach || "";
              editSlHeThongInput.value = book.SoLuongTon || 0;
            } else {
              showToast("Không tìm thấy sách với mã: " + maSach, "error");
              editTenSachInput.value = "";
              editSlHeThongInput.value = "";
            }
          });
        }

        // Nút thêm sách vào bảng edit
        const btnAddToListEdit = document.getElementById(
          "btn-add-to-list-edit"
        );
        if (btnAddToListEdit) {
          btnAddToListEdit.addEventListener("click", function () {
            const maSach = editMaSachInput.value.trim();
            const tenSach = editTenSachInput.value.trim();
            const slHeThong = editSlHeThongInput.value;
            const slThucTe = document.getElementById(
              "edit-input-sl-thucte"
            ).value;
            const lyDo = document
              .getElementById("edit-input-ly-do")
              .value.trim();

            if (!maSach || !tenSach) {
              showToast("Vui lòng nhập mã sách hợp lệ!", "error");
              return;
            }

            const slThucTeNum = parseInt(slThucTe);
            const slHeThongNum = parseInt(slHeThong);

            if (isNaN(slThucTeNum) || slThucTeNum < 0) {
              showToast("Số lượng thực tế không hợp lệ!", "error");
              return;
            }

            // Kiểm tra: Nếu có chênh lệch thì phải có lý do
            if (slThucTeNum !== slHeThongNum && !lyDo) {
              showToast("Vui lòng nhập lý do khi có chênh lệch!", "error");
              return;
            }

            // Kiểm tra sách đã có trong bảng chưa
            const existingRows = document.querySelectorAll(
              "#edit-detail-table tbody tr"
            );
            for (let row of existingRows) {
              if (row.cells[1].textContent.trim() === maSach) {
                showToast("Sách này đã có trong phiếu!", "error");
                return;
              }
            }

            addRowToDetailTable("edit-detail-table", "edit-diff-count", {
              maSach,
              tenSach,
              slHeThong: slHeThongNum,
              slThucTe: slThucTeNum,
              lyDo,
            });

            // Reset
            editMaSachInput.value = "";
            editTenSachInput.value = "";
            editSlHeThongInput.value = "";
            document.getElementById("edit-input-sl-thucte").value = "0";
            document.getElementById("edit-input-ly-do").value = "";
            editMaSachInput.focus();
          });
        }

        // --- LINE ITEM MODAL (Chỉnh sửa từng dòng) ---
        const lineItemModal = document.getElementById("line-item-modal");
        let currentEditingRow = null;

        // Mở modal chỉnh sửa dòng khi click vào icon edit
        document.addEventListener("click", function (e) {
          if (
            e.target.classList.contains("edit-row-icon") ||
            e.target.closest(".edit-row-icon")
          ) {
            const icon = e.target.classList.contains("edit-row-icon")
              ? e.target
              : e.target.closest(".edit-row-icon");
            currentEditingRow = icon.closest("tr");

            const tenSach =
              currentEditingRow.querySelector(".name-cell").textContent;
            const slHeThong = parseInt(
              currentEditingRow.querySelector(".sl-hethong-cell").textContent
            );
            const slThucTe = parseInt(
              currentEditingRow.querySelector(".sl-thucte-cell").textContent
            );
            const lyDo =
              currentEditingRow.querySelector(".lydo-cell").textContent;

            document.getElementById("item-edit-name").value = tenSach;
            document.getElementById("item-edit-sl-hethong").value = slHeThong;
            document.getElementById("item-edit-sl-thucte").value = slThucTe;
            document.getElementById("item-edit-lydo").value = lyDo;

            lineItemModal.style.display = "flex";
          }
        });

        // Lưu chỉnh sửa dòng
        const btnSaveLineItem = document.getElementById("btn-save-line-item");
        if (btnSaveLineItem) {
          btnSaveLineItem.addEventListener("click", function () {
            if (!currentEditingRow) return;

            const slHeThong = parseInt(
              document.getElementById("item-edit-sl-hethong").value
            );
            const slThucTe = parseInt(
              document.getElementById("item-edit-sl-thucte").value
            );
            const lyDo = document.getElementById("item-edit-lydo").value.trim();

            if (isNaN(slThucTe) || slThucTe < 0) {
              showToast("Số lượng thực tế không hợp lệ!", "error");
              return;
            }

            // Kiểm tra: Nếu có chênh lệch thì phải có lý do
            const chenhLech = slThucTe - slHeThong;
            if (chenhLech !== 0 && !lyDo) {
              showToast("Vui lòng nhập lý do khi có chênh lệch!", "error");
              return;
            }

            // Cập nhật row
            currentEditingRow.querySelector(".sl-thucte-cell").textContent =
              slThucTe;
            currentEditingRow.querySelector(".lydo-cell").textContent = lyDo;

            // Cập nhật chênh lệch
            const diffCell = currentEditingRow.querySelector(".diff-cell");
            diffCell.textContent = (chenhLech > 0 ? "+" : "") + chenhLech;
            diffCell.dataset.value = chenhLech;

            // Cập nhật class màu
            diffCell.classList.remove(
              "diff-negative",
              "diff-positive",
              "diff-zero"
            );
            if (chenhLech < 0) diffCell.classList.add("diff-negative");
            else if (chenhLech > 0) diffCell.classList.add("diff-positive");
            else diffCell.classList.add("diff-zero");

            // Cập nhật số mặt hàng lệch
            updateDiffCount("edit-detail-table", "edit-diff-count");

            lineItemModal.style.display = "none";
            currentEditingRow = null;
            showToast("Đã cập nhật dòng!", "success");
          });
        }

        // Đóng line item modal
        document.querySelectorAll(".close-modal-item").forEach((btn) => {
          btn.addEventListener("click", () => {
            lineItemModal.style.display = "none";
            currentEditingRow = null;
          });
        });

        // In phiếu
        document.addEventListener("click", function (e) {
          const btn = e.target.closest(".print-btn");
          if (btn) {
            const maPhieu = btn.dataset.id;
            printInventory(maPhieu);
          }
        });

        async function printInventory(maPhieu) {
          const result = await apiCall(`/api/inventory/${maPhieu}`);

          if (!result.success) {
            showToast("Không thể lấy dữ liệu để in!", "error");
            return;
          }

          const data = result.data.receipt;
          const date = new Date(data.NgayKiem);
          const dateStr = `Ngày ${date.getDate()} tháng ${
            date.getMonth() + 1
          } năm ${date.getFullYear()}`;

          let itemsHtml = "";
          let stt = 1;

          if (data.ChiTiet) {
            data.ChiTiet.forEach((item) => {
              const tenSach = item.Sach?.DauSach?.TenSach || "Sách đã xóa";
              const chenhLech = item.SoLuongThucTe - item.SoLuongHeThong;
              itemsHtml += `
                            <tr>
                                <td style="text-align: center;">${stt++}</td>
                                <td>${tenSach}</td>
                                <td style="text-align: center;">${
                                  item.SoLuongHeThong
                                }</td>
                                <td style="text-align: center;">${
                                  item.SoLuongThucTe
                                }</td>
                                <td style="text-align: center; ${
                                  chenhLech < 0
                                    ? "color: red;"
                                    : chenhLech > 0
                                    ? "color: green;"
                                    : ""
                                }">${chenhLech > 0 ? "+" : ""}${chenhLech}</td>
                                <td>${item.LyDo || ""}</td>
                            </tr>
                        `;
            });
          }

          const printContent = `
                <html>
                <head>
                    <title>In Phiếu Kiểm Kê - ${maPhieu}</title>
                    <style>
                        body { font-family: 'Times New Roman', Times, serif; font-size: 14px; margin: 20px; }
                        .header { text-align: center; margin-bottom: 20px; }
                        .store-name { font-size: 18px; font-weight: bold; text-transform: uppercase; }
                        .title { font-size: 22px; font-weight: bold; margin-top: 10px; }
                        .info { margin-bottom: 20px; }
                        .info p { margin: 5px 0; }
                        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
                        th, td { border: 1px solid #333; padding: 8px; }
                        th { background-color: #f0f0f0; }
                        .signature-section { display: flex; justify-content: space-between; text-align: center; margin-top: 50px; }
                        .signature-box { width: 30%; }
                    </style>
                </head>
                <body>
                    <div class="header">
                        <div class="store-name">NHÀ SÁCH CỦA BẠN</div>
                        <div>Địa chỉ: 123 Đường ABC, TP.HCM</div>
                        <div class="title">BIÊN BẢN KIỂM KÊ KHO</div>
                        <div>(${dateStr})</div>
                    </div>

                    <div class="info">
                        <p><strong>Mã phiếu:</strong> ${data.MaPhieuKiem}</p>
                        <p><strong>Người kiểm kê:</strong> ${
                          data.NhanVien?.HoTen || data.MaNhanVien || "---"
                        }</p>
                        <p><strong>Ghi chú:</strong> ${data.GhiChu || "---"}</p>
                    </div>

                    <table>
                        <thead>
                            <tr>
                                <th style="width: 50px;">STT</th>
                                <th>Tên Sách</th>
                                <th style="width: 100px;">Tồn Hệ Thống</th>
                                <th style="width: 100px;">Tồn Thực Tế</th>
                                <th style="width: 100px;">Chênh Lệch</th>
                                <th>Lý Do</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${itemsHtml}
                        </tbody>
                    </table>

                    <div class="signature-section">
                        <div class="signature-box">
                            <strong>Người kiểm kê</strong><br>
                            (Ký, họ tên)<br><br><br><br>
                        </div>
                        <div class="signature-box">
                            <strong>Thủ kho</strong><br>
                            (Ký, họ tên)<br><br><br><br>
                        </div>
                    </div>
                </body>
                </html>
                `;

          const printWindow = window.open("", "", "height=600,width=800");
          printWindow.document.write(printContent);
          printWindow.document.close();

          setTimeout(() => {
            printWindow.focus();
            printWindow.print();
          }, 500);
        }

        // Xóa phiếu
        document.addEventListener("click", async function (e) {
          if (
            e.target.classList.contains("delete-icon") ||
            e.target.closest(".delete-icon")
          ) {
            const row = e.target.closest("tr");
            const maPhieu = row.cells[1].textContent.trim();

            if (confirm(`Xóa phiếu kiểm kê ${maPhieu}?`)) {
              const result = await apiCall(
                `/api/inventory/delete/${maPhieu}`,
                "DELETE"
              );
              if (result.success) {
                row.remove();
                showToast("Xóa phiếu kiểm kê thành công!");

                const tableBody = document.querySelector("#master-table tbody");
                if (tableBody.rows.length === 0) {
                  const newRow = tableBody.insertRow();
                  newRow.innerHTML = `<td colspan="6" style="text-align: center;">Chưa có phiếu kiểm kê nào.</td>`;
                }
              } else {
                showToast(result.error || "Có lỗi xảy ra!", "error");
              }
            }
          }
        });

        // Đóng modal
        document.querySelectorAll(".close-modal").forEach((btn) => {
          btn.addEventListener("click", () => {
            addModal.style.display = "none";
            editModal.style.display = "none";
          });
        });

        // Load danh sách phiếu kiểm kê
        async function loadInventoryList() {
          const result = await apiCall("/api/inventory/all");

          if (!result.success) {
            showToast("Không thể tải danh sách phiếu kiểm kê!", "error");
            return;
          }

          const tbody = document.querySelector("#master-table tbody");
          tbody.innerHTML = "";

          const receipts = result.data.receipts;
          if (receipts && receipts.length > 0) {
            receipts.forEach((receipt, index) => {
              // Tính tổng Tồn Hệ Thống và Tồn Thực Tế từ chi tiết
              let tongSLHeThong = 0;
              let tongSLThucTe = 0;
              if (receipt.ChiTiet && receipt.ChiTiet.length > 0) {
                receipt.ChiTiet.forEach((item) => {
                  tongSLHeThong += item.SoLuongHeThong || 0;
                  tongSLThucTe += item.SoLuongThucTe || 0;
                });
              }

              const row = tbody.insertRow();
              row.innerHTML = `
                            <td>${index + 1}</td>
                            <td>${receipt.MaPhieuKiem}</td>
                            <td>${new Date(receipt.NgayKiem).toLocaleDateString(
                              "vi-VN"
                            )}</td>
                            <td>${
                              receipt.NhanVien?.HoTen ||
                              receipt.MaNhanVien ||
                              "---"
                            }</td>
                            <td>${tongSLHeThong.toLocaleString("vi-VN")}</td>
                            <td>${tongSLThucTe.toLocaleString("vi-VN")}</td>
                            <td>
                                <button class="btn btn-sm btn-secondary view-detail-btn" data-id="${
                                  receipt.MaPhieuKiem
                                }">
                                    <i class="fas fa-eye"></i> Chi tiết
                                </button>
                                <button class="btn btn-sm btn-print ml-2 print-btn" data-id="${
                                  receipt.MaPhieuKiem
                                }"> 
                                    <i class="fas fa-print"></i>
                                </button>
                                <i class="fas fa-trash action-icon delete-icon" style="margin-left: 12px; color: var(--red-accent);"></i>
                            </td>
                        `;
            });
          } else {
            const row = tbody.insertRow();
            row.innerHTML = `<td colspan="7" style="text-align: center;">Chưa có phiếu kiểm kê nào.</td>`;
          }
        }

        // Load khi vào trang
        loadInventoryList();

        // Logout
        const logoutBtn = document.getElementById("logout-button");
        if (logoutBtn) {
          logoutBtn.addEventListener("click", async (e) => {
            e.preventDefault();
            if (confirm("Bạn có chắc chắn muốn đăng xuất?")) {
              window.location.href = "/logout";
            }
          });
        }
      });
    </script>
  </body>
</html>
