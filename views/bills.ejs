      <div class="modal-footer" style="justify-content: space-between">
        <button type="button" class="btn btn-warning" id="btn-reset-line-item" style="flex: 1; margin-right: 1rem">
          Đặt lại
        </button>
        <button type="button" class="btn btn-primary" id="btn-save-line-item" style="flex: 1">
          Cập nhật
        </button>
