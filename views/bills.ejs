  <script>
    const currentUserInfo = {
      username: "<%= username %>",
      role: "<%= role %>",
      MaNV: "<%= MaNV %>", // Biến này lấy từ dashboardController
    };
    function setupPaymentValidation(prefix) {
      const paidInput = document.getElementById(`${prefix}-amount-paid`);
      // Giả sử tổng tiền được lưu trong input hidden hoặc span có id là total-amount
      // Lưu ý: Nếu total-amount là thẻ <span> (text), dùng .textContent. Nếu là <input>, dùng .value
      const totalElement = document.getElementById(`${prefix}-total-amount`);

      if (paidInput && totalElement) {
        paidInput.addEventListener("input", function () {
          // Lấy giá trị tổng tiền hiện tại (Xử lý chuỗi format 100.000 -> 100000)
          let totalValue = 0;
          if (totalElement.tagName === "INPUT") {
            totalValue = parseNumber(totalElement.value);
          } else {
            totalValue = parseNumber(totalElement.textContent);
          }

          // Lấy giá trị đang nhập
          let currentPaid = parseNumber(this.value);

          // Kiểm tra Logic
          if (currentPaid > totalValue) {
            showToast("Số tiền trả không được lớn hơn Tổng tiền!", "warning");

            // Cách 1: Reset về bằng Tổng tiền
            this.value = formatNumber(totalValue);

            // Cách 2: Hoặc chỉ đơn giản là không cho nhập số đó (hoàn tác)
            // Nhưng cách 1 UX tốt hơn vì giúp khách trả đủ ngay lập tức.
          }
        });
      }
    }
    document.addEventListener("DOMContentLoaded", function () {
      setupPaymentValidation("add");
      setupPaymentValidation("edit");

      // --- SIDEBAR TOGGLE ---
      const menuToggle = document.getElementById("menu-toggle");
      const sidebar = document.getElementById("sidebar");
      const container = document.querySelector(".dashboard-container");

      if (menuToggle && sidebar && container) {
        menuToggle.addEventListener("click", function () {
          if (window.innerWidth <= 992) {
            sidebar.classList.toggle("active");
          } else {
            container.classList.toggle("sidebar-collapsed");
          }
        });
      }

      // --- 1. BIẾN TOÀN CỤC & TIỆN ÍCH ---
      const loader = document.getElementById("loader");
      const toastContainer = document.getElementById("toast-container");

      // Biến dùng cho việc sửa dòng
      let currentRowToEdit = null;
      let currentTableId = null;
      let originalLineItemData = {}; // Lưu giá trị gốc để reset modal dòng

      // Biến dùng cho việc sửa hóa đơn (snapshot)
      let originalEditState = null;
      let lastBillMaHD = null;

      // Gọi API để lấy Mã Hóa Đơn cuối cùng từ Server
      function fetchLastMaHD() {
        return fetch("/api/bill/lastMaHD")
          .then((response) => response.json())
          .then((data) => {
            lastBillMaHD = data.lastMaHD;
            console.log("Mã Hóa Đơn cuối cùng đã được tải:", lastBillMaHD);
          })
          .catch((error) => {
            console.error("Lỗi khi tải Mã Hóa Đơn cuối cùng:", error);
            showToast("Lỗi: Không thể lấy Mã Hóa Đơn cuối cùng.", "error");
          });
      }

      function updateBillTotal(totalAmountId, amountDifference) {
        const totalInput = document.getElementById(totalAmountId);
        const currentTotal = parseNumber(totalInput.dataset.rawValue);
        const newTotal = currentTotal + amountDifference;
        totalInput.dataset.rawValue = newTotal;
        totalInput.textContent = formatNumber(newTotal);
        const prefix = totalAmountId.split("-")[0];
        calculateRemaining(prefix);
      }
      function showLoader() {
        loader.style.display = "flex";
      }
      function hideLoader() {
        loader.style.display = "none";
      }
      function showToast(message, type = "success") {
        const toast = document.createElement("div");
        toast.classList.add("toast", type);
        toast.innerHTML = `<i class="fas ${type === "success" ? "fa-check-circle" : "fa-exclamation-circle"
          } toast-icon"></i><span class="toast-message">${message}</span>`;
        toastContainer.appendChild(toast);
        setTimeout(() => {
          toast.classList.add("show");
        }, 100);
        setTimeout(() => {
          toast.classList.remove("show");
          setTimeout(() => toast.remove(), 300);
        }, 3000);
      }
      function simulateApiCall(callback) {
        showLoader();
        setTimeout(() => {
          hideLoader();
          callback(true);
        }, 500);
      }
      function formatNumber(num) {
        if (num === null || num === undefined) {
          return "0";
        }
        const numberValue = parseFloat(num);
        if (isNaN(numberValue)) {
          return "0";
        }
        const formattedString = new Intl.NumberFormat("vi-VN", {
          maximumFractionDigits: 2,
        }).format(numberValue);
        return formattedString;
      }
      function parseNumber(str) {
        if (!str) return 0;
        return parseFloat(str.toString().replace(/\./g, "")) || 0;
      }

      // --- 2. CÁC HÀM XỬ LÝ BẢNG (CORE LOGIC) ---

      // Hàm tính tổng tiền toàn hóa đơn
      window.updateTotal = function (tableId, totalId) {
        const rows = document.querySelectorAll(`#${tableId} .row-total`);
        let total = 0;
        if (rows) rows.forEach((r) => (total += parseFloat(r.dataset.value)));

        const totalEl = document.getElementById(totalId);
        if (totalEl) {
          totalEl.textContent = formatNumber(total);
          totalEl.dataset.rawValue = total;
        }

        const prefix = tableId.split("-")[0]; // 'add' hoặc 'edit'
        calculateRemaining(prefix);
      };

      // Hàm tính tiền nợ
      window.calculateRemaining = function (prefix) {
        const totalEl = document.getElementById(`${prefix}-total-amount`);
        if (!totalEl) return;

        const total = parseFloat(totalEl.dataset.rawValue) || 0;
        const paidInput = document.getElementById(`${prefix}-amount-paid`);
        const paid = parseNumber(paidInput.value);

        const remaining = total - paid;
        const debtEl = document.getElementById(`${prefix}-remaining-amount`);

        if (debtEl) {
          const displayValue = remaining < 0 ? 0 : remaining;
          debtEl.textContent = formatNumber(displayValue);
          debtEl.style.color =
            remaining > 0 ? "var(--red-accent)" : "var(--green-accent)";
        }
      };

      // HÀM MỞ MODAL SỬA DÒNG (Được gọi từ onclick)
      window.openItemEditModal = function (element, tableId) {
        const row = element.closest("tr");
        currentRowToEdit = row;
        currentTableId = tableId;

        // Lấy dữ liệu từ dòng
        const name = row.querySelector(".name-cell").textContent;
        const qty = row.querySelector(".qty-cell").textContent;
        const priceRaw = row.querySelector(".price-cell").dataset.raw;

        // Điền vào Modal nhỏ
        document.getElementById("item-edit-name").value = name;
        document.getElementById("item-edit-qty").value = qty;
        document.getElementById("item-edit-price").value =
          formatNumber(priceRaw);

        // Lưu lại gốc để reset
        originalLineItemData = { qty: qty, price: formatNumber(priceRaw) };

        // Hiện Modal
        document.getElementById("line-item-modal").style.display = "flex";
      };

      // HÀM XÓA DÒNG (Được gọi từ onclick)
      window.deleteItemRow = function (element, tableId, totalId) {
        element.closest("tr").remove();
        // Cập nhật STT
        const rows = document.querySelectorAll(`#${tableId} tbody tr`);
        rows.forEach((row, index) => {
          row.querySelector(".stt-cell").textContent = index + 1;
        });
        updateTotal(tableId, totalId);
      };

      // HÀM THÊM DÒNG VÀO BẢNG
      window.addRowToDetailTable = function (tableId, totalId, data) {
        const tbody = document.querySelector(`#${tableId} tbody`);
        const row = tbody.insertRow();
        const thanhTien = data.soLuong * data.donGia;

        row.innerHTML = `
                    <td class="stt-cell text-center">${tbody.rows.length}</td>
                    <td>${data.maSach}</td>
                    <td class="name-cell">${data.tenSach}</td>
                    <td class="cat-cell">${data.theLoai}</td>
                    <td class="qty-cell text-center">${data.soLuong}</td>
                    <td class="price-cell text-right" data-raw="${data.donGia
          }">${formatNumber(data.donGia)}</td>
                    <td class="row-total text-right" data-value="${thanhTien}">${formatNumber(
            thanhTien
          )}</td>
                    <td class="text-center">
                        <i class="fas fa-pencil-alt action-icon edit-row-icon" 
                           onclick="openItemEditModal(this, '${tableId}')"
                           title="Sửa dòng này"></i>
                        <i class="fas fa-trash action-icon delete-row-icon" 
                           onclick="deleteItemRow(this, '${tableId}', '${totalId}')"
                           style="color:var(--red-accent);" title="Xóa dòng này"></i>
                    </td>
                `;
        updateTotal(tableId, totalId);
      };

      // --- 3. XỬ LÝ LOGIC TRONG MODAL NHỎ (Cập nhật dòng) ---
      const btnSaveLineItem = document.getElementById("btn-save-line-item");
      const itemEditModal = document.getElementById("line-item-modal");
      const btnResetLineItem = document.getElementById("btn-reset-line-item");

      // Nút Cập nhật
      if (btnSaveLineItem) {
        btnSaveLineItem.addEventListener("click", () => {
          if (!currentRowToEdit) return;

          const newQty = parseInt(
            document.getElementById("item-edit-qty").value
          );
          const newPrice = parseNumber(
            document.getElementById("item-edit-price").value
          );

          if (newQty <= 0) {
            alert("Số lượng phải lớn hơn 0");
            return;
          }

          // Cập nhật lại dòng
          currentRowToEdit.querySelector(".qty-cell").textContent = newQty;
          const priceCell = currentRowToEdit.querySelector(".price-cell");
          priceCell.textContent = formatNumber(newPrice);
          priceCell.dataset.raw = newPrice;

          // Tính lại thành tiền
          const newTotal = newQty * newPrice;
          const totalCell = currentRowToEdit.querySelector(".row-total");
          totalCell.textContent = formatNumber(newTotal);
          totalCell.dataset.value = newTotal;

          // Cập nhật tổng
          const prefix = currentTableId.split("-")[0];
          updateTotal(currentTableId, `${prefix}-total-amount`);

          // Đóng modal
          itemEditModal.style.display = "none";
