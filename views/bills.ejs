            this.value = formatNumber(parseNumber(this.value));
          });
        }

        // Nút "Thêm" vào bảng
        const btnAdd = document.getElementById(
          prefix === "add" ? "btn-add-to-list" : "btn-add-to-list-edit"
        );
        if (btnAdd) {
          btnAdd.addEventListener("click", () => {
            const maSachInput = document.getElementById(
              `${prefix}-input-ma-sach`
            );
            const tenSachInput = document.getElementById(
              `${prefix}-input-ten-sach`
            );
            const theLoaiInput = document.getElementById(
              `${prefix}-input-the-loai`
            );
            const soLuongInput = document.getElementById(
              `${prefix}-input-so-luong`
            );
            const donGiaInput = document.getElementById(
              `${prefix}-input-don-gia`
            );
            const detailTable = document.getElementById(
              `${prefix}-detail-table`
            );
            const amountTable = `${prefix}-total-amount`;

            const soLuongMoi = parseInt(soLuongInput.value);

            if (
              !maSachInput.value ||
              !tenSachInput.value ||
              !theLoaiInput.value
            ) {
              showToast("Vui lòng nhập sách!", "error");
              return;
            }

            if (soLuongMoi <= 0 || isNaN(soLuongMoi)) {
              showToast("Số lượng sách phải lớn hơn 0!", "error");
              soLuongInput.value = 1; // Reset về 1
              soLuongInput.focus();
              return; // Dừng lại, không cho thêm
            }

            let found = false;

            for (let i = 1; i < detailTable.rows.length; i++) {
              const row = detailTable.rows[i];

              // Đảm bảo hàng có đủ cột và Mã sách ở cột đầu tiên (index 0)
              if (row.cells.length > 0) {
                const cellMaSach = row.cells[1];
                if (cellMaSach.textContent.trim() === maSachInput.value) {
                  found = true;

                  // Logic CẬP NHẬT (đã fix lỗi tổng tiền)
                  const soLuongCell = row.cells[4];
                  const donGiaCell = row.cells[5];
                  const thanhTienCell = row.cells[6];

                  const soLuongCu = parseInt(soLuongCell.textContent.trim());
                  const thanhTienCu = parseNumber(
                    thanhTienCell.textContent.trim()
                  );
                  const donGia = parseNumber(donGiaCell.textContent.trim());

                  const soLuongMoi = parseInt(soLuongInput.value);

                  const soLuongTong = soLuongCu + soLuongMoi;
                  const thanhTienMoi = soLuongTong * donGia;

                  const difference = thanhTienMoi - thanhTienCu; // Tính chênh lệch

                  soLuongCell.textContent = soLuongTong;
                  thanhTienCell.textContent = formatNumber(thanhTienMoi);
                  thanhTienCell.dataset.value = thanhTienMoi;

                  // Cập nhật tổng tiền hóa đơn (dùng hàm đã tạo ở bước trước)
                  updateBillTotal(amountTable, difference);

                  showToast(
                    `Đã cộng dồn sách ${maSachInput.value}. Số lượng: ${soLuongTong}`,
                    "success"
                  );

                  break;
                }
              }
            }

            if (!found) {
              addRowToDetailTable(
                `${prefix}-detail-table`,
                `${prefix}-total-amount`,
                {
                  maSach: maSachInput.value,
                  tenSach: tenSachInput.value,
                  theLoai: theLoaiInput.value,
                  soLuong: parseInt(soLuongInput.value),
                  donGia: parseNumber(donGiaInput.value),
                }
              );
            }

            // Reset
            maSachInput.value = "";
            tenSachInput.value = "";
            theLoaiInput.value = "";
            soLuongInput.value = "1";
            donGiaInput.value = "";
            maSachInput.focus();
          });
        }
      });

