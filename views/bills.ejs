          const maKhachHang = document
            .getElementById("add-ma-kh")
            .value.trim();

          // Lấy giá trị tiền (Dùng raw value để đảm bảo tính toán đúng với số thực)
          const tongTien = parseNumber(
            document.getElementById("add-total-amount").dataset.rawValue
          );
          const soTienTra = parseNumber(
            document.getElementById("add-amount-paid").value
          );

          // --- [QUAN TRỌNG] KIỂM TRA CHẶN LƯU ---
          if (soTienTra > tongTien) {
            showToast(
              `Số tiền trả (${formatNumber(
                soTienTra
              )}) không được lớn hơn Tổng tiền (${formatNumber(tongTien)})!`,
              "error"
            );
            document.getElementById("add-amount-paid").focus(); // Đưa con trỏ về ô nhập tiền để sửa
            return; // DỪNG LẠI NGAY, KHÔNG THỰC HIỆN CÁC LỆNH BÊN DƯỚI
          }
          // --------------------------------------

          // Tính toán ConLai (Lúc này chắc chắn >= 0 vì đã chặn ở trên)
          const conLai = tongTien - soTienTra;

          // 2. Thu thập Chi tiết Sách
          const detailTable = document.getElementById("add-detail-table");
          const detailBooks = [];

          for (let i = 1; i < detailTable.rows.length; i++) {
            const row = detailTable.rows[i];
            if (row.cells.length >= 7) {
              const maSach = row.cells[1].textContent.trim();
              const soLuongBan = parseInt(row.cells[4].textContent.trim());
              const donGiaBan = parseNumber(row.cells[5].textContent.trim());
              const thanhTien = parseNumber(row.cells[6].textContent.trim());

              if (maSach && soLuongBan > 0) {
                detailBooks.push({
                  MaSach: maSach,
                  SoLuongBan: soLuongBan,
                  DonGiaBan: donGiaBan,
                  ThanhTien: thanhTien,
                });
              }
            }
          }

          // Validate dữ liệu rỗng
          if (!maKhachHang || detailBooks.length === 0) {
            showToast(
              "Vui lòng kiểm tra lại Khách hàng và chi tiết sách.",
              "error"
            );
            return;
          }

          // 3. Gửi API (Chỉ chạy xuống đây nếu các điều kiện trên đã thỏa)
          const newData = {
            MaHoaDon: MaHD,
            MaKhachHang: maKhachHang,
            MaNhanVien: currentUserInfo.MaNV,
            TongTien: tongTien,
            SoTienTra: soTienTra,
            ConLai: conLai,
            Details: detailBooks,
          };

          fetch("/api/bill/create", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(newData),
          })
            .then((response) => response.json())
            .then((data) => {
              if (data.message && data.message.includes("thành công")) {
                showToast(`Thêm hóa đơn ${MaHD} thành công!`, "success");
                lastBillMaHD = MaHD;
                if (isSaveAndReset) {
                  // Trường hợp 1: Từ nút "Thêm mới" (Lưu -> Reset form -> Không đóng)
                  resetAddForm();
                  showToast("Đã sẵn sàng nhập hóa đơn tiếp theo.", "info");

                  // Reset cờ về false sau khi xong việc
                  isSaveAndReset = false;
                } else {
                  addModal.style.display = "none";
                  resetAddForm();
                }

                // 1. Lấy dữ liệu từ form hiện tại để hiển thị
                const tenKH = document.getElementById("add-ten-kh").value;
                const rawDate = document.getElementById("add-ngay-lap").value; // YYYY-MM-DD

                // Format ngày: YYYY-MM-DD -> DD/MM/YYYY
                let dateDisplay = rawDate;
                if (rawDate && rawDate.includes("-")) {
                  const parts = rawDate.split("-");
                  dateDisplay = `${parts[2]}/${parts[1]}/${parts[0]}`;
                }

                // 2. Tạo dòng HTML mới
                const tbody = document.querySelector("#master-table tbody");

                // Xóa dòng "Không có dữ liệu" nếu bảng đang trống
                const noDataRow = tbody.querySelector(".no-data");
                if (noDataRow) noDataRow.remove();

                const stt = tbody.rows.length + 1; // Tính số thứ tự mới

                const newRow = document.createElement("tr");
                newRow.setAttribute("data-id", MaHD); // Để dùng cho nút xóa
                newRow.innerHTML = `
                            <td>${stt}</td>
                            <td>${MaHD}</td>
                            <td>${tenKH}</td>
                            <td>${dateDisplay}</td>
                            <td class="text-right">${formatNumber(
                  newData.TongTien
                )}</td>
                            <td>
                                <button class="btn btn-sm btn-secondary view-detail-btn" data-id="${MaHD}"> 
                                    <i class="fas fa-eye"></i> Chi tiết 
                                </button>
                                <button class="btn btn-sm btn-print ml-2" data-id="${MaHD}"> 
                                    <i class="fas fa-print"></i>
                                </button>
                                <i class="fas fa-trash action-icon delete-icon" 
                                style="margin-left: 12px; color: var(--red-accent);"></i>
                            </td>
                        `;

                // 3. Chèn vào đầu bảng hoặc cuối bảng (ở đây là cuối bảng)
                tbody.appendChild(newRow);
              } else {
                showToast(`Thêm thất bại: ${data.message}`, "error");
              }
            })
            .catch((error) => {
              console.error("Lỗi API:", error);
              showToast("Lỗi kết nối server.", "error");
            });
        });
      document
        .getElementById("btn-save-edit")
        .addEventListener("click", () => {
          // 1. Lấy dữ liệu cơ bản
          const MaHD = document.getElementById("edit-ma-hd").value;
          const editModal = document.getElementById("edit-modal");
          const maKhachHang = document.getElementById("edit-ma-kh").value;

          const tongTien = parseNumber(
            document.getElementById("edit-total-amount").dataset.rawValue
          );
          const soTienTra = parseNumber(
            document.getElementById("edit-amount-paid").value
          );

          // --- [QUAN TRỌNG] KIỂM TRA CHẶN LƯU ---
          if (soTienTra > tongTien) {
            showToast(
              `Số tiền trả (${formatNumber(
                soTienTra
              )}) không được lớn hơn Tổng tiền (${formatNumber(tongTien)})!`,
              "error"
            );
            document.getElementById("edit-amount-paid").focus();
            return; // DỪNG LẠI NGAY
          }
          // --------------------------------------

          const conLai = tongTien - soTienTra;

          // 2. Thu thập Chi tiết Sách
          const detailTable = document.getElementById("edit-detail-table");
          const detailBooks = [];

          for (let i = 1; i < detailTable.rows.length; i++) {
            const row = detailTable.rows[i];
            if (row.cells.length >= 7) {
              const maSach = row.cells[1].textContent.trim();
              const soLuongBan = parseInt(row.cells[4].textContent.trim());
              const donGiaBan = parseNumber(row.cells[5].textContent.trim());
              const thanhTien = parseNumber(row.cells[6].textContent.trim());

              if (maSach && soLuongBan > 0) {
                detailBooks.push({
                  MaSach: maSach,
                  SoLuongBan: soLuongBan,
                  DonGiaBan: donGiaBan,
                  ThanhTien: thanhTien,
                });
              }
            }
          }

          if (!MaHD || !maKhachHang || detailBooks.length === 0) {
            showToast("Vui lòng kiểm tra lại thông tin hóa đơn.", "error");
            return;
          }

          // 3. Gửi API
          const updateData = {
            MaKhachHang: maKhachHang,
            TongTien: tongTien,
            SoTienTra: soTienTra,
            ConLai: conLai,
            Details: detailBooks,
          };

          fetch(`/api/bill/${MaHD}`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(updateData),
          })
            .then((response) => response.json())
            .then((data) => {
              if (data.message && data.message.includes("thành công")) {
                showToast("Cập nhật hóa đơn thành công!", "success");
                editModal.style.display = "none";
                setTimeout(() => {
                  location.reload();
                }, 1000);
              } else {
                showToast(`Cập nhật thất bại: ${data.message}`, "error");
              }
            })
            .catch((error) => {
              console.error("Lỗi API:", error);
              showToast("Lỗi kết nối server.", "error");
            });
        });

      document.querySelectorAll(".close-modal").forEach((btn) => {
        btn.addEventListener("click", () => {
          addModal.style.display = "none";
          editModal.style.display = "none";
        });
      });

      // Xóa hóa đơn ngoài bảng
      const masterTable = document.getElementById("master-table");
      if (masterTable) {
        masterTable.addEventListener("click", async function (e) {
          // Tìm nút xóa (icon hoặc phần tử cha)
          const deleteBtn = e.target.classList.contains("delete-icon")
            ? e.target
            : e.target.closest(".delete-icon");

          if (deleteBtn) {
            const row = deleteBtn.closest("tr");
            // Lấy Mã Hóa Đơn (Ưu tiên lấy từ data-id nếu có, không thì lấy cột đầu tiên)
            const maHD = row.dataset.id || row.cells[0].textContent.trim();

            const confirmMsg =
              `CẢNH BÁO: Bạn có chắc chắn muốn XÓA hóa đơn ${maHD}?\n\n` +
              `- Số lượng sách sẽ được cộng lại vào kho.\n` +
              `- Số nợ của khách hàng (nếu có) sẽ bị hủy bỏ.`;

            if (confirm(confirmMsg)) {
              try {
                // 1. Gọi API DELETE
                const response = await fetch(`/api/bill/${maHD}`, {
                  method: "DELETE",
                  headers: { "Content-Type": "application/json" },
                });

                const result = await response.json();

                if (response.ok) {
                  // 2. Thành công: Xóa dòng khỏi bảng
                  row.remove();
                  showToast(`Đã xóa hóa đơn ${maHD} thành công!`, "success");

                  // Kiểm tra nếu bảng trống thì hiện thông báo
                  const tbody = masterTable.querySelector("tbody");
                  if (tbody && tbody.children.length === 0) {
                    tbody.innerHTML =
                      '<tr><td colspan="7" class="no-data" style="text-align:center; padding:20px;">Chưa có hóa đơn nào.</td></tr>';
                  }
                } else {
                  // Thất bại
                  showToast(`Lỗi: ${result.message}`, "error");
                }
              } catch (error) {
                console.error("Lỗi khi xóa hóa đơn:", error);
                showToast("Lỗi kết nối server.", "error");
              }
            }
          }
        });
      }

      // --- LOGOUT ---
      const logoutBtn = document.getElementById("logout-button");
      if (logoutBtn) {
        logoutBtn.addEventListener("click", async (e) => {
          e.preventDefault();
          if (confirm("Bạn có chắc chắn muốn đăng xuất?")) {
            window.location.href = "/logout";
          }
        });
      }
    });
  </script>
</body>

</html>