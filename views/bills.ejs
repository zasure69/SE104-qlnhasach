    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const loader = document.getElementById('loader');
            const toastContainer = document.getElementById('toast-container');
            function showLoader() { loader.style.display = 'flex'; }
            function hideLoader() { loader.style.display = 'none'; }
            function showToast(message, type = 'success') {
                const toast = document.createElement('div');
                toast.classList.add('toast', type);
                toast.innerHTML = `<i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} toast-icon"></i><span class="toast-message">${message}</span>`;
                toastContainer.appendChild(toast);
                setTimeout(() => { toast.classList.add('show'); }, 100);
                setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 300); }, 3000);
            }
            function formatNumber(num) { return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, "."); }
            function parseNumber(str) { if (!str) return 0; return parseFloat(str.toString().replace(/\./g, '')) || 0; }

            const menuToggle = document.getElementById('menu-toggle');
            const sidebar = document.getElementById('sidebar');
            const container = document.querySelector('.dashboard-container');
            if (menuToggle) menuToggle.addEventListener('click', () => {
                if (window.innerWidth <= 992) sidebar.classList.toggle('active');
                else container.classList.toggle('sidebar-collapsed');
            });

            function findCustomer(maKH) {
                const customers = { 'KH01': 'Nguyễn Văn A', 'KH02': 'Trần Thị B' };
                return customers[maKH.toUpperCase()] || '';
            }
            ['add', 'edit'].forEach(prefix => {
                const maKhInput = document.getElementById(`${prefix}-ma-kh`);
                const tenKhInput = document.getElementById(`${prefix}-ten-kh`);
                if (maKhInput) {
                    maKhInput.addEventListener('blur', function () {
                        tenKhInput.value = findCustomer(this.value);
                    });
                }
            });

            function findBook(maSach) {
                const books = {
                    'S001': { name: 'Mắt biếc', cat: 'Truyện ngắn', price: 105000 },
                    'S002': { name: 'Harry Potter', cat: 'Tiểu thuyết', price: 250000 }
                };
                return books[maSach.toUpperCase()] || null;
            }
            ['add', 'edit'].forEach(prefix => {
                const maSachInput = document.getElementById(`${prefix}-input-ma-sach`);
                const tenSachInput = document.getElementById(`${prefix}-input-ten-sach`);
                const theLoaiInput = document.getElementById(`${prefix}-input-the-loai`);
                const donGiaInput = document.getElementById(`${prefix}-input-don-gia`);

                if (maSachInput) {
                    maSachInput.addEventListener('blur', function () {
                        const book = findBook(this.value);
                        if (book) {
                            tenSachInput.value = book.name;
                            if (theLoaiInput) theLoaiInput.value = book.cat;
                            if (donGiaInput) donGiaInput.value = formatNumber(book.price);
                        } else {
                            tenSachInput.value = '';
                            if (theLoaiInput) theLoaiInput.value = '';
                            if (donGiaInput) donGiaInput.value = '';
                        }
                    });
                }
            });

            function addRow(tableId, data) {
                const tbody = document.querySelector(`#${tableId} tbody`);
                const row = tbody.insertRow();
                const thanhTien = data.qty * data.price;
                row.innerHTML = `
                    <td>${tbody.rows.length}</td>
                    <td>${data.code}</td>
                    <td>${data.name}</td>
                    <td>${data.cat}</td>
                    <td>${data.qty}</td>
                    <td>${formatNumber(data.price)}</td>
                    <td class="row-total" data-value="${thanhTien}">${formatNumber(thanhTien)}</td>
                    <td><i class="fas fa-trash action-icon" style="color:var(--red-accent);" onclick="this.closest('tr').remove(); updateInvoiceTotals('${tableId.split('-')[0]}')"></i></td>
                `;
                updateInvoiceTotals(tableId.split('-')[0]);
            }

            window.updateInvoiceTotals = function (prefix) {
                const rows = document.querySelectorAll(`#${prefix}-detail-table .row-total`);
                let total = 0;
                if (rows) rows.forEach(r => total += parseFloat(r.dataset.value));

                document.getElementById(`${prefix}-total-amount`).textContent = formatNumber(total);
                document.getElementById(`${prefix}-total-amount`).dataset.rawValue = total;

                calculateRemaining(prefix);
            }

            function calculateRemaining(prefix) {
                const total = parseFloat(document.getElementById(`${prefix}-total-amount`).dataset.rawValue) || 0;
                const paidInput = document.getElementById(`${prefix}-amount-paid`);
                const paid = parseNumber(paidInput.value);
                const remaining = total - paid;
                const debtEl = document.getElementById(`${prefix}-remaining-amount`);
                debtEl.textContent = formatNumber(remaining);

                if (remaining > 0) debtEl.style.color = 'var(--red-accent)';
                else debtEl.style.color = 'var(--green-accent)';
            }

            ['add', 'edit'].forEach(prefix => {
                const paidInput = document.getElementById(`${prefix}-amount-paid`);
                if (paidInput) {
                    paidInput.addEventListener('input', () => calculateRemaining(prefix));
                    paidInput.addEventListener('blur', function () { this.value = formatNumber(parseNumber(this.value)); });
                }

                const addBtn = document.getElementById(`btn-add-to-list${prefix === 'edit' ? '-edit' : ''}`);
                if (addBtn) {
                    addBtn.addEventListener('click', () => {
                        const code = document.getElementById(`${prefix}-input-ma-sach`).value;
                        const name = document.getElementById(`${prefix}-input-ten-sach`).value;
                        const cat = document.getElementById(`${prefix}-input-the-loai`).value;
                        const qty = parseInt(document.getElementById(`${prefix}-input-so-luong`).value);
                        const price = parseNumber(document.getElementById(`${prefix}-input-don-gia`).value);

                        if (!code || !qty || !price) return showToast('Vui lòng nhập đủ thông tin sách', 'error');

                        addRow(`${prefix}-detail-table`, { code, name, cat, qty, price });

                        document.getElementById(`${prefix}-input-ma-sach`).value = '';
                        document.getElementById(`${prefix}-input-ten-sach`).value = '';
                        document.getElementById(`${prefix}-input-the-loai`).value = '';
                        document.getElementById(`${prefix}-input-don-gia`).value = '';
                        document.getElementById(`${prefix}-input-so-luong`).value = '1';
                        document.getElementById(`${prefix}-input-ma-sach`).focus();
                    });
                }
            });

            const addModal = document.getElementById('add-modal');
            const editModal = document.getElementById('edit-modal');
            const openAddBtn = document.getElementById('open-add-modal');

            if (openAddBtn) {
                openAddBtn.addEventListener('click', () => {
                    document.querySelector('#add-detail-table tbody').innerHTML = '';
                    updateInvoiceTotals('add');
                    document.getElementById('add-amount-paid').value = '';
                    document.getElementById('add-ngay-lap').valueAsDate = new Date();
                    document.getElementById('add-ma-kh').value = '';
                    document.getElementById('add-ten-kh').value = '';
                    addModal.style.display = 'flex';
                });
            }

            const viewDetailBtns = document.querySelectorAll('.view-detail-btn');
            if (viewDetailBtns.length > 0) {
                for (const btn of viewDetailBtns) {
                    btn.addEventListener('click', function () {
                        const id = this.dataset.id;
                        document.getElementById('edit-ma-hd').value = id;
                        document.getElementById('edit-ngay-lap').value = '2025-11-22';
                        document.getElementById('edit-ma-kh').value = 'KH01';
                        document.getElementById('edit-ten-kh').value = 'Nguyễn Văn A';

                        const tbody = document.querySelector('#edit-detail-table tbody');
                        tbody.innerHTML = '';
                        addRow('edit-detail-table', { code: 'S001', name: 'Mắt biếc', cat: 'Truyện ngắn', qty: 1, price: 105000 });

                        document.getElementById('edit-amount-paid').value = '105.000';
                        calculateRemaining('edit');

                        editModal.style.display = 'flex';
                    });
                }
            }

            const closeBtns = document.querySelectorAll('.close-modal');
            if (closeBtns.length > 0) {
                for (const btn of closeBtns) {
                    btn.addEventListener('click', () => {
                        if (addModal) addModal.style.display = 'none';
                        if (editModal) editModal.style.display = 'none';
                    });
                }
            }

            const btnSaveAdd = document.getElementById('btn-save-add');
            if (btnSaveAdd) {
                btnSaveAdd.addEventListener('click', () => {
                    showLoader(); setTimeout(() => { hideLoader(); showToast('Lập hóa đơn thành công!'); addModal.style.display = 'none'; }, 1000);
                });
            }
            const btnSaveEdit = document.getElementById('btn-save-edit');
            if (btnSaveEdit) {
                btnSaveEdit.addEventListener('click', () => {
                    showLoader(); setTimeout(() => { hideLoader(); showToast('Cập nhật thành công!'); editModal.style.display = 'none'; }, 1000);
                });
            }

        });
    </script>

</body>

</html>