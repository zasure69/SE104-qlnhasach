      // --- 4. DATA GIẢ LẬP & LOGIC FORM ---
      async function findCustomer(maKH) {
        if (!maKH || typeof maKH !== "string") {
          // Trả về đối tượng rỗng an toàn nếu Mã KH rỗng
          return { HoVaTen: "", TongNo: 0, isValid: false };
        }

        // Loại bỏ khoảng trắng và chuyển thành chữ hoa nếu cần
        const cleanMaKH = maKH.trim();

        try {
          // GỌI API: Sử dụng endpoint /api/bill/customer/:id (đã có trong billRoutes.js)
          const response = await fetch(`/api/bill/customer/${cleanMaKH}`);

          if (!response.ok) {
            // Xử lý lỗi 404 (Không tìm thấy) hoặc 500 (Server Error)
            console.error(
              `Lỗi tìm khách hàng ${cleanMaKH}: ${response.status}`
            );
            return {
              HoVaTen: "Mã KH không tồn tại",
              TongNo: 0,
              isValid: false,
            };
          }

          const data = await response.json();
          // Trả về dữ liệu khách hàng (HoVaTen, TongNo)
          return {
            HoVaTen: data.HoVaTen,
            // TongNo từ DB là chuỗi, giữ nguyên hoặc chuyển đổi tại chỗ sử dụng
            TongNo: data.TongNo,
            isValid: true,
          };
        } catch (error) {
          console.error("Lỗi kết nối mạng khi tìm khách hàng:", error);
          return { HoVaTen: "Lỗi kết nối", TongNo: 0, isValid: false }; // Lỗi mạng/server
        }
      }
      async function findBookInfo(maSach) {
        if (!maSach || typeof maSach !== "string") return null;

        try {
          // Gọi API /api/bill/book/:id
          const response = await fetch(`/api/bill/book/${maSach.trim()}`);

          if (!response.ok) {
            return null; // Không tìm thấy sách hoặc lỗi server
          }
          // Trả về object { name, cat, price, stock }
          return await response.json();
        } catch (error) {
          console.error("Lỗi kết nối khi tìm sách:", error);
          return null;
        }
      }

      ["add", "edit"].forEach((prefix) => {
