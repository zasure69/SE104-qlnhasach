                        readonly> </div>
                    <div class="form-group"> <label>SL Bán:</label> <input type="number" id="edit-input-so-luong"
                            min="1"> </div>
                    <div class="form-group"> <label>&nbsp;</label> <button type="button" class="btn btn-primary"
                            id="btn-add-to-list-edit"> <i class="fas fa-plus"></i> Thêm </button> </div>
                </div>
                <div class="detail-table-wrapper">
                    <table class="detail-table" id="edit-detail-table">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Mã Sách</th>
                                <th>Tên Sách</th>
                                <th>Thể Loại</th>
                                <th>Số Lượng</th>
                                <th>Đơn Giá</th>
                                <th>Thành Tiền</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="summary-section">
                    <div class="summary-item"> <span class="summary-label">Tổng tiền:</span> <span
                            class="summary-value total" id="edit-total-amount">0</span> </div>
                    <div class="summary-item"> <span class="summary-label">Số tiền trả:</span> <input type="text"
                            id="edit-amount-paid" class="summary-value"
                            style="text-align: right; width: 150px; padding: 0.2rem;"> </div>
                    <div class="summary-item"> <span class="summary-label">Còn lại:</span> <span
