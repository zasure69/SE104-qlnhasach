      function generateMaHD(lastMaHD) {
        if (!lastMaHD) return "HD001"; // Bắt đầu nếu chưa có hóa đơn nào

        // 1. Lấy phần số (ví dụ: '123' từ 'HD123')
        const lastNumberStr = lastMaHD.replace("HD", "");
        const lastNumber = parseInt(lastNumberStr);

        // 2. Tính số tiếp theo
        const nextNumber = lastNumber + 1;

        // 3. Áp dụng quy tắc định dạng
        let newMaHD;
        if (nextNumber % 100 === 0) {
          // Nếu chia hết cho 100 (ví dụ: 100, 200)
          // Dùng số đó (cần đảm bảo 3 chữ số nếu dưới 1000)
          newMaHD = nextNumber.toString().padStart(3, "0");
        } else {
          // Nếu không chia hết cho 100 (ví dụ: 101, 199)
          // Lấy số dư và định dạng thành 3 chữ số
          const remainder = nextNumber % 100;
          // Padding: 1 -> '001', 99 -> '099', 101 -> '101'
          newMaHD = nextNumber.toString().padStart(3, "0");
        }

        return `HD${newMaHD}`;
      }
      // Lưu & Đóng
