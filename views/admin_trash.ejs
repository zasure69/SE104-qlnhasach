                        <td class="checkbox-col">
                          <input type="checkbox" class="row-checkbox-receipts" value="<%= r.MaPhieuThu %>" />
                        </td>
                        <td>
                          <%= r.MaPhieuThu %>
                        </td>
                        <td>
                          <%= r.KhachHang?.HoVaTen || '-' %>
                        </td>
                        <td>
                          <% if (r.isKhachHangDeleted) { %>
                            <span class="status-badge deleted" title="Khách hàng này đã bị xóa">
                              <i class="fas fa-exclamation-triangle"></i> Đã xóa
                            </span>
                          <% } else if (r.KhachHang) { %>
                            <span class="status-badge active">
                              <i class="fas fa-check"></i> Còn hoạt động
                            </span>
                          <% } else { %>
                            <span>-</span>
                          <% } %>
                        </td>
                        <td>
                          <%= new Date(r.NgayThuTien).toLocaleDateString('vi-VN') %>
                        </td>
                        <td>
                          <%= Number(r.SoTienThu || 0).toLocaleString('vi-VN') %> đ
                        </td>
                        <td>
                          <i class="fas fa-undo action-icon restore-icon"
