                          <%= inv.GhiChu || '-' %>
                        </td>
                        <td>
                          <button class="btn btn-sm btn-secondary view-detail-btn" onclick="viewInventoryDetail('<%= inv.MaPhieuKiem %>')">
                            <i class="fas fa-eye"></i> Chi tiết
