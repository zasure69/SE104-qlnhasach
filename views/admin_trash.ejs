  </div>

  <!-- Loader và Toast Container -->
  <div class="loader-overlay" id="loader">
    <div class="loader"></div>
  </div>
  <div class="toast-container" id="toast-container"></div>

  <!-- Modal Chi tiết - Style giống modal chỉnh sửa bills.ejs -->
  <div class="modal-overlay" id="detail-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="detail-modal-title">Chi tiết</h2>
        <button class="close-modal" onclick="closeDetailModal()"><i class="fas fa-times"></i></button>
      </div>
      <div class="modal-body" id="detail-modal-body">
        <!-- Nội dung chi tiết sẽ được render bởi JavaScript -->
      </div>
    </div>
  </div>

  <script>
    // Tab switching
    document.querySelectorAll(".tab-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        document
          .querySelectorAll(".tab-btn")
          .forEach((b) => b.classList.remove("active"));
        document
          .querySelectorAll(".tab-content")
          .forEach((c) => c.classList.remove("active"));

        btn.classList.add("active");
        document
          .getElementById("tab-" + btn.dataset.tab)
          .classList.add("active");
      });
    });

    // Toast notification
    const toastContainer = document.getElementById("toast-container");

    function showToast(message, type = "success") {
      if (!toastContainer) return;
      const toast = document.createElement("div");
      toast.classList.add("toast", type);
      toast.innerHTML = `<i class="fas ${type === "success" ? "fa-check-circle" : "fa-exclamation-circle"
        } toast-icon"></i><span class="toast-message">${message}</span>`;
      toastContainer.appendChild(toast);
      setTimeout(() => toast.classList.add("show"), 100);
      setTimeout(() => {
        toast.classList.remove("show");
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }

    // Toggle select all checkboxes
    function toggleSelectAll(type) {
      const selectAll = document.getElementById("selectAll-" + type);
      const checkboxes = document.querySelectorAll(".row-checkbox-" + type);
      checkboxes.forEach((cb) => (cb.checked = selectAll.checked));
    }

    // Get selected IDs
    function getSelectedIds(type) {
      const checkboxes = document.querySelectorAll(
        ".row-checkbox-" + type + ":checked"
      );
      return Array.from(checkboxes).map((cb) => cb.value);
    }

    // Restore single item
    async function restoreItem(url) {
      try {
        const response = await fetch(url, { method: "PATCH" });
        const data = await response.json();

        if (response.ok) {
          showToast(data.message || "Khôi phục thành công!");
          setTimeout(() => location.reload(), 1000);
        } else {
          showToast(data.error || data.message || "Có lỗi xảy ra!", "error");
        }
      } catch (err) {
        showToast("Lỗi kết nối server!", "error");
      }
    }

    // Restore Sách với kiểm tra đầu sách
    async function restoreSach(el) {
      const maSach = el.dataset.ma;
      const isDauSachDeleted = el.dataset.deleted === 'true';
      const tenDauSach = el.dataset.ten;
      const baseUrl = '/api/books/sach/restore/' + maSach;
      
      try {
        // Nếu đầu sách đã bị xóa, hỏi người dùng
        if (isDauSachDeleted) {
          const confirmMsg = `Đầu sách "${tenDauSach}" liên kết với sách này đã bị xóa.\n\nBạn có muốn khôi phục cả đầu sách không?\n\n- Nhấn OK: Khôi phục cả sách và đầu sách\n- Nhấn Cancel: Hủy thao tác`;
          
          if (confirm(confirmMsg)) {
            // Khôi phục cả sách và đầu sách
            const response = await fetch(baseUrl + '?restoreDauSach=true', { method: "PATCH" });
            const data = await response.json();
            
            if (response.ok) {
              showToast(data.message || "Khôi phục thành công!");
              setTimeout(() => location.reload(), 1000);
            } else {
              showToast(data.error || data.message || "Có lỗi xảy ra!", "error");
            }
          }
          // Nếu cancel, không làm gì
          return;
        }
        
        // Đầu sách không bị xóa, khôi phục bình thường
        await restoreItem(baseUrl);
        
      } catch (err) {
        console.error(err);
        showToast("Lỗi kết nối server!", "error");
      }
    }

    // Restore Đầu sách với kiểm tra thể loại
    async function restoreDauSach(el) {
      const maDauSach = el.dataset.ma;
      const isTheLoaiDeleted = el.dataset.deleted === 'true';
      const tenTheLoai = el.dataset.ten;
      const baseUrl = '/api/books/dausach/restore/' + maDauSach;
      
      try {
        if (isTheLoaiDeleted) {
          const confirmMsg = `Thể loại "${tenTheLoai}" liên kết với đầu sách này đã bị xóa.\n\nBạn có muốn khôi phục cả thể loại không?\n\n- Nhấn OK: Khôi phục cả đầu sách và thể loại\n- Nhấn Cancel: Hủy thao tác`;
          
          if (confirm(confirmMsg)) {
            const response = await fetch(baseUrl + '?restoreTheLoai=true', { method: "PATCH" });
            const data = await response.json();
            
            if (response.ok) {
              showToast(data.message || "Khôi phục thành công!");
              setTimeout(() => location.reload(), 1000);
            } else {
              showToast(data.error || data.message || "Có lỗi xảy ra!", "error");
            }
          }
          return;
        }
        
        await restoreItem(baseUrl);
      } catch (err) {
        console.error(err);
        showToast("Lỗi kết nối server!", "error");
      }
    }

    // Restore Hóa đơn với kiểm tra khách hàng
    async function restoreBill(el) {
      const maHoaDon = el.dataset.ma;
      const isKhachHangDeleted = el.dataset.deleted === 'true';
      const tenKhachHang = el.dataset.ten;
      const baseUrl = '/api/bill/admin/restore/' + maHoaDon;
      
      try {
        if (isKhachHangDeleted) {
          const confirmMsg = `Khách hàng "${tenKhachHang}" liên kết với hóa đơn này đã bị xóa.\n\nBạn có muốn khôi phục cả khách hàng không?\n\n- Nhấn OK: Khôi phục cả hóa đơn và khách hàng\n- Nhấn Cancel: Hủy thao tác`;
          
          if (confirm(confirmMsg)) {
            const response = await fetch(baseUrl + '?restoreKhachHang=true', { method: "PATCH" });
            const data = await response.json();
            
            if (response.ok) {
              showToast(data.message || "Khôi phục thành công!");
              setTimeout(() => location.reload(), 1000);
            } else {
              showToast(data.error || data.message || "Có lỗi xảy ra!", "error");
            }
          }
          return;
        }
        
        await restoreItem(baseUrl);
      } catch (err) {
        console.error(err);
        showToast("Lỗi kết nối server!", "error");
      }
    }

    // Restore Phiếu thu với kiểm tra khách hàng
    async function restoreReceipt(el) {
      const maPhieuThu = el.dataset.ma;
      const isKhachHangDeleted = el.dataset.deleted === 'true';
      const tenKhachHang = el.dataset.ten;
      const baseUrl = '/api/receipts/admin/restore/' + maPhieuThu;
      
      try {
        if (isKhachHangDeleted) {
          const confirmMsg = `Khách hàng "${tenKhachHang}" liên kết với phiếu thu này đã bị xóa.\n\nBạn có muốn khôi phục cả khách hàng không?\n\n- Nhấn OK: Khôi phục cả phiếu thu và khách hàng\n- Nhấn Cancel: Hủy thao tác`;
          
          if (confirm(confirmMsg)) {
            const response = await fetch(baseUrl + '?restoreKhachHang=true', { method: "PATCH" });
            const data = await response.json();
            
            if (response.ok) {
              showToast(data.message || "Khôi phục thành công!");
              setTimeout(() => location.reload(), 1000);
            } else {
              showToast(data.error || data.message || "Có lỗi xảy ra!", "error");
            }
          }
          return;
        }
        
        await restoreItem(baseUrl);
      } catch (err) {
        console.error(err);
        showToast("Lỗi kết nối server!", "error");
      }
    }

    // Restore Phiếu nhập với kiểm tra sách
    async function restoreImport(el) {
      const maPhieuNhap = el.dataset.ma;
      const hasDeletedSach = el.dataset.deleted === 'true';
      const deletedSachCount = parseInt(el.dataset.count) || 0;
      const baseUrl = '/api/import/admin/restore/' + maPhieuNhap;
      
      try {
        if (hasDeletedSach) {
          const confirmMsg = `Phiếu nhập này có ${deletedSachCount} sách đã bị xóa.\n\nBạn có muốn khôi phục cả các sách đó không?\n\n- Nhấn OK: Khôi phục cả phiếu nhập và các sách liên kết\n- Nhấn Cancel: Hủy thao tác`;
          
          if (confirm(confirmMsg)) {
            const response = await fetch(baseUrl + '?restoreSach=true', { method: "PATCH" });
            const data = await response.json();
            
            if (response.ok) {
              showToast(data.message || "Khôi phục thành công!");
              setTimeout(() => location.reload(), 1000);
            } else {
              showToast(data.error || data.message || "Có lỗi xảy ra!", "error");
            }
          }
          return;
        }
        
        await restoreItem(baseUrl);
      } catch (err) {
        console.error(err);
        showToast("Lỗi kết nối server!", "error");
      }
    }

    // Restore selected items
    async function restoreSelected(type, baseUrl) {
      const ids = getSelectedIds(type);
      if (ids.length === 0) {
        showToast("Vui lòng chọn ít nhất một mục!", "error");
        return;
      }

      for (const id of ids) {
        await restoreItem(baseUrl + "/" + id);
      }
    }

    // Confirm hard delete - sử dụng confirm đơn giản
    async function confirmHardDelete(url, el) {
      // el có thể là string (name) hoặc element với data-ten
      const name = typeof el === 'string' ? el : (el.dataset ? el.dataset.ten : el);
      if (
        !confirm(
          `Bạn có chắc chắn muốn xóa vĩnh viễn "${name}"?\n\n⚠️ Hành động này không thể hoàn tác!`
        )
      ) {
        return;
      }

      try {
        const response = await fetch(url, { method: "DELETE" });
        const data = await response.json();

        if (response.ok) {
          showToast(data.message || "Xóa vĩnh viễn thành công!");
          setTimeout(() => location.reload(), 1000);
        } else {
          showToast(data.error || data.message || "Có lỗi xảy ra!", "error");
        }
      } catch (err) {
        showToast("Lỗi kết nối server!", "error");
      }
    }

    // Hard delete selected items
    async function hardDeleteSelected(type, baseUrl) {
      const ids = getSelectedIds(type);
      if (ids.length === 0) {
        showToast("Vui lòng chọn ít nhất một mục!", "error");
        return;
      }

      if (
        !confirm(
          `Bạn có chắc chắn muốn xóa vĩnh viễn ${ids.length} mục đã chọn? Hành động này không thể hoàn tác!`
        )
      ) {
        return;
      }

      let successCount = 0;
      for (const id of ids) {
        try {
          const response = await fetch(baseUrl + "/" + id, {
            method: "DELETE",
          });
          if (response.ok) successCount++;
        } catch (err) {
          console.error(err);
        }
      }

      showToast(`Đã xóa vĩnh viễn ${successCount}/${ids.length} mục!`);
      setTimeout(() => location.reload(), 1000);
    }

    // Menu toggle for sidebar
    const menuToggle = document.getElementById("menu-toggle");
    const sidebar = document.getElementById("sidebar");
    const dashboardContainer = document.querySelector(".dashboard-container");

    if (menuToggle) {
      menuToggle.addEventListener("click", () => {
        if (window.innerWidth > 992) {
          dashboardContainer.classList.toggle("sidebar-collapsed");
        } else {
          sidebar.classList.toggle("active");
        }
      });
    }

    // ========== CHI TIẾT MODAL ==========
    const detailModal = document.getElementById('detail-modal');
    const detailModalTitle = document.getElementById('detail-modal-title');
    const detailModalBody = document.getElementById('detail-modal-body');

    function closeDetailModal() {
      detailModal.classList.remove('show');
    }

    // Đóng modal khi click bên ngoài
    detailModal.addEventListener('click', (e) => {
      if (e.target === detailModal) {
        closeDetailModal();
      }
    });

    // Format số tiền
    function formatCurrency(value) {
      return new Intl.NumberFormat('vi-VN').format(value || 0);
    }

    // Format ngày
    function formatDate(dateStr) {
      if (!dateStr) return '-';
      return new Date(dateStr).toLocaleDateString('vi-VN');
    }

    // Xem chi tiết phiếu nhập
    async function viewImportDetail(maPhieu) {
      try {
        const response = await fetch(`/api/import/${maPhieu}`);
        if (!response.ok) throw new Error('Không tìm thấy phiếu nhập');
        const data = await response.json();
        const receipt = data.receipt || data;

        detailModalTitle.textContent = `Chi tiết Phiếu Nhập Sách`;
        
        let detailHtml = `
          <div class="section-wrapper">
            <h3 class="section-header-title">Thông tin chung</h3>
            <div class="grid-general">
              <div class="form-group">
                <label>Mã Phiếu Nhập:</label>
                <span style="font-weight:bold">${receipt.MaPhieuNhap}</span>
              </div>
              <div class="form-group">
                <label>Ngày Nhập:</label>
                <span>${formatDate(receipt.NgayNhapPhieu)}</span>
              </div>
              <div class="form-group">
                <label>Nhân Viên Lập:</label>
                <span>${receipt.NhanVien?.HoTen || receipt.MaNhanVien || '-'}</span>
              </div>
            </div>
          </div>
          <div class="section-wrapper">
            <h3 class="section-header-title">Chi tiết sách nhập</h3>
            <div class="detail-table-wrapper">
              <table class="detail-table">
                <thead>
                  <tr>
                    <th>STT</th>
                    <th>Mã Sách</th>
                    <th>Tên Sách</th>
                    <th style="text-align:right">Số Lượng</th>
                    <th style="text-align:right">Đơn Giá Nhập</th>
                    <th style="text-align:right">Thành Tiền</th>
                  </tr>
                </thead>
                <tbody>
        `;

        let tongTien = 0;
        let tongSL = 0;
        const chiTiet = receipt.ChiTiet || [];
        
        chiTiet.forEach((ct, idx) => {
          const thanhTien = (ct.SoLuongNhap || 0) * (ct.DonGiaNhap || 0);
          tongTien += thanhTien;
          tongSL += ct.SoLuongNhap || 0;
          const tenSach = ct.Sach?.DauSach?.TenSach || ct.Sach?.MaSach || '-';
          const isDeleted = ct.Sach?.isDeleted;
          
          detailHtml += `
            <tr ${isDeleted ? 'style="background-color:#fff0f0"' : ''}>
              <td>${idx + 1}</td>
              <td>${ct.MaSach} ${isDeleted ? '<span class="status-badge deleted" style="font-size:0.65rem"><i class="fas fa-exclamation-triangle"></i> Đã xóa</span>' : ''}</td>
              <td>${tenSach}</td>
              <td style="text-align:right">${formatCurrency(ct.SoLuongNhap)}</td>
              <td style="text-align:right">${formatCurrency(ct.DonGiaNhap)}</td>
              <td style="text-align:right">${formatCurrency(thanhTien)}</td>
            </tr>
          `;
        });

        detailHtml += `
                </tbody>
                <tfoot>
                  <tr>
                    <td colspan="3" style="text-align:right"><strong>Tổng cộng:</strong></td>
                    <td style="text-align:right"><strong>${formatCurrency(tongSL)}</strong></td>
                    <td></td>
                    <td style="text-align:right"><strong>${formatCurrency(tongTien)} đ</strong></td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
        `;

        detailModalBody.innerHTML = detailHtml;
        detailModal.classList.add('show');
      } catch (err) {
        console.error(err);
        showToast('Lỗi khi tải chi tiết phiếu nhập!', 'error');
      }
    }

    // Xem chi tiết hóa đơn
    async function viewBillDetail(maHoaDon) {
      try {
        const response = await fetch(`/api/bill/${maHoaDon}`);
        if (!response.ok) throw new Error('Không tìm thấy hóa đơn');
        const data = await response.json();
        const bill = data.bill || data;

        detailModalTitle.textContent = `Chi tiết Hóa Đơn`;
        
        const conNo = (bill.TongTien || 0) - (bill.SoTienThu || 0);
        let detailHtml = `
          <div class="section-wrapper">
            <h3 class="section-header-title">Thông tin chung</h3>
            <div class="grid-general" style="grid-template-columns: 1fr 1fr 1fr 1.5fr">
              <div class="form-group">
                <label>Mã Hóa Đơn:</label>
                <span style="font-weight:bold">${bill.MaHoaDon}</span>
              </div>
              <div class="form-group">
                <label>Ngày Lập:</label>
                <span>${formatDate(bill.NgayLapHoaDon)}</span>
              </div>
              <div class="form-group">
                <label>Mã Khách Hàng:</label>
                <span>${bill.MaKhachHang || '-'}</span>
              </div>
              <div class="form-group">
                <label>Tên Khách Hàng:</label>
                <span>${bill.KhachHang?.HoVaTen || '-'}</span>
              </div>
              <div class="form-group">
                <label>Nhân Viên Lập:</label>
                <span>${bill.NhanVien?.HoTen || bill.MaNhanVien || '-'}</span>
              </div>
            </div>
          </div>
          <div class="section-wrapper">
            <h3 class="section-header-title">Chi tiết hóa đơn</h3>
            <div class="detail-table-wrapper">
              <table class="detail-table">
                <thead>
                  <tr>
                    <th>STT</th>
                    <th>Mã Sách</th>
                    <th>Tên Sách</th>
                    <th style="text-align:right">Số Lượng</th>
                    <th style="text-align:right">Đơn Giá</th>
                    <th style="text-align:right">Thành Tiền</th>
                  </tr>
                </thead>
                <tbody>
        `;

        const chiTiet = bill.ChiTiet || bill.CT_HD || [];
        
        chiTiet.forEach((ct, idx) => {
          const thanhTien = (ct.SoLuongBan || 0) * (ct.DonGiaBan || 0);
          const tenSach = ct.Sach?.DauSach?.TenSach || ct.Sach?.MaSach || '-';
          
          detailHtml += `
            <tr>
              <td>${idx + 1}</td>
              <td>${ct.MaSach}</td>
              <td>${tenSach}</td>
              <td style="text-align:right">${formatCurrency(ct.SoLuongBan)}</td>
              <td style="text-align:right">${formatCurrency(ct.DonGiaBan)}</td>
              <td style="text-align:right">${formatCurrency(thanhTien)}</td>
            </tr>
          `;
        });

        detailHtml += `
                </tbody>
              </table>
            </div>
          </div>
          <div class="section-wrapper">
            <h3 class="section-header-title">Thông tin thanh toán</h3>
            <div class="grid-payment">
              <div class="payment-item">
                <span class="summary-label">Tổng tiền:</span>
                <span class="summary-value total" style="font-size:1.2rem">${formatCurrency(bill.TongTien)} đ</span>
              </div>
              <div class="payment-item">
                <span class="summary-label">Số tiền đã trả:</span>
                <span class="summary-value paid" style="font-size:1.2rem">${formatCurrency(bill.SoTienThu)} đ</span>
              </div>
              <div class="payment-item">
                <span class="summary-label">Còn nợ:</span>
                <span class="summary-value debt" style="font-size:1.2rem;color:${conNo > 0 ? '#e74c3c' : '#27ae60'}">${formatCurrency(conNo)} đ</span>
              </div>
            </div>
          </div>
        `;

        detailModalBody.innerHTML = detailHtml;
        detailModal.classList.add('show');
      } catch (err) {
        console.error(err);
        showToast('Lỗi khi tải chi tiết hóa đơn!', 'error');
      }
    }

    // Xem chi tiết phiếu kiểm kê
    async function viewInventoryDetail(maPhieu) {
      try {
        const response = await fetch(`/api/inventory/${maPhieu}`);
        if (!response.ok) throw new Error('Không tìm thấy phiếu kiểm kê');
        const data = await response.json();
        const phieu = data.receipt || data;

        detailModalTitle.textContent = `Chi tiết Phiếu Kiểm Kê`;
        
        let detailHtml = `
          <div class="section-wrapper">
            <h3 class="section-header-title" style="color:#e74c3c">THÔNG TIN CHUNG</h3>
            <div class="grid-general">
              <div class="form-group">
                <label>Mã Phiếu Kiểm:</label>
                <span style="font-weight:bold">${phieu.MaPhieuKiem || '-'}</span>
              </div>
              <div class="form-group">
                <label>Ngày Kiểm:</label>
                <span>${formatDate(phieu.NgayKiem)}</span>
              </div>
              <div class="form-group">
                <label>Nhân Viên Lập:</label>
                <span>${phieu.NhanVien?.HoTen || phieu.MaNhanVien || '-'}</span>
              </div>
              <div class="form-group">
                <label>Ghi Chú:</label>
                <span>${phieu.GhiChu || '-'}</span>
              </div>
            </div>
          </div>
          <div class="section-wrapper">
            <h3 class="section-header-title" style="color:#e74c3c">CHI TIẾT KIỂM KÊ</h3>
            <div class="detail-table-wrapper">
              <table class="detail-table">
                <thead>
                  <tr>
                    <th>STT</th>
                    <th>Mã Sách</th>
                    <th>Tên Sách</th>
                    <th style="text-align:right">SL Hệ Thống</th>
                    <th style="text-align:right">SL Thực Tế</th>
                    <th style="text-align:right">Chênh Lệch</th>
                  </tr>
                </thead>
                <tbody>
        `;

        const chiTiet = phieu.ChiTiet || [];
        
        if (chiTiet.length === 0) {
          detailHtml += `
            <tr>
              <td colspan="6" style="text-align:center;color:#999">Không có chi tiết kiểm kê</td>
            </tr>
          `;
        } else {
          chiTiet.forEach((ct, idx) => {
            const chenhLech = (ct.SoLuongThucTe || 0) - (ct.SoLuongHeThong || 0);
            const tenSach = ct.Sach?.DauSach?.TenSach || ct.Sach?.MaSach || '-';
            
            detailHtml += `
              <tr>
                <td>${idx + 1}</td>
                <td>${ct.MaSach}</td>
                <td>${tenSach}</td>
                <td style="text-align:right">${formatCurrency(ct.SoLuongHeThong)}</td>
                <td style="text-align:right">${formatCurrency(ct.SoLuongThucTe)}</td>
                <td style="text-align:right;color:${chenhLech !== 0 ? (chenhLech > 0 ? '#27ae60' : '#e74c3c') : 'inherit'}">
                  ${chenhLech > 0 ? '+' : ''}${formatCurrency(chenhLech)}
                </td>
              </tr>
            `;
          });
        }

        detailHtml += `
                </tbody>
              </table>
            </div>
          </div>
        `;

        // Hiển thị chi tiết lý do nếu có
        const lyDoItems = [];
        chiTiet.forEach(ct => {
          if (ct.DanhSachLyDo && ct.DanhSachLyDo.length > 0) {
            ct.DanhSachLyDo.forEach(lyDo => {
              lyDoItems.push({
                MaSach: ct.MaSach,
                TenSach: ct.Sach?.DauSach?.TenSach || ct.Sach?.MaSach || '-',
                TenLyDo: lyDo.LoaiLyDoKiemKe?.TenLyDo || lyDo.LyDoKhac || '-',
                LyDoKhac: lyDo.LyDoKhac,
                SoLuong: lyDo.SoLuong || 0
              });
            });
          }
        });

        if (lyDoItems.length > 0) {
          detailHtml += `
            <div class="section-wrapper">
              <h3 class="section-header-title" style="color:#e74c3c">CHI TIẾT LÝ DO CHÊNH LỆCH</h3>
              <div class="detail-table-wrapper">
                <table class="detail-table">
                  <thead>
                    <tr>
                      <th>STT</th>
                      <th>Mã Sách</th>
                      <th>Tên Sách</th>
                      <th>Lý Do</th>
                      <th style="text-align:right">Số Lượng</th>
                    </tr>
                  </thead>
                  <tbody>
          `;

          lyDoItems.forEach((item, idx) => {
            const lyDoDisplay = item.LyDoKhac ? `${item.TenLyDo} (${item.LyDoKhac})` : item.TenLyDo;
            detailHtml += `
              <tr>
                <td>${idx + 1}</td>
                <td>${item.MaSach}</td>
                <td>${item.TenSach}</td>
                <td>${lyDoDisplay}</td>
                <td style="text-align:right">${formatCurrency(item.SoLuong)}</td>
              </tr>
            `;
          });

          detailHtml += `
                  </tbody>
                </table>
              </div>
            </div>
          `;
        }

        detailModalBody.innerHTML = detailHtml;
        detailModal.classList.add('show');
      } catch (err) {
        console.error(err);
        showToast('Lỗi khi tải chi tiết phiếu kiểm kê!', 'error');
      }
    }
  </script>
</body>

</html>