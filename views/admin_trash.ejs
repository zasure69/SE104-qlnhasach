                        <input type="checkbox" id="selectAll-inventory" onchange="toggleSelectAll('inventory')" />
                      </th>
                      <th>Mã Phiếu</th>
                      <th>Người lập</th>
                      <th>Ngày kiểm</th>
                      <th>Ghi chú</th>
                      <th>Thao tác</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% deletedInventory.forEach(inv=> { %>
                      <tr data-id="<%= inv.MaPhieuKiem %>">
                        <td class="checkbox-col">
                          <input type="checkbox" class="row-checkbox-inventory" value="<%= inv.MaPhieuKiem %>" />
                        </td>
                        <td>
                          <%= inv.MaPhieuKiem %>
                        </td>
