        </div>
      </main>
    </div>

    <!-- --- MODAL THÊM MỚI / CHỈNH SỬA (Dùng chung cấu trúc, khác ID) --- -->

    <!-- Modal Thêm Mới -->
    <div class="modal-overlay" id="add-modal">
      <div class="modal-content">
        <div class="modal-header">
          <h2>Lập Phiếu Nhập Sách Mới</h2>
          <button class="close-modal"><i class="fas fa-times"></i></button>
        </div>
        <div class="modal-body">
          <!-- 1. Thông tin chung (Header) -->
          <div class="form-section">
            <h3>Thông tin chung</h3>
            <div class="modal-form-grid">
              <div class="form-group">
                <label>Mã Phiếu:</label>
                <input type="text" value="Tự động" disabled />
              </div>
              <div class="form-group">
                <label>Ngày Nhập:</label>
                <input type="date" id="add-ngay-nhap" />
              </div>
              <div class="form-group">
                <label>Mã Nhân Viên:</label>
                <input type="text" id="add-ma-nv" placeholder="NV..." />
              </div>
            </div>
          </div>

          <!-- 2. Khu vực nhập liệu chi tiết (Input Area) -->
          <div class="add-book-area">
            <div class="form-group">
              <label>Mã Sách:</label>
              <input
                type="text"
                id="add-input-ma-sach"
                placeholder="Nhập mã sách..."
              />
            </div>
            <div class="form-group">
              <label>Sách:</label>
              <input
                type="text"
                id="add-input-ten-sach"
                placeholder="Tên sách..."
                disabled
              />
            </div>
            <div class="form-group">
              <label>Số Lượng:</label>
              <input type="number" id="add-input-so-luong" min="1" value="1" />
            </div>
            <div class="form-group">
              <label>Đơn Giá Nhập:</label>
              <input type="text" id="add-input-don-gia" placeholder="0" />
            </div>
            <div class="form-group">
              <label>&nbsp;</label>
              <button
                type="button"
                class="btn btn-primary"
                id="btn-add-to-list"
              >
                <i class="fas fa-plus"></i> Thêm
              </button>
            </div>
          </div>

          <!-- 3. Bảng chi tiết (Detail Table) -->
          <div class="detail-table-wrapper">
            <table class="detail-table" id="add-detail-table">
              <thead>
                <tr>
                  <th>STT</th>
                  <th>Mã Sách</th>
                  <th>Tên Sách</th>
                  <th>Số Lượng</th>
                  <th>Đơn Giá</th>
                  <th>Thành Tiền</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <!-- Rows will be added here -->
              </tbody>
              <tfoot>
                <tr>
                  <td colspan="5" style="text-align: right">Tổng cộng:</td>
                  <td colspan="2" id="add-total-amount">0</td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary close-modal">
            Hủy
          </button>
          <button type="button" class="btn btn-primary" id="btn-save-add">
            Lưu
          </button>
        </div>
      </div>
    </div>

    <!-- Modal Chỉnh Sửa (Có nút xóa) -->
    <div class="modal-overlay" id="edit-modal">
      <div class="modal-content">
        <div class="modal-header">
          <h2>Chi Tiết / Chỉnh Sửa Phiếu Nhập</h2>
          <button class="close-modal"><i class="fas fa-times"></i></button>
        </div>
        <div class="modal-body">
          <!-- 1. Thông tin chung -->
          <div class="form-section">
            <div class="modal-form-grid">
              <div class="form-group">
                <label>Mã Phiếu:</label>
                <input type="text" id="edit-ma-phieu" disabled />
              </div>
              <div class="form-group">
                <label>Ngày Nhập:</label>
                <input type="date" id="edit-ngay-nhap" />
              </div>
              <div class="form-group">
                <label>Mã Nhân Viên:</label>
                <input type="text" id="edit-ma-nv" />
              </div>
            </div>
          </div>

          <!-- 2. Khu vực nhập liệu (Giống Add) -->
          <div class="add-book-area">
            <div class="form-group">
              <label>Mã Sách:</label>
              <input type="text" id="edit-input-ma-sach" />
            </div>
            <div class="form-group">
              <label>Sách:</label>
              <input type="text" id="edit-input-ten-sach" disabled />
            </div>
            <div class="form-group">
              <label>Số Lượng:</label>
              <input type="number" id="edit-input-so-luong" min="1" />
            </div>
            <div class="form-group">
              <label>Đơn Giá Nhập:</label>
              <input type="text" id="edit-input-don-gia" />
            </div>
            <div class="form-group">
              <label>&nbsp;</label>
              <button
                type="button"
                class="btn btn-primary"
                id="btn-add-to-list-edit"
              >
                <i class="fas fa-plus"></i> Thêm
              </button>
            </div>
          </div>

          <!-- 3. Bảng chi tiết -->
          <div class="detail-table-wrapper">
            <table class="detail-table" id="edit-detail-table">
              <thead>
                <tr>
                  <th>STT</th>
                  <th>Mã Sách</th>
                  <th>Tên Sách</th>
                  <th>Số Lượng</th>
                  <th>Đơn Giá</th>
                  <th>Thành Tiền</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <!-- Rows filled by JS -->
              </tbody>
              <tfoot>
                <tr>
                  <td colspan="5" style="text-align: right">Tổng cộng:</td>
                  <td colspan="2" id="edit-total-amount">0</td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-danger" id="btn-delete-slip">
            Xóa Phiếu nhập sách
          </button>
          <div>
            <button type="button" class="btn btn-secondary close-modal">
              Hủy
            </button>
            <button type="button" class="btn btn-primary" id="btn-save-edit">
              Lưu
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        // --- Utilities ---
        const loader = document.getElementById("loader");
        const toastContainer = document.getElementById("toast-container");
        function showLoader() {
          loader.style.display = "flex";
        }
        function hideLoader() {
          loader.style.display = "none";
        }
        function showToast(message, type = "success") {
          const toast = document.createElement("div");
          toast.classList.add("toast", type);
          toast.innerHTML = `<i class="fas ${
            type === "success" ? "fa-check-circle" : "fa-exclamation-circle"
          } toast-icon"></i><span class="toast-message">${message}</span>`;
          toastContainer.appendChild(toast);
          setTimeout(() => {
            toast.classList.add("show");
          }, 100);
          setTimeout(() => {
            toast.classList.remove("show");
            setTimeout(() => toast.remove(), 300);
          }, 3000);
        }
        function formatNumber(num) {
          return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
        }
        function parseNumber(str) {
          return parseFloat(str.replace(/\./g, "")) || 0;
        }

        // --- Sidebar ---
        const menuToggle = document.getElementById("menu-toggle");
        const sidebar = document.getElementById("sidebar");
        const container = document.querySelector(".dashboard-container");
        if (menuToggle)
          menuToggle.addEventListener("click", () => {
            if (window.innerWidth <= 992) sidebar.classList.toggle("active");
            else container.classList.toggle("sidebar-collapsed");
          });

        // --- Logic cho Modal Thêm/Sửa Chi tiết ---

        // Hàm tìm thông tin sách giả lập
        function findBookInfo(maSach) {
          const books = {
            S001: "Mắt biếc",
            S002: "Harry Potter",
            S003: "Đắc nhân tâm",
          };
          return books[maSach.toUpperCase()] || "";
        }

        // Xử lý input mã sách (Auto-fill tên sách)
        const prefixes = ["add", "edit"];

        // Dùng vòng lặp for...of thay vì forEach để an toàn hơn
        for (const prefix of prefixes) {
          const maSachInput = document.getElementById(
            `${prefix}-input-ma-sach`
          );
          const tenSachInput = document.getElementById(
            `${prefix}-input-ten-sach`
          );

          if (maSachInput && tenSachInput) {
            maSachInput.addEventListener("blur", function () {
              const bookName = findBookInfo(this.value);
              tenSachInput.value = bookName;
            });
          }
        }

        // Hàm thêm dòng vào bảng chi tiết
        function addRowToDetailTable(tableId, totalId, data) {
          const tableBody = document.querySelector(`#${tableId} tbody`);
          if (!tableBody) return;

          const newRow = tableBody.insertRow();
          const thanhTien = data.soLuong * data.donGia;

          newRow.innerHTML = `
                    <td>${tableBody.rows.length}</td>
                    <td>${data.maSach}</td>
                    <td>${data.tenSach}</td>
                    <td>${data.soLuong}</td>
                    <td>${formatNumber(data.donGia)}</td>
                    <td class="row-total" data-value="${thanhTien}">${formatNumber(
            thanhTien
          )}</td>
                    <td><i class="fas fa-trash action-icon text-red" style="color: #e74c3c;" onclick="this.closest('tr').remove(); updateTotal('${tableId}', '${totalId}')"></i></td>
                `;
          updateTotal(tableId, totalId);
        }

        // Hàm cập nhật tổng tiền modal
        window.updateTotal = function (tableId, totalId) {
          const rows = document.querySelectorAll(`#${tableId} .row-total`);
          let total = 0;
          // forEach trên NodeList là an toàn, nhưng nếu rows rỗng thì không chạy
          if (rows) {
            for (let i = 0; i < rows.length; i++) {
              total += parseFloat(rows[i].dataset.value);
            }
          }
          const totalEl = document.getElementById(totalId);
          if (totalEl) {
            totalEl.textContent = formatNumber(total);
          }
        };

        // Xử lý nút "Thêm" (vào bảng tạm)
        for (const prefix of prefixes) {
          const btnId = `btn-add-to-list${prefix === "edit" ? "-edit" : ""}`;
          const addToBtn = document.getElementById(btnId);

          if (addToBtn) {
            addToBtn.addEventListener("click", function () {
              const maSachInput = document.getElementById(
                `${prefix}-input-ma-sach`
              );
              const tenSachInput = document.getElementById(
                `${prefix}-input-ten-sach`
              );
              const soLuongInput = document.getElementById(
                `${prefix}-input-so-luong`
              );
              const donGiaInput = document.getElementById(
                `${prefix}-input-don-gia`
              );

              if (
                !maSachInput ||
                !tenSachInput ||
                !soLuongInput ||
                !donGiaInput
              )
                return;

              const maSach = maSachInput.value;
              const tenSach = tenSachInput.value;
              const soLuong = parseInt(soLuongInput.value);
              const donGia = parseFloat(donGiaInput.value);

              if (!maSach || !soLuong || !donGia) {
                showToast("Vui lòng nhập đầy đủ thông tin sách!", "error");
                return;
              }

              addRowToDetailTable(
                `${prefix}-detail-table`,
                `${prefix}-total-amount`,
                {
                  maSach,
                  tenSach,
                  soLuong,
                  donGia,
                }
              );

              // Reset input
              maSachInput.value = "";
              tenSachInput.value = "";
              soLuongInput.value = "1";
              donGiaInput.value = "";
              maSachInput.focus();
            });
          }
        }

        // --- Xử lý Mở/Đóng Modal ---
        const addModal = document.getElementById("add-modal");
        const editModal = document.getElementById("edit-modal");
        const openAddBtn = document.getElementById("open-add-modal");

        // Mở modal thêm mới
        if (openAddBtn && addModal) {
          openAddBtn.addEventListener("click", () => {
            // Reset form và bảng
            const tbody = document.querySelector("#add-detail-table tbody");
            if (tbody) tbody.innerHTML = "";

            const totalEl = document.getElementById("add-total-amount");
            if (totalEl) totalEl.textContent = "0";

            const dateInput = document.getElementById("add-ngay-nhap");
            if (dateInput) dateInput.valueAsDate = new Date();

            addModal.style.display = "flex";
          });
        }

        // Mở modal xem/sửa (giả lập dữ liệu)
        const viewDetailBtns = document.querySelectorAll(".view-detail-btn");
        if (viewDetailBtns.length > 0) {
          // Sử dụng vòng lặp for...of thay vì forEach
          for (const btn of viewDetailBtns) {
            btn.addEventListener("click", function () {
              const maPhieu = this.dataset.id;
              // Giả lập load dữ liệu chi tiết
              const maPhieuInput = document.getElementById("edit-ma-phieu");
              const ngayNhapInput = document.getElementById("edit-ngay-nhap");
              const maNvInput = document.getElementById("edit-ma-nv");

              if (maPhieuInput) maPhieuInput.value = maPhieu;
              if (ngayNhapInput) ngayNhapInput.value = "2024-11-10"; // Giả lập
              if (maNvInput) maNvInput.value = "NV01";

              // Xóa bảng cũ và thêm dữ liệu mẫu
              const tbody = document.querySelector("#edit-detail-table tbody");
              if (tbody) {
                tbody.innerHTML = "";
                // Dữ liệu mẫu
                addRowToDetailTable("edit-detail-table", "edit-total-amount", {
                  maSach: "S001",
                  tenSach: "Mắt biếc",
                  soLuong: 2,
                  donGia: 10000,
                });
              }

              if (editModal) editModal.style.display = "flex";
            });
          }
        }

        // Đóng modal
        const closeBtns = document.querySelectorAll(".close-modal");
        if (closeBtns.length > 0) {
          for (const btn of closeBtns) {
            btn.addEventListener("click", () => {
              if (addModal) addModal.style.display = "none";
              if (editModal) editModal.style.display = "none";
            });
          }
        }

        // --- Xử lý Lưu Phiếu ---
        const saveAddBtn = document.getElementById("btn-save-add");
        if (saveAddBtn) {
          saveAddBtn.addEventListener("click", () => {
            showLoader();
            setTimeout(() => {
              hideLoader();
              showToast("Đã lập phiếu nhập thành công!", "success");
              if (addModal) addModal.style.display = "none";
            }, 1000);
          });
        }

        const saveEditBtn = document.getElementById("btn-save-edit");
        if (saveEditBtn) {
          saveEditBtn.addEventListener("click", () => {
            showLoader();
            setTimeout(() => {
              hideLoader();
              showToast("Đã cập nhật phiếu nhập!", "success");
              if (editModal) editModal.style.display = "none";
            }, 1000);
          });
        }

        const deleteSlipBtn = document.getElementById("btn-delete-slip");
        if (deleteSlipBtn) {
          deleteSlipBtn.addEventListener("click", () => {
            if (confirm("Bạn có chắc chắn muốn xóa phiếu nhập này?")) {
              showLoader();
              setTimeout(() => {
                hideLoader();
                showToast("Đã xóa phiếu nhập!", "success");
                if (editModal) editModal.style.display = "none";
              }, 1000);
            }
          });
        }
      });
    </script>
  </body>
</html>
