                    <button
                      class="btn btn-sm btn-secondary view-detail-btn"
                      data-id="PN002"
                    >
                      <i class="fas fa-eye"></i> Chi tiết
                    </button>
                    <button
                      class="btn btn-sm btn-print ml-2"
                      onclick="alert('Chức năng in hóa đơn HD001')"
                    >
                      <i class="fas fa-print"></i>
                    </button>
