<script>
// Thêm đầu sách mới
function openAddDauSachModal() {
  document.getElementById('dauSachForm').reset();
  document.getElementById('dauSachId').value = '';
  document.getElementById('dauSachModalLabel').textContent = 'Thêm Đầu Sách';
  new bootstrap.Modal(document.getElementById('dauSachModal')).show();
}

// Sửa đầu sách
function openEditDauSachModal(dauSach) {
  document.getElementById('dauSachId').value = dauSach.MaDauSach;
  document.getElementById('tenSach').value = dauSach.TenSach;
  document.getElementById('tenTheLoai').value = dauSach.TenTheLoai || '';
  document.getElementById('tacGiaIds').value = dauSach.TacGiaNames || '';
  document.getElementById('moTa').value = dauSach.MoTa || '';
  document.getElementById('dauSachModalLabel').textContent = 'Sửa Đầu Sách';
  new bootstrap.Modal(document.getElementById('dauSachModal')).show();
}

// Lưu đầu sách (thêm/sửa)
async function saveDauSach() {
  const maDauSach = document.getElementById('dauSachId').value;
  const formData = {
    TenSach: document.getElementById('tenSach').value.trim(),
    TenTheLoai: document.getElementById('tenTheLoai').value.trim(),
    tacGiaIds: [document.getElementById('tacGiaIds').value.trim()],
    MoTa: document.getElementById('moTa').value.trim()
  };

  if (!formData.TenSach || !formData.TenTheLoai || !formData.tacGiaIds[0]) {
    alert('Vui lòng nhập đầy đủ thông tin bắt buộc!');
    return;
  }

  try {
    const url = maDauSach ? `/dausach/${maDauSach}` : '/dausach';
    const method = maDauSach ? 'PUT' : 'POST';
    
    const response = await fetch(url, {
      method: method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formData)
    });

    const data = await response.json();
    
    if (response.ok) {
      alert(data.message || 'Lưu đầu sách thành công!');
      bootstrap.Modal.getInstance(document.getElementById('dauSachModal')).hide();
      location.reload();
    } else {
      alert(data.error || 'Có lỗi xảy ra!');
    }
  } catch (error) {
    console.error('Error:', error);
    alert('Lỗi kết nối server!');
  }
}

// Mở modal xác nhận xóa
function openDeleteDauSachModal(maDauSach) {
  document.getElementById('deleteDauSachId').value = maDauSach;
  new bootstrap.Modal(document.getElementById('deleteDauSachModal')).show();
}

// Xác nhận xóa
async function confirmDeleteDauSach() {
  const maDauSach = document.getElementById('deleteDauSachId').value;
  
  try {
    const response = await fetch(`/dausach/${maDauSach}`, {
      method: 'DELETE'
    });

    const data = await response.json();
    
    if (response.ok) {
      alert(data.message || 'Xóa đầu sách thành công!');
      bootstrap.Modal.getInstance(document.getElementById('deleteDauSachModal')).hide();
      location.reload();
    } else {
      alert(data.error || 'Có lỗi xảy ra!');
    }
  } catch (error) {
    console.error('Error:', error);
    alert('Lỗi kết nối server!');
  }
}
</script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // --- HELPER FUNCTIONS ---
    const loader = document.getElementById('loader');
    const toastContainer = document.getElementById('toast-container');
    let currentEditingRow = null;
    
    function showLoader() { if(loader) loader.style.display = 'flex'; }
    function hideLoader() { if(loader) loader.style.display = 'none'; }
    
    function showToast(message, type = 'success') {
        if(!toastContainer) return;
        const toast = document.createElement('div');
        toast.classList.add('toast', type);
        toast.innerHTML = `<i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} toast-icon"></i><span class="toast-message">${message}</span>`;
        toastContainer.appendChild(toast);
        setTimeout(() => toast.classList.add('show'), 100);
        setTimeout(() => {
            toast.classList.remove('show');
            setTimeout(() => toast.remove(), 300);
        }, 3000);
    }

    function collectAuthorIds(wrapper) {
        return Array.from(wrapper.querySelectorAll('.author-tag'))
            .map(tag => {
                const id = tag.dataset.id;
                const name = tag.textContent.replace('×', '').trim();
                return id && id.startsWith('TG') ? id : name;
            })
            .filter(Boolean);
    }

    // --- TAB SWITCHING ---
    const tabButtons = document.querySelectorAll('.tab-button');
    const tabPanes = document.querySelectorAll('.tab-pane');
    
    tabButtons.forEach(button => {
        button.addEventListener('click', function() {
            const targetId = this.dataset.target; 
            const targetPane = document.querySelector(targetId);
            if (targetPane) {
                tabButtons.forEach(btn => btn.classList.remove('active'));
                tabPanes.forEach(pane => pane.classList.remove('active'));
                this.classList.add('active');
                targetPane.classList.add('active');
            }
        });
    });

    // --- ĐẦU SÁCH: THÊM MỚI ---
    const addDauSachBtn = document.getElementById('open-dausach-add-modal');
    const addDauSachModal = document.getElementById('dausach-add-modal');
    const addDauSachForm = document.getElementById('add-dausach-form');

    if(addDauSachBtn && addDauSachModal) {
        addDauSachBtn.addEventListener('click', () => {
            if(addDauSachForm) addDauSachForm.reset();
            document.getElementById('add-author-wrapper').querySelectorAll('.author-tag').forEach(tag => tag.remove());
            addDauSachModal.style.display = 'flex';
        });
    }

    if(addDauSachForm) {
        addDauSachForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = {
                TenSach: document.getElementById('add-ten-sach-ds').value.trim(),
                TenTheLoai: document.getElementById('add-ma-the-loai-ds').value.trim(),
                tacGiaIds: collectAuthorIds(document.getElementById('add-author-wrapper')),
                MoTa: document.getElementById('add-mo-ta-ds').value.trim()
            };

            if (!formData.tacGiaIds || formData.tacGiaIds.length === 0) {
                showToast('Vui lòng chọn ít nhất một tác giả!', 'error');
                return;
            }

            console.log('[DEBUG] Calling POST /api/books/createDauSach with:', formData);
            showLoader();
            try {
                const response = await fetch('/api/books/createDauSach', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });
                const data = await response.json();
                hideLoader();
                
                console.log('[DEBUG] Response:', response.status, data);
                if(response.ok) {
                    showToast(data.message || 'Thêm đầu sách thành công!');
                    addDauSachModal.style.display = 'none';
                    location.reload();
                } else {
                    showToast(data.error || 'Có lỗi xảy ra!', 'error');
                }
            } catch(error) {
                hideLoader();
                console.error('[ERROR] createDauSach:', error);
                showToast('Lỗi kết nối server!', 'error');
            }
        });
    }

    // --- ĐẦU SÁCH: CHỈNH SỬA ---
    const editDauSachModal = document.getElementById('dausach-edit-modal');
    const editDauSachForm = document.getElementById('edit-dausach-form');

    document.querySelectorAll('.open-dausach-edit-modal').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const row = e.target.closest('tr');
            if(!row) return;
            
            const cells = row.cells;
            document.getElementById('edit-ma-ds').value = cells[1].textContent;
            document.getElementById('edit-ten-sach-ds').value = cells[2].textContent;
            document.getElementById('edit-ma-the-loai-ds').value = cells[3].textContent;
            document.getElementById('edit-mo-ta-ds').value = cells[5].textContent;
            
            const editWrapper = document.getElementById('edit-author-wrapper');
            editWrapper.querySelectorAll('.author-tag').forEach(tag => tag.remove());
            const authors = cells[4].textContent.split(',').map(a => a.trim());
            authors.forEach(authorName => {
                if(authorName) {
                    const tagHTML = `<span class="author-tag" data-id="">${authorName}<span class="remove-tag">×</span></span>`;
                    editWrapper.querySelector('.author-select-btn').insertAdjacentHTML('beforebegin', tagHTML);
                }
            });
            
            editDauSachModal.style.display = 'flex';
        });
    });

    if(editDauSachForm) {
        editDauSachForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const maDS = document.getElementById('edit-ma-ds').value;
            const formData = {
                TenSach: document.getElementById('edit-ten-sach-ds').value.trim(),
                TenTheLoai: document.getElementById('edit-ma-the-loai-ds').value.trim(),
                tacGiaIds: collectAuthorIds(document.getElementById('edit-author-wrapper')),
                MoTa: document.getElementById('edit-mo-ta-ds').value.trim()
            };

            if (!formData.tacGiaIds || formData.tacGiaIds.length === 0) {
                showToast('Vui lòng chọn ít nhất một tác giả!', 'error');
                return;
            }

            console.log(`[DEBUG] Calling PATCH /api/books/updateDauSach/${maDS} with:`, formData);
            showLoader();
            try {
                const response = await fetch(`/api/books/updateDauSach/${maDS}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });
                const data = await response.json();
                hideLoader();
                
                console.log('[DEBUG] Response:', response.status, data);
                if(response.ok) {
                    showToast(data.message || 'Cập nhật thành công!');
                    editDauSachModal.style.display = 'none';
                    location.reload();
                } else {
                    showToast(data.error || 'Có lỗi xảy ra!', 'error');
                }
            } catch(error) {
                hideLoader();
                console.error('[ERROR] updateDauSach:', error);
                showToast('Lỗi kết nối server!', 'error');
            }
        });
    }

    // --- ĐẦU SÁCH: XÓA ---
    document.querySelectorAll('.delete-dausach-icon').forEach(btn => {
        btn.addEventListener('click', async (e) => {
            const row = e.target.closest('tr');
            if(!row) return;
            
            const maDS = row.dataset.id;
            const tenSach = row.cells[2].textContent;
            
            if(!confirm(`Bạn có chắc chắn muốn xóa đầu sách: ${tenSach}?`)) return;
            
            console.log(`[DEBUG] Calling DELETE /api/books/deleteDauSach/${maDS}`);
            showLoader();
            try {
                const response = await fetch(`/api/books/deleteDauSach/${maDS}`, {
                    method: 'DELETE'
                });
                const data = await response.json();
                hideLoader();
                
                console.log('[DEBUG] Response:', response.status, data);
                if(response.ok) {
                    showToast(data.message || 'Xóa thành công!');
                    row.remove();
                } else {
                    showToast(data.error || 'Có lỗi xảy ra!', 'error');
                }
            } catch(error) {
                hideLoader();
                console.error('[ERROR] deleteDauSach:', error);
                showToast('Lỗi kết nối server!', 'error');
            }
        });
    });

    // --- MODAL CHỌN TÁC GIẢ ---
    const authorModal = document.getElementById('author-select-modal');
    const openAuthorSelectBtns = document.querySelectorAll('.open-author-select');
    const closeAuthorModalBtns = document.querySelectorAll('#author-select-modal .close-modal');
    const confirmAuthorsBtn = document.getElementById('confirm-authors');
    const authorChecklist = document.getElementById('author-checklist');
    const authorSearchInput = document.getElementById('author-search-input');
    const newAuthorInput = document.getElementById('new-author-input');
    const addNewAuthorBtn = document.getElementById('add-new-author-btn');
    let currentAuthorWrapper = null;
    let tempNewAuthors = [];

    openAuthorSelectBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
            currentAuthorWrapper = e.target.closest('.author-select-wrapper');
            tempNewAuthors = [];
            
            const selectedIds = [];
            currentAuthorWrapper.querySelectorAll('.author-tag').forEach(tag => {
                const id = tag.dataset.id;
                const name = tag.textContent.replace('×', '').trim();
                if (id && id.startsWith('TG')) {
                    selectedIds.push(id);
                } else {
                    tempNewAuthors.push(name);
                }
            });
            
            authorChecklist.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
                checkbox.checked = selectedIds.includes(checkbox.dataset.id);
            });
            
            renderTempNewAuthors();
            authorModal.style.display = 'flex';
        });
    });

    if (addNewAuthorBtn) {
        addNewAuthorBtn.addEventListener('click', () => {
            const newName = newAuthorInput.value.trim();
            if (!newName) {
                showToast('Vui lòng nhập tên tác giả!', 'error');
                return;
            }
            
            const exists = tempNewAuthors.some(n => n.toLowerCase() === newName.toLowerCase());
            const existsInDB = Array.from(authorChecklist.querySelectorAll('input[type="checkbox"]'))
                .some(cb => cb.value.toLowerCase() === newName.toLowerCase());
            
            if (exists || existsInDB) {
                showToast('Tác giả này đã tồn tại!', 'error');
                return;
            }
            
            tempNewAuthors.push(newName);
            newAuthorInput.value = '';
            renderTempNewAuthors();
            showToast(`Đã thêm tác giả: ${newName}`, 'success');
        });
    }

    function renderTempNewAuthors() {
        authorChecklist.querySelectorAll('.temp-author-item').forEach(el => el.remove());
        
        tempNewAuthors.forEach(name => {
            const label = document.createElement('label');
            label.className = 'temp-author-item';
            label.style.color = 'var(--green-accent)';
            label.innerHTML = `
                <input type="checkbox" value="${name}" data-id="" checked> 
                ${name} <em>(Mới)</em>
                <i class="fas fa-times" style="margin-left: 8px; cursor: pointer; color: var(--red-accent);" data-name="${name}"></i>
            `;
            
            label.querySelector('.fa-times').addEventListener('click', (e) => {
                e.stopPropagation();
                tempNewAuthors = tempNewAuthors.filter(n => n !== e.target.dataset.name);
                renderTempNewAuthors();
            });
            
            authorChecklist.appendChild(label);
        });
    }

    if (authorSearchInput) {
        authorSearchInput.addEventListener('input', (e) => {
            const searchTerm = e.target.value.toLowerCase();
            authorChecklist.querySelectorAll('label:not(.temp-author-item)').forEach(label => {
                label.style.display = label.textContent.toLowerCase().includes(searchTerm) ? 'flex' : 'none';
            });
        });
    }

    confirmAuthorsBtn.addEventListener('click', () => {
        if (!currentAuthorWrapper) return;
        currentAuthorWrapper.querySelectorAll('.author-tag').forEach(tag => tag.remove());
        
        authorChecklist.querySelectorAll('input[type="checkbox"]:checked').forEach(checkbox => {
            const tagHTML = `<span class="author-tag" data-id="${checkbox.dataset.id || ''}">${checkbox.value}<span class="remove-tag">×</span></span>`;
            currentAuthorWrapper.querySelector('.author-select-btn').insertAdjacentHTML('beforebegin', tagHTML);
        });
        
        authorModal.style.display = 'none';
        tempNewAuthors = [];
    });

    document.addEventListener('click', (e) => {
        if (e.target.classList.contains('remove-tag')) {
            e.target.closest('.author-tag').remove();
        }
    });

    closeAuthorModalBtns.forEach(btn => {
        btn.addEventListener('click', () => { 
            authorModal.style.display = 'none'; 
            tempNewAuthors = [];
        });
    });

    // --- CLOSE MODALS ---
    document.querySelectorAll('.close-modal').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.target.closest('.modal-overlay').style.display = 'none';
        });
    });
    
    window.addEventListener('click', (e) => {
        if(e.target.classList.contains('modal-overlay')) {
            e.target.style.display = 'none';
        }
    });

    // --- SIDEBAR ---
    const menuToggle = document.getElementById('menu-toggle');
    const sidebar = document.getElementById('sidebar');
    const container = document.querySelector('.dashboard-container'); 
    
    if (menuToggle && sidebar && container) {
        menuToggle.addEventListener('click', () => {
            if (window.innerWidth <= 992) { sidebar.classList.toggle('active'); } 
            else { container.classList.toggle('sidebar-collapsed'); }
        });
    }

    // --- LOGOUT ---
    const logoutBtn = document.getElementById('logout-button');
    if(logoutBtn) {
        logoutBtn.addEventListener('click', async (e) => {
            e.preventDefault();
            if(confirm('Bạn có chắc chắn muốn đăng xuất?')) {
                window.location.href = '/logout';
            }
        });
    }
});
</script>

</body>
</html>