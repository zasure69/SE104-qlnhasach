<script>
    document.addEventListener('DOMContentLoaded', function() {
        
        // --- LOADER & TOAST ---
        const loader = document.getElementById('loader');
        const toastContainer = document.getElementById('toast-container');
        let currentEditingRow = null; 

        function showLoader() { loader.style.display = 'flex'; }
        function hideLoader() { loader.style.display = 'none'; }
        function showToast(message, type = 'success') {
            const toast = document.createElement('div');
            toast.classList.add('toast', type);
            toast.innerHTML = `<i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} toast-icon"></i><span class="toast-message">${message}</span>`;
            toastContainer.appendChild(toast);
            setTimeout(() => { toast.classList.add('show'); }, 100);
            setTimeout(() => { toast.classList.remove('show'); if (toast.parentNode) toast.parentNode.removeChild(toast); }, 3000);
        }
        function simulateApiCall(callback) {
            showLoader();
            setTimeout(() => { hideLoader(); callback(true); }, 1000); 
        }

        // --- Sidebar ---
        const menuToggle = document.getElementById('menu-toggle');
        const sidebar = document.getElementById('sidebar');
        const container = document.querySelector('.dashboard-container'); 
        if (menuToggle && sidebar && container) {
            menuToggle.addEventListener('click', function() {
                if (window.innerWidth <= 992) { sidebar.classList.toggle('active'); } 
                else { container.classList.toggle('sidebar-collapsed'); }
            });
        }

        // --- Tabs ---
         const tabButtons = document.querySelectorAll('.tab-button');
         const tabPanes = document.querySelectorAll('.tab-pane');
         if (tabButtons.length > 0 && tabPanes.length > 0) {
             tabButtons.forEach(button => {
                 button.addEventListener('click', function() {
                     const targetId = this.dataset.target; 
                     const targetPane = document.querySelector(targetId);
                     if (targetPane) {
                         tabButtons.forEach(btn => btn.classList.remove('active'));
                         tabPanes.forEach(pane => pane.classList.remove('active'));
                         this.classList.add('active');
                         targetPane.classList.add('active');
                     }
                 });
             });
         }

        // --- Helper: Open Modal & Edit ---
        // ============================================================
        // --- KHU VỰC LOGIC MỚI: SMART MODAL (Sửa, Xóa, Đặt lại) ---
        // ============================================================

        // 1. Hàm lấy dữ liệu từ Form (để lưu snapshot)
        function getFormData(form) {
            const data = {};
            const inputs = form.querySelectorAll('input, select, textarea');
            inputs.forEach(input => {
                if(input.type !== 'submit' && input.type !== 'button') {
                    data[input.id] = input.value;
                }
            });
            return data;
        }

        // 2. Hàm khôi phục dữ liệu Form (cho nút Đặt lại)
        function restoreFormData(form, data) {
            for (const [key, value] of Object.entries(data)) {
                const input = form.querySelector(`#${key}`);
                if (input) input.value = value;
            }
        }

        // 3. Hàm Setup Chính (Thay thế setupModalLogic cũ)
        function setupSmartModal(config) {
            const addBtn = document.getElementById(config.addBtnId);
            const addModal = document.getElementById(config.addModalId);
            
            const editModal = document.getElementById(config.editModalId);
            const editForm = document.getElementById(config.formId);
            const editBtns = document.querySelectorAll(config.editBtnClass);
            
            const resetBtn = document.getElementById(config.resetBtnId);
            const table = document.querySelector(config.tableSelector);
            
            let originalFormData = {}; // Biến lưu trữ dữ liệu gốc

            // --- A. Xử lý MỞ Modal THÊM (Giữ lại chức năng cũ) ---
            if (addBtn && addModal) {
                addBtn.addEventListener('click', () => {
                    // Logic reset form thêm mới nằm ở đoạn code custom bên dưới
                    // Ở đây chỉ cần mở modal lên
                    addModal.style.display = 'flex';
                });
            }

            // --- B. Xử lý MỞ Modal SỬA (Kèm lưu snapshot dữ liệu) ---
            if (editBtns.length > 0 && editModal) {
                editBtns.forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        currentEditingRow = e.target.closest('tr');
                        
                        // TODO: Ở đây bạn cần viết code lấy dữ liệu từ dòng (currentEditingRow) 
                        // điền vào form (editForm). Ví dụ:
                        // document.getElementById('edit-ten-sach').value = ...
                        
                        // SAU KHI điền xong, lưu lại trạng thái gốc:
                        setTimeout(() => {
                             if(editForm) originalFormData = getFormData(editForm);
                        }, 100); 
                        
                        editModal.style.display = 'flex';
                    });
                });
            }

            // --- C. Xử lý Nút ĐẶT LẠI (Logic thông minh) ---
            if (resetBtn && editForm) {
                resetBtn.addEventListener('click', () => {
                    // So sánh dữ liệu hiện tại với dữ liệu gốc
                    const currentData = getFormData(editForm);
                    const isChanged = JSON.stringify(currentData) !== JSON.stringify(originalFormData);

                    if (!isChanged) {
                        showToast('Chưa có thay đổi nào để đặt lại!', 'error');
                        return;
                    }

                    if (confirm("Dữ liệu đã thay đổi. Bạn có muốn LƯU LẠI không?\n\n- OK: Lưu thay đổi.\n- Cancel: Khôi phục lại dữ liệu gốc.")) {
                        // Chọn OK -> Submit form (Lưu)
                        editForm.requestSubmit(); 
                    } else {
                        // Chọn Cancel -> Reset về gốc
                        restoreFormData(editForm, originalFormData);
                        showToast('Đã khôi phục dữ liệu gốc!', 'success');
                    }
                });
            }

            // --- D. Xử lý Nút XÓA (Icon thùng rác ở bảng bên ngoài) ---
            if (table) {
                table.addEventListener('click', (e) => {
                    // Kiểm tra nếu click vào icon có class 'delete-icon' hoặc cha của nó
                    const target = e.target.closest('.delete-icon');
                    if (target) {
                        const row = target.closest('tr');
                        // Lấy tên để hiển thị confirm (giả sử cột thứ 2 là tên)
                        const itemName = row.cells[2] ? row.cells[2].innerText : config.typeName; 
                        
                        if (confirm(`Bạn có chắc chắn muốn XÓA vĩnh viễn: ${itemName}?`)) {
                            simulateApiCall((success) => {
                                if (success) {
                                    row.remove();
                                    showToast(`Đã xóa ${config.typeName} thành công!`, 'success');
                                }
                            });
                        }
                    }
                });
            }

            // --- E. Xử lý Submit Form Sửa ---
            if (editForm) {
                editForm.addEventListener('submit', (e) => {
                    e.preventDefault();
                    simulateApiCall((success) => {
                        if (success) {
                            editModal.style.display = 'none';
                            showToast(`Cập nhật ${config.typeName} thành công!`);
                        }
                    });
                });
            }
        }

        // --- GỌI HÀM CẤU HÌNH CHO 4 TAB (Thay thế các dòng setupModalLogic cũ) ---
        
        // 1. Quản lý Sách
