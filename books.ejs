        // --- SỬA: Logic Nút "Thêm mới" cho Modal Thêm Sách ---
        const btnCustomSach = document.getElementById('btn-custom-sach');
        const addBookForm = document.getElementById('add-book-form');
        const sachAddModal = document.getElementById('sach-add-modal');
        
        if (btnCustomSach && addBookForm) {
            btnCustomSach.addEventListener('click', () => {
                if (confirm('Bạn có muốn lưu Sách hiện tại không?')) {
                    if (addBookForm.checkValidity()) {
                        addBookForm.requestSubmit();
                    } else {
                        addBookForm.reportValidity(); 
                    }
                } else {
                    addBookForm.reset();
                }
            });
            
            addBookForm.addEventListener('submit', (e) => {
                e.preventDefault();
                simulateApiCall((success) => {
                        if(success) { 
                            sachAddModal.style.display = 'none'; 
                            showToast('Thêm Sách thành công!'); 
                            addBookForm.reset(); 
                    }
                });
            });
        }

